/**
 * 港股通市场数据->成交活跃证券
 */
var activeSecurities = {
	activeSecuritiesUrl:sseQueryURL + "commonSoaQuery.do?jsonCallBack=?",
	activeSecuritiesParam:{
		'tradeDate': '',
		'sqlId':'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ'
	},
	activeSecuritiesTitle:'当日港股通前十大成交活跃证券',
	typeList: [
		{ name: "每日统计", value: "0",sql:'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ' },
		{ name: "月度统计", value: "1",sql:'FW_HGTZL_GGTSCSJ_CJHYZQ_YDTJ' },
		{ name: "年度统计", value: "2",sql:'FW_HGTZL_GGTSCSJ_CJHYZQ_NDTJ'},
	],
	init: function () {
		var _this = this;
		_this.loadEvents();
	},
	loadEvents: function () {
		var _this = this;
		bootstrapSelect({
			method: function () {
			  //类型数据渲染
			  $(".js_select_type .selectpicker")
				.html(addSelectOption(_this.typeList))
				.selectpicker("refresh")
				.selectpicker("render");
			  //类型初始化完成调用接口
			  $(".js_select_type .selectpicker").on(
				"loaded.bs.select",
				function (e) {
				  setTimeout(function () {
					_this.searchType()
				  }, 500);
				}
			  );
			  //下拉框改变触发查询
			  $(".js_select_type .selectpicker").on(
				"changed.bs.select",
				function (e) {
					_this.searchType();
				}
			  );
			},
		});
	},
	searchType:function() {
		var _this = activeSecurities;
		var val = $('.js_select_type .selectpicker').val();
		_this.activeSecuritiesParam.sqlId = _this.typeList[val].sql;
		delete _this.activeSecuritiesParam.tradeDate;
		delete _this.activeSecuritiesParam.tradeMonth;
		delete _this.activeSecuritiesParam.tradeYear;
		if(val == 0){
			_this.activeSecuritiesTitle = '当日港股通前十大成交活跃证券';
			_this.activeSecuritiesParam.tradeDate = '';
			var htm = $('.js_date .sse_searchInput').html();
			$('.js_date .sse_searchInput').html('');
			$('.js_date .sse_searchInput').html(htm);
			$(".js_date input").attr("placeholder", "查询日期");
			laydate({
				elem: ".js_date input",
				theme: "#b50005",
				format: "yyyy-MM-dd",
				trigger: "click",
				btns: ["confirm"],
				done: function (value, date, endDate) {
					//选择时间触发查询
					setTimeout(function () {
						_this.searchDate();
					}, 500);
				},
			});
		} else if(val == 1){
			_this.activeSecuritiesTitle = '当月港股通前十大成交活跃证券';
			_this.activeSecuritiesParam.tradeMonth = '';
			var htm = $('.js_date .sse_searchInput').html();
			$('.js_date .sse_searchInput').html('');
			$('.js_date .sse_searchInput').html(htm);
			$(".js_date input").attr("placeholder", "查询日期");
			laydate({
				elem: ".js_date input",
				theme: "#b50005",
				type: 'month',
				format: 'yyyy-MM',
				min: '2014-01-01',
				max: get_systemDate_global().substring(0, 7),
				trigger: 'click',
				btns: ["confirm"],
				done: function (value, date, endDate) {
				//选择时间触发查询
				setTimeout(function () {
					_this.searchDate();
				}, 500);
				},
			});
		} else if(val == 2){
			_this.activeSecuritiesTitle = '当年港股通前十大成交活跃证券';
			_this.activeSecuritiesParam.tradeYear = '';
			var htm = $('.js_date .sse_searchInput').html();
			$('.js_date .sse_searchInput').html('');
			$('.js_date .sse_searchInput').html(htm);
			$(".js_date input").attr("placeholder", "查询日期");
			laydate({
				elem: ".js_date input",
				theme: "#b50005",
				type: 'year',
				format: 'yyyy',
				min: '2014-01-01',
				max: get_systemDate_global().substring(0, 4),
				trigger: 'click',
				btns: ["confirm"],
				done: function (value, date, endDate) {
				//选择时间触发查询
				setTimeout(function () {
					_this.searchDate();
				}, 500);
				},
			});
		}
		_this.getData();
	},
	searchDate:function() {
		var _this = activeSecurities;
		var date = $(".js_date input").val() ? $(".js_date input").val() : '';
		$(".js_ggtcjhyzq h2").html(_this.activeSecuritiesTitle + "<span class='new_date'>数据日期："+ date +"</span>");
		if(_this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ'){
			_this.activeSecuritiesParam.tradeDate = date.replace(/\-/g, '');
		} else if(_this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_YDTJ'){
			_this.activeSecuritiesParam.tradeMonth = date.replace(/\-/g, '');
		} else if(_this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_NDTJ'){
			_this.activeSecuritiesParam.tradeYear = date.replace(/\-/g, '');
		}
		_this.getData();
	},
	getData: function() {
		var _this = this;
		var emptyTr = '<tr><td colspan="7">暂无数据</td></tr>'
		var htmlContent = "<thead><tr>";
		htmlContent += '<th>名次</th>';
		htmlContent += '<th>证券代码</th>';
		htmlContent += '<th>英文简称</th>';
		htmlContent += '<th>中文简称（参考）</th>';
		htmlContent += '<th class="text-right">买入成交金额（亿元）</th>';
		htmlContent += '<th class="text-right">卖出成交金额（亿元）</th>';
		htmlContent += '<th class="text-right">成交总额（亿元）</th>';
		htmlContent += "</tr></thead><tbody>";
		getJSONP({
			type: 'post',
			dataType: 'jsonp',
			url: _this.activeSecuritiesUrl,
			data: _this.activeSecuritiesParam,
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0 && data.result[0]) {
					if(_this.activeSecuritiesParam.tradeDate == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ'){
						var date = data.result[0].tradeDate.substring(0, 4) + '-' + data.result[0].tradeDate.substring(4, 6) + '-' + data.result[0].tradeDate.substring(6, 8);
					}
					if(_this.activeSecuritiesParam.tradeMonth == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_YDTJ'){
						var date = data.result[0].tradeMonth.substring(0, 4) + '-' + data.result[0].tradeMonth.substring(4, 6);
					}
					if(_this.activeSecuritiesParam.tradeYear == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_NDTJ'){
						var date = data.result[0].tradeYear;
					}
					$.each(data.result, function (k, v) {
						htmlContent += "<tr>";
						htmlContent += '<td class="text-nowrap">' + (v.ranking ? v.ranking : '-') + "</td>";
						htmlContent += '<td class="text-nowrap">' + (v.secCode ? v.secCode : '-') + "</td>"
						htmlContent += '<td class="text-nowrap">' + (v.enAbbr ? v.enAbbr : '-') + "</td>";
						htmlContent += '<td class="text-nowrap">' + (v.cnAbbr ? v.cnAbbr : '-') + "</td>";
						htmlContent += '<td class="text-nowrap text-right">' + (v.buyAmount ? v.buyAmount : '-') + "</td>";
						htmlContent += '<td class="text-nowrap text-right">' + (v.sellAmount ? v.sellAmount : '-') + "</td>"
						htmlContent += '<td class="text-nowrap text-right">' + (v.tradeAmount ? v.tradeAmount : '-') + "</td>";
						htmlContent += "</tr>";
					});
					htmlContent += "</tbody>";
					$(".js_ggtcjhyzq .table").html(htmlContent);
				} else {
					if(_this.activeSecuritiesParam.tradeDate == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ'){
						var date = get_systemDate_global();
					}
					if(_this.activeSecuritiesParam.tradeMonth == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_YDTJ'){
						var date = get_systemDate_global().substring(0, 7);
					}
					if(_this.activeSecuritiesParam.tradeYear == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_NDTJ'){
						var date = get_systemDate_global().substring(0, 4);
					}
					htmlContent += emptyTr;
					htmlContent += '</tbody>';
					$(".js_ggtcjhyzq .table").html(htmlContent);
				}
				if(isNull(date)){
					$(".js_date input").val(date);
					$(".js_ggtcjhyzq h2").html(_this.activeSecuritiesTitle + "<span class='new_date'>数据日期："+ date +"</span>");
				}
			},
			errCallback: function () {
				if(_this.activeSecuritiesParam.tradeDate == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_MRTJ'){
					var date = get_systemDate_global();
				}
				if(_this.activeSecuritiesParam.tradeMonth == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_YDTJ'){
					var date = get_systemDate_global().substring(0, 7);
				}
				if(_this.activeSecuritiesParam.tradeYear == '' && _this.activeSecuritiesParam.sqlId == 'FW_HGTZL_GGTSCSJ_CJHYZQ_NDTJ'){
					var date = get_systemDate_global().substring(0, 4);
				}
				if(isNull(date)){
					$(".js_date input").val(date);
					$(".js_ggtcjhyzq h2").html(_this.activeSecuritiesTitle + "<span class='new_date'>数据日期："+ date +"</span>");
				}
				htmlContent += emptyTr;
				htmlContent += '</tbody>';
				$(".js_ggtcjhyzq .table").html(htmlContent);
			}
		})
	  },
}
if($('.js_ggtcjhyzq').length > 0){
	activeSecurities.init();
}

/**
 * 港股通市场数据->港股通证券持有数量
 */
var holdingQuantity = {
	holdingQuantityUrl: sseQueryURL + 'sseQuery/commonSoaQuery.do',  //港股通证券持有数量url
	holdingQuantityParams: { //港股通证券持有数量参数
		"isPagination": true,
		"sqlId":'FW_HGTZL_GGTSCSJ_GGTZQCYSL',
		"secCodeName": '',
		"tradeDate": '',
		"pageHelp.pageSize": 25,
		"pageHelp.pageNo": 1,
		"pageHelp.beginPage": 1,
		"pageHelp.cacheSize": 1,
		"pageHelp.endPage": 1
	},
	holdingQuantityDownUrl:sseQueryURL + "commonSoaExcelDd.do?sqlId=FW_HGTZL_GGTSCSJ_GGTZQCYSL",//港股通证券持有数量下载链接
	init: function () {
		var _this = this;
		_this.loadEvents();
		//点击证券代码或简称搜索
		$(".search_btn").on("click", function (e) {
			e.stopPropagation();
			_this.searchDate();
		});
	},
	loadEvents: function () {
		var _this = this;
		$(".js_ggtzqcysl h2.title_lev2 .new_date").after("<a id='download' class='tableDownload js_download_market' href=''>下载</a>");
		$("#inputCode").attr("placeholder", "证券代码或简称");
		$(".js_date input").attr("placeholder", "查询日期");
		$('#download').attr('href', _this.holdingQuantityDownUrl+ "&secCodeName=" + _this.holdingQuantityParams.secCodeName + "&tradeDate=" + _this.holdingQuantityParams.tradeDate);
		laydate({
			elem: ".js_date input",
			theme: "#b50005",
			format: "yyyy-MM-dd",
			trigger: "click",
			btns: ["confirm"],
			done: function (value, date, endDate) {
				//选择时间触发查询
				setTimeout(function () {
				   _this.searchDate();
				}, 500);
			},
		});
		_this.getData(1);
	},
  	searchDate: function() {
		var _this = this;
		$(".js_ggtzqcysl h2.title_lev2 .new_date").html('数据日期：'+ $(".js_date input").val());
		_this.holdingQuantityParams.tradeDate = $(".js_date input").val().replace(/\-/g, '');
		_this.holdingQuantityParams.secCodeName = $("#inputCode").val();
		_this.getData(1);
	},
  	getData: function(pageIndex) {
		var _this = this;
		$('#download').attr('href', _this.holdingQuantityDownUrl+ "&secCodeName=" + _this.holdingQuantityParams.secCodeName + "&tradeDate=" + _this.holdingQuantityParams.tradeDate);
		if (!paginationChange(_this.holdingQuantityParams, pageIndex)) {  //触发分页改变分页参数
		return;
		}

		var holdingQuantityHtml = '<thead><tr>';
		holdingQuantityHtml += '<th>证券代码</th>';
		holdingQuantityHtml += '<th>英文简称</th>';
		holdingQuantityHtml += '<th>中文简称（参考）</th>';
		holdingQuantityHtml += '<th>港股通投资者合计持有数量</th>';
		holdingQuantityHtml += '</tr></thead><tbody>';
		var emptyTr = '<tr><td colspan="4">暂无数据</tr>';
		getJSONP({
			type: 'post',
			url: _this.holdingQuantityUrl,
			data: _this.holdingQuantityParams,
			dataType: 'jsonp',
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0) {
					if(_this.holdingQuantityParams.tradeDate == ''){
						var dateStr = data.result[0].tradeDate;
						var _data  = dateStr.substring(0, 4) + '-' + dateStr.substring(4, 6) + '-' + dateStr.substring(6);
						$(".js_ggtzqcysl h2.title_lev2 .new_date").html('数据日期：'+ _data);
						$(".js_date input").val(_data);
					}
					$.each(data.result, function (k, v) {
						holdingQuantityHtml += '<tr>';
						holdingQuantityHtml += '<td class="text-nowrap">' + (v.secCode ? v.secCode : '-') + '</td>';  //证券代码
						holdingQuantityHtml += '<td class="text-nowrap">' + (v.enAbbr ? v.enAbbr : '-') + '</td>';  //英文简称
						holdingQuantityHtml += '<td class="text-nowrap">' + (v.cnAbbr ? v.cnAbbr : '-') + '</td>';  //中文简称
						holdingQuantityHtml += '<td class="text-nowrap">' + (v.totalHoldings ? v.totalHoldings : '-') + '</td>';  //港股通投资者合计持有数量
					})
					holdingQuantityHtml += '</tbody>';
					$(".js_ggtzqcysl .table").html(holdingQuantityHtml);
					//调用分页
					Page.navigation(".js_ggtzqcysl .pagination-box", data.pageHelp.pageCount, data.pageHelp.total, data.pageHelp.pageNo, data.pageHelp.pageSize, "holdingQuantity.getData");
				} else {
					if(_this.holdingQuantityParams.tradeDate == ''){
						$(".js_ggtzqcysl h2.title_lev2 .new_date").html('数据日期：'+ get_systemDate_global());
						$(".js_date input").val(get_systemDate_global());
					}
					holdingQuantityHtml += emptyTr;
					holdingQuantityHtml += '</tbody>';
					$(".js_ggtzqcysl .table").html(holdingQuantityHtml);
					$(".js_ggtzqcysl .pagination-box").html("");
				}
			},
			errCallback: function () {
				if(_this.holdingQuantityParams.tradeDate == ''){
					$(".js_ggtzqcysl h2.title_lev2 .new_date").html('数据日期：'+ get_systemDate_global());
					$(".js_date input").val(get_systemDate_global());
				}
				holdingQuantityHtml += emptyTr;
				holdingQuantityHtml += '</tbody>';
				$(".js_ggtzqcysl .table").html(holdingQuantityHtml);
				$(".js_ggtzqcysl .pagination-box").html("");
			}
		})
	}
}
if($('.js_ggtzqcysl').length > 0){
	holdingQuantity.init();
}

function hgtcjgk(params) {
	this.params = {
	  dayNode: ".js_hgtcjgk .js_day",
	  dayDateNode: ".js_hgtcjgk .js_day .js_date_day input",
	  monthNode: ".js_hgtcjgk .js_month",
	  monthDateNode: ".js_hgtcjgk .js_month .js_date_month input",
	  yearNode: ".js_hgtcjgk .js_year",
	  yearDateNode: ".js_hgtcjgk .js_year .js_date_year input",
	  tradeDate: "",
	  // getQuatationInfo: sseQueryURL + "commonSoaQuery.do",
	  hgtcjgktradingDayParam: {
		sqlId: "FW_HGTZL_HGTSCSJ_HGTCJGK_MRTJ",
		tradeDate: "",
	  },
	  hgtcjgktradingMonthParam: {
		sqlId: "FW_HGTZL_HGTSCSJ_HGTCJGK_YDTJ",
		tradeMonth: "",
	  },
	  hgtcjgktradingYearParam: {
		sqlId: "FW_HGTZL_HGTSCSJ_HGTCJGK_NDTJ",
		tradeYear: "",
	  },
	};
	public.call(this);
  }
  
  hgtcjgk.prototype = Object.create(public.prototype);
  hgtcjgk.prototype.constructor = hgtcjgk;
  
  var hgtcjgkPage = new hgtcjgk();
  
  hgtcjgkPage.methods = {
	init: function init(params) {
	  var _this = hgtcjgkPage.params,
		_that = this,
		that = hgtcjgkPage;
  
	  //日渲染
	  laydate({
		elem: _this.dayDateNode,
		theme: "#b50005",
		format: "yyyy-MM-dd",
		trigger: "click",
		btns: ["confirm"],
		// min: '2014-01-01',
		// max: get_systemDate_global(),
		done: function (value, date, endDate) {
		  //选择时间触发查询
		  setTimeout(function () {
			_this.hgtcjgktradingDayParam.tradeDate = $(_this.dayDateNode)
			  .val()
			  .replace(/\-/g, "");
			_that.searchData("day");
		  }, 500);
		},
	  });
	  laydate({
		elem: _this.monthDateNode,
		theme: "#b50005",
		format: "yyyy-MM",
		type: "month",
		min: "2014-01-01",
		max: that.getEndMonth(),
		trigger: "click",
		btns: ["confirm"],
		done: function (value, date, endDate) {
		  _this.hgtcjgktradingMonthParam.tradeMonth = $(_this.monthDateNode)
			.val()
			.replace(/\-/g, "");
		  //选择时间触发查询
		  setTimeout(function () {
			_that.searchData("month");
		  }, 500);
		},
	  });
	  laydate({
		elem: _this.yearDateNode,
		theme: "#b50005",
		format: "yyyy",
		type: "year",
		trigger: "click",
		btns: ["confirm"],
		min: "2014-01-01",
		max: that.getEndYear(),
		done: function (value, date, endDate) {
		  _this.hgtcjgktradingYearParam.tradeYear = $(_this.yearDateNode).val();
		  //选择时间触发查询
		  setTimeout(function () {
			_that.searchData("year");
		  }, 500);
		},
	  });
	  _that.searchData("all");
	},
	searchData: function searchData(type) {
	  switch (type) {
		case "all":
		  this.searchAll();
		  break;
		case "day":
		  this.serachDay();
		  break;
		case "month":
		  this.serachMonth();
		  break;
		case "year":
		  this.serachYear();
		  break;
		default:
		  this.searchAll();
	  }
	},
	searchAll: function searchAll(params) {
	  this.serachDay();
	  this.serachMonth();
	  this.serachYear();
	},
  
	serachDay: function serachDay(params) {
	  var _this = hgtcjgkPage;
	  var htmlHead = "<thead><tr>";
	  htmlHead += '<th class="text-nowrap">当日情况</th>';
	  htmlHead += '<th class="text-right">成交概况</th>';
	  htmlHead += "</tr></thead>";
	  getJSONP({
		type: "post",
		dataType: "jsonp",
		url: _this.url,
		data: _this.params.hgtcjgktradingDayParam,
		successCallback: function (data) {
		  if (data && data.result && data.result.length > 0) {
			var res = data.result[0];
			$(_this.params.dayDateNode).val(turnDateAddLine(res.tradeDate));
			$(_this.params.dayNode + " .title_lev3 .new_date").html(
			  "数据日期：" + turnDateAddLine(res.tradeDate)
			);
			//-----------------------------------------------------------------------
			var html = "<tbody>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当日成交总额（亿元）</td><td class="text-right">' +
			  (res.totalAmount ? res.totalAmount : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当日总成交笔数（万笔）</td><td class="text-right">' +
			  (res.totalVolume ? res.totalVolume : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当日ETF成交总额（亿元）</td><td class="text-right">' +
			  (res.etfTotalAmount ? res.etfTotalAmount : "-") +
			  "</td>";
			html += "</tr>";
			html += "</tbody>";
			$(_this.params.dayNode + " .table").html(htmlHead + html);
			//-----------------------------------------------------------------------
		  } else {
			var date1 = _this.params.hgtcjgktradingDayParam.tradeDate
			  ? turnDateAddLine(_this.params.hgtcjgktradingDayParam.tradeDate)
			  : get_systemDate_global();
			$(_this.params.dayDateNode).val(date1);
			$(_this.params.dayNode + " .title_lev3 .new_date").html(
			  "数据日期：" + date1
			);
			var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
			$(_this.params.dayNode + " .table").html(htmlHead + emptyTr);
		  }
		},
		errCallback: function () {
		  var date1 = _this.params.hgtcjgktradingDayParam.tradeDate
			? turnDateAddLine(_this.params.hgtcjgktradingDayParam.tradeDate)
			: get_systemDate_global();
		  $(_this.params.dayDateNode).val(date1);
		  $(_this.params.dayNode + " .title_lev3 .new_date").html(
			"数据日期：" + date1
		  );
		  var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
		  $(_this.params.dayNode + " .table").html(htmlHead + emptyTr);
		},
	  });
	},
  
	serachMonth: function serachMonth(params) {
	  var _this = hgtcjgkPage;
	  var htmlHead = "<thead><tr>";
	  htmlHead += '<th class="text-nowrap">当月情况</th>';
	  htmlHead += '<th class="text-right">成交概况</th>';
	  htmlHead += "</tr></thead>";
	  _this.params.hgtcjgktradingMonthParam;
	  getJSONP({
		type: "post",
		dataType: "jsonp",
		url: _this.url,
		data: _this.params.hgtcjgktradingMonthParam,
		successCallback: function (data) {
		  if (data && data.result && data.result.length > 0) {
			var monthData = data.result[0];
			$(_this.params.monthDateNode).val(
			  turnDateAddLine(monthData.tradeMonth).replace(/-$/, "")
			);
			$(_this.params.monthNode + " .title_lev3 .new_date").html(
			  "数据日期：" +
				turnDateAddLine(monthData.tradeMonth).replace(/-$/, "")
			);
			//-----------------------------------------------------------------------
			var html = "<tbody>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当月成交总额（亿元）</td><td class="text-right">' +
			  (monthData.totalAmt ? monthData.totalAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当月总成交笔数（万笔）</td><td class="text-right">' +
			  (monthData.totalVol ? monthData.totalVol : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当月日均成交金额（亿元）</td><td class="text-right">' +
			  (monthData.dayAmt ? monthData.dayAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当月日均成交笔数（万笔）</td><td class="text-right">' +
			  (monthData.dayVol ? monthData.dayVol : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当月ETF成交总额（亿元）</td><td class="text-right">' +
			  (monthData.etfTotalAmt ? monthData.etfTotalAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "</tbody>";
			$(_this.params.monthNode + " .table").html(htmlHead + html);
			//-----------------------------------------------------------------------
		  } else {
			var monthDate = _this.params.hgtcjgktradingMonthParam.tradeMonth
			  ? turnDateAddLine(
				  _this.params.hgtcjgktradingMonthParam.tradeMonth
				).replace(/-$/, "")
			  : get_systemDate_global().substring(0, 7);
			var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
			$(_this.params.monthNode + " .table").html(htmlHead + emptyTr);
			$(_this.params.monthDateNode).val(monthDate);
			$(_this.params.monthNode + " .title_lev3 .new_date").html(
			  "数据日期：" + monthDate
			);
		  }
		},
		errCallback: function () {
		  var monthDate = _this.params.hgtcjgktradingMonthParam.tradeMonth
			? turnDateAddLine(
				_this.params.hgtcjgktradingMonthParam.tradeMonth
			  ).replace(/-$/, "")
			: get_systemDate_global().substring(0, 7);
		  var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
		  $(_this.params.monthNode + " .table").html(htmlHead + emptyTr);
		  $(_this.params.monthDateNode).val(monthDate);
		  $(_this.params.monthNode + " .title_lev3 .new_date").html(
			"数据日期：" + monthDate
		  );
		},
	  });
	},
  
	serachYear: function serachYear(params) {
	  var _this = hgtcjgkPage;
	  var htmlHead = "<thead><tr>";
	  htmlHead += '<th class="text-nowrap">当年情况</th>';
	  htmlHead += '<th class="text-right">成交概况</th>';
	  htmlHead += "</tr></thead>";
  
	  getJSONP({
		type: "post",
		dataType: "jsonp",
		url: _this.url,
		data: _this.params.hgtcjgktradingYearParam,
		successCallback: function (data) {
		  if (data && data.result && data.result.length > 0) {
			var yearData = data.result[0];
			$(_this.params.yearDateNode).val(yearData.tradeYear);
			$(_this.params.yearNode + " .title_lev3 .new_date").html(
			  "数据日期：" + yearData.tradeYear
			);
			//-----------------------------------------------------------------------
			var html = "<tbody>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当年成交总额（亿元）</td><td class="text-right">' +
			  (yearData.totalAmt ? yearData.totalAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当年总成交笔数（万笔）</td><td class="text-right">' +
			  (yearData.totalVol ? yearData.totalVol : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当年日均成交金额（亿元）</td><td class="text-right">' +
			  (yearData.dayAmt ? yearData.dayAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当年日均成交笔数（万笔）</td><td class="text-right">' +
			  (yearData.dayVol ? yearData.dayVol : "-") +
			  "</td>";
			html += "</tr>";
			html += "<tr>";
			html +=
			  '<td class="text-nowrap">当年ETF成交总额（亿元）</td><td class="text-right">' +
			  (yearData.etfTotalAmt ? yearData.etfTotalAmt : "-") +
			  "</td>";
			html += "</tr>";
			html += "</tbody>";
			$(_this.params.yearNode + " .table").html(htmlHead + html);
			//-----------------------------------------------------------------------
		  } else {
			var yearDate = _this.params.hgtcjgktradingYearParam.tradeYear
			  ? _this.params.hgtcjgktradingYearParam.tradeYear
			  : get_systemDate_global().substring(0, 4);
			$(_this.params.yearDateNode).val(yearDate);
			$(_this.params.yearNode + " .title_lev3 .new_date").html(
			  "数据日期：" + yearDate
			);
			var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
			$(_this.params.yearNode + " .table").html(htmlHead + emptyTr);
		  }
		},
		errCallback: function () {
		  var yearDate = _this.params.hgtcjgktradingYearParam.tradeYear
			? _this.params.hgtcjgktradingYearParam.tradeYear
			: get_systemDate_global().substring(0, 4);
		  $(_this.params.yearDateNode).val(yearDate);
		  $(_this.params.yearNode + " .title_lev3 .new_date").html(
			"数据日期：" + yearDate
		  );
		  var emptyTr = '<tbody><tr><td colspan="2">暂无数据</td></tr></tbody>';
		  $(_this.params.yearNode + " .table").html(htmlHead + emptyTr);
		},
	  });
	},
  };
  //沪股通成交概况
  if ($(".js_hgtcjgk").length > 0) {
	hgtcjgkPage.methods.init();
  }
  
  function hgtcjhyzq() {
	this.params = {
	  typeList: [
		{ name: "每日统计", value: "tradeDate" },
		{ name: "月度统计", value: "tradeMonth" },
		{ name: "年度统计", value: "tradeYear" },
	  ],
	  tradeDate: {
		sqlId: "FW_HGTZL_HGTSCSJ_CJHYZQ_MRTJ",
		tradeDate: "",
	  },
	  tradeMonth: {
		sqlId: "FW_HGTZL_HGTSCSJ_CJHYZQ_YDTJ",
		tradeMonth: "",
	  },
	  tradeYear: {
		sqlId: "FW_HGTZL_HGTSCSJ_CJHYZQ_NDTJ",
		tradeYear: "",
	  },
	};
	public.call(this);
  }
  
  hgtcjhyzq.prototype = Object.create(public.prototype);
  hgtcjhyzq.prototype.constructor = hgtcjhyzq;
  
  var hgtcjhyzqPage = new hgtcjhyzq();
  
  hgtcjhyzqPage.methods = {
	init: function init() {
	  var _this = hgtcjhyzqPage.params,
		_that = this,
		that = hgtcjhyzqPage;
	  this.initSelectDate();
	  bootstrapSelect({
		method: function () {
		  //类型数据渲染
		  $(".js__select_type .selectpicker")
			.html(addSelectOption(_this.typeList))
			.selectpicker("refresh")
			.selectpicker("render");
		  //类型初始化完成调用接口
		  $(".js__select_type .selectpicker").on(
			"loaded.bs.select",
			function (e) {
			  setTimeout(function () {
				_that.initDateDom({
				  format: "yyyy-MM-dd",
				  type: "date",
				  params: _this.tradeDate,
				});
			  }, 500);
			}
		  );
		  //下拉框改变触发查询
		  $(".js__select_type .selectpicker").on(
			"changed.bs.select",
			function (e) {
			  _this.tradeDate.tradeDate = "";
			  _this.tradeMonth.tradeMonth = "";
			  _this.tradeYear.tradeYear = "";
			  switch ($(".js__select_type .selectpicker").val()) {
				case "tradeDate":
				  _that.initDateDom({
					format: "yyyy-MM-dd",
					type: "date",
					params: _this.tradeDate,
				  });
				  break;
				case "tradeMonth":
				  _that.initDateDom({
					format: "yyyy-MM",
					type: "month",
					params: _this.tradeMonth,
				  });
				  break;
				case "tradeYear":
				  _that.initDateDom({
					format: "yyyy",
					type: "year",
					params: _this.tradeYear,
				  });
				  break;
				default:
				  break;
			  }
			}
		  );
		},
	  });
	},
  
	initSelectDate: function initSelectDate(params) {
	  var strDate = $(".js_date .sse_searchInput")
		  .html()
		  .replace(/sse_input/g, "sse_input js_date"),
		strMonth = $(".js_date .sse_searchInput")
		  .html()
		  .replace(/sse_input/g, "sse_input js_month"),
		strYear = $(".js_date .sse_searchInput")
		  .html()
		  .replace(/sse_input/g, "sse_input js_year"),
		_this = hgtcjhyzqPage.params,
		that = hgtcjhyzqPage,
		_that = this;
	  $(".js_date .sse_searchInput").html(strDate + strMonth + strYear);
	  $(".js_date .sse_searchInput .js_date").show();
	  $(".js_date .sse_searchInput .js_date+.bi-calendar4-week").show();
	  $(".js_date .sse_searchInput .js_month").hide();
	  $(".js_date .sse_searchInput .js_month+.bi-calendar4-week").hide();
	  $(".js_date .sse_searchInput .js_year").hide();
	  $(".js_date .sse_searchInput .js_year+.bi-calendar4-week").hide();
	  laydate({
		elem: ".js_date .sse_searchInput .js_date",
		theme: "#b50005",
		format: "yyyy-MM-dd",
		type: "date",
		trigger: "click",
		btns: ["confirm"],
		done: function (value, date, endDate) {
		  //选择时间触发查询
		  _this.tradeDate.tradeDate = $(".js_date .sse_searchInput .js_date")
			.val()
			.replace(/\-/g, "");
		  setTimeout(function () {
			_that.searchDate();
		  }, 500);
		},
	  });
	  laydate({
		elem: ".js_date .sse_searchInput .js_month",
		theme: "#b50005",
		format: "yyyy-MM",
		type: "month",
		min: "2014-01-01",
		max: that.getEndMonth(),
		trigger: "click",
		btns: ["confirm"],
		done: function (value, date, endDate) {
		  //选择时间触发查询
		  _this.tradeMonth.tradeMonth = $(".js_date .sse_searchInput .js_month")
			.val()
			.replace(/\-/g, "");
		  setTimeout(function () {
			_that.searchDate();
		  }, 500);
		},
	  });
	  laydate({
		elem: ".js_date .sse_searchInput .js_year",
		theme: "#b50005",
		format: "yyyy",
		type: "year",
		min: "2014-01-01",
		max: that.getEndYear(),
		trigger: "click",
		btns: ["confirm"],
		done: function (value, date, endDate) {
		  //选择时间触发查询
		  _this.tradeYear.tradeYear = $(
			".js_date .sse_searchInput .js_year"
		  ).val();
		  setTimeout(function () {
			_that.searchDate();
		  }, 500);
		},
	  });
	},
  
	initDateBox: function initDateBox(params) {
	  if (params == "date") {
		$(".js_date .sse_searchInput .js_date").show();
		$(".js_date .sse_searchInput .js_date+.bi-calendar4-week").show();
		$(".js_date .sse_searchInput .js_month").hide();
		$(".js_date .sse_searchInput .js_month+.bi-calendar4-week").hide();
		$(".js_date .sse_searchInput .js_year").hide();
		$(".js_date .sse_searchInput .js_year+.bi-calendar4-week").hide();
	  } else if (params == "month") {
		$(".js_date .sse_searchInput .js_date").hide();
		$(".js_date .sse_searchInput .js_date+.bi-calendar4-week").hide();
		$(".js_date .sse_searchInput .js_month").show();
		$(".js_date .sse_searchInput .js_month+.bi-calendar4-week").show();
		$(".js_date .sse_searchInput .js_year").hide();
		$(".js_date .sse_searchInput .js_year+.bi-calendar4-week").hide();
	  } else if (params == "year") {
		$(".js_date .sse_searchInput .js_date").hide();
		$(".js_date .sse_searchInput .js_date+.bi-calendar4-week").hide();
		$(".js_date .sse_searchInput .js_month").hide();
		$(".js_date .sse_searchInput .js_month+.bi-calendar4-week").hide();
		$(".js_date .sse_searchInput .js_year").show();
		$(".js_date .sse_searchInput .js_year+.bi-calendar4-week").show();
	  }
	},
  
	initDateDom: function initDateDom(params) {
	  this.initDateBox(params.type);
	  this.getData(params);
	},
  
	searchDate: function searchDate(params) {
	  var _this = hgtcjhyzqPage.params,
		strType = $(".js__select_type .selectpicker").val();
	  this.getData({
		params: _this[strType],
		type:
		  strType == "tradeDate"
			? "date"
			: strType == "tradeMonth"
			? "month"
			: strType == "tradeYear"
			? "year"
			: "",
	  });
	},
	getData: function getData(params) {
	  var _this = hgtcjhyzqPage;
	  var htmlHead = "<thead><tr>";
	  htmlHead += '<th class="text-left">名次</th>';
	  htmlHead += '<th class="text-left">证券代码</th>';
	  htmlHead += '<th class="text-left">证券简称</th>';
	  htmlHead += '<th class="text-right">成交总额（亿元）</th>';
	  htmlHead += "</tr></thead>";
  
	  //-----------------------------------------------------------------------
	  getJSONP({
		type: "post",
		dataType: "jsonp",
		url: _this.url,
		data: params.params,
		successCallback: function (data) {
		  if (data && data.result && data.result.length > 0) {
			var dataList = data.result;
			var html = "<tbody>";
			$.each(dataList, function (index, item) {
			  html += "<tr>";
			  html +=
				'<td class="text-left">' +
				(item.ranking ? item.ranking : "-") +
				"</td><td class='text-left'> " +
				(item.secCode ? item.secCode : "-") +
				" </td><td class='text-left'> " +
				(item.secAbbr ? item.secAbbr : "-") +
				" </td><td class='text-right'> " +
				(item.tradeAmount ? item.tradeAmount : "-") +
				" </td>";
			  html += "</tr>";
			});
			html += "</tbody>";
			$(".js_hgtcjhyzq .table").html(htmlHead + html);
			if (params.type == "date") {
			  $(".js_date .sse_searchInput .js_date").val(
				turnDateAddLine(dataList[0].tradeDate)
			  );
			  $(".js_hgtcjhyzq h2").html(
				"当日沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  turnDateAddLine(dataList[0].tradeDate) +
				  "</span>"
			  );
			} else if (params.type == "month") {
			  $(".js_date .sse_searchInput .js_month").val(
				turnDateAddLine(dataList[0].tradeMonth).replace(/-$/, "")
			  );
			  $(".js_hgtcjhyzq h2").html(
				"当月沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  turnDateAddLine(dataList[0].tradeMonth).replace(/-$/, "") +
				  "</span>"
			  );
			} else if (params.type == "year") {
			  $(".js_date .sse_searchInput .js_year").val(dataList[0].tradeYear);
			  $(".js_hgtcjhyzq h2").html(
				"当年沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  dataList[0].tradeYear +
				  "</span>"
			  );
			}
		  } else {
			if (params.type == "date") {
			  var dayDate = _this.params.tradeDate.tradeDate
				? turnDateAddLine(_this.params.tradeDate.tradeDate)
				: get_systemDate_global();
			  $(".js_date .sse_searchInput .js_date").val(dayDate);
			  $(".js_hgtcjhyzq h2").html(
				"当日沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  dayDate +
				  "</span>"
			  );
			} else if (params.type == "month") {
			  var monthDate = _this.params.tradeMonth.tradeMonth
				? turnDateAddLine(_this.params.tradeMonth.tradeMonth).replace(
					/-$/,
					""
				  )
				: get_systemDate_global().substring(0, 7);
			  $(".js_date .sse_searchInput .js_month").val(monthDate);
			  $(".js_hgtcjhyzq h2").html(
				"当月沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  monthDate +
				  "</span>"
			  );
			} else if (params.type == "year") {
			  var yearDate = _this.params.tradeYear.tradeYear
				? _this.params.tradeYear.tradeYear
				: get_systemDate_global().substring(0, 4);
			  $(".js_date .sse_searchInput .js_year").val(yearDate);
			  $(".js_hgtcjhyzq h2").html(
				"当年沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				  yearDate +
				  "</span>"
			  );
			}
			var emptyTr = '<tbody><tr><td colspan="4">暂无数据</td></tr></tbody>';
			$(".js_hgtcjhyzq .table").html(htmlHead + emptyTr);
		  }
		},
		errCallback: function () {
		  if (params.type == "date") {
			var dayDate = _this.params.tradeDate.tradeDate
			  ? turnDateAddLine(_this.params.tradeDate.tradeDate)
			  : get_systemDate_global();
			$(".js_date .sse_searchInput .js_date").val(dayDate);
			$(".js_hgtcjhyzq h2").html(
			  "当日沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				dayDate +
				"</span>"
			);
		  } else if (params.type == "month") {
			var monthDate = _this.params.tradeMonth.tradeMonth
			  ? turnDateAddLine(_this.params.tradeMonth.tradeMonth).replace(
				  /-$/,
				  ""
				)
			  : get_systemDate_global().substring(0, 7);
			$(".js_date .sse_searchInput .js_month").val(monthDate);
			$(".js_hgtcjhyzq h2").html(
			  "当月沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				monthDate +
				"</span>"
			);
		  } else if (params.type == "year") {
			var yearDate = _this.params.tradeYear.tradeYear
			  ? _this.params.tradeYear.tradeYear
			  : get_systemDate_global().substring(0, 4);
			$(".js_date .sse_searchInput .js_year").val(yearDate);
			$(".js_hgtcjhyzq h2").html(
			  "当年沪股通前十大成交活跃证券<span class='new_date'>数据日期：" +
				yearDate +
				"</span>"
			);
		  }
		  var emptyTr = '<tbody><tr><td colspan="4">暂无数据</td></tr></tbody>';
		  $(".js_hgtcjhyzq .table").html(htmlHead + emptyTr);
		},
	  });
	  //-----------------------------------------------------------------------
	},
  };
  
  //成交活跃证券
  if ($(".js_hgtcjhyzq").length > 0) {
	hgtcjhyzqPage.methods.init();
  }
  
  function hgtzjcysl() {
	this.params = {
	  queryParams: {
		sqlId: "FW_HGTZL_HGTSCSJ_HGTZQCYSL_L",
		secCodeName: "",
		year: "",
		quarter: "",
		isPagination: true,
		"pageHelp.pageSize": 25,
		"pageHelp.pageNo": 1,
		"pageHelp.beginPage": 1,
		"pageHelp.cacheSize": 1,
		"pageHelp.endPage": 1,
	  },
	  quarterList: [
		{ name: "第一季度", value: "1" },
		{ name: "第二季度", value: "2" },
		{ name: "第三季度", value: "3" },
		{ name: "第四季度", value: "4" },
	  ],
	  pagination: {},
	};
	public.call(this);
  }
  
  hgtzjcysl.prototype = Object.create(public.prototype);
  hgtzjcysl.prototype.constructor = hgtzjcysl;
  
  var hgtzjcyslPage = new hgtzjcysl();
  
  hgtzjcyslPage.methods = {
	init: function init() {
	  var _this = hgtzjcyslPage.params,
		_that = this;
	  $("#inputCode").attr("placeholder", "证券代码或简称");
  
	  // 证券代码或简称 输入框
	  $(".search_btn").on("click", function (e) {
		e.stopPropagation();
		_this.queryParams.secCodeName = $("#inputCode").val();
		_this.queryParams["pageHelp.pageNo"] = "1";
		_this.queryParams["pageHelp.beginPage"] = "1";
		// stockList.newTableData(1);
		_that.getData(1);
	  });
  
	  laydate({
		elem: ".js_year_data input",
		theme: "#b50005",
		format: "yyyy",
		trigger: "click",
		type: "year",
		btns: ["confirm"],
		done: function (value, date, endDate) {
		  //选择时间触发查询
		  _this.queryParams.year = $(".js_year_data input").val();
		  _this.queryParams["pageHelp.pageNo"] = "1";
		  _this.queryParams["pageHelp.beginPage"] = "1";
		  setTimeout(function () {
			_that.getData(1);
		  }, 500);
		},
	  });
  
	  bootstrapSelect({
		method: function () {
		  //类型数据渲染
		  $(".js_select_data .selectpicker")
			.html(addSelectOption(_this.quarterList))
			.selectpicker("refresh")
			.selectpicker("render");
		  //类型初始化完成调用接口
		  $(".js_select_data .selectpicker").on("loaded.bs.select", function (e) {
			_this.queryParams.quarter = "";
			_this.queryParams["pageHelp.pageNo"] = "1";
			_this.queryParams["pageHelp.beginPage"] = "1";
			setTimeout(function () {
			  _that.getData(1);
			}, 500);
		  });
		  //下拉框改变触发查询
		  $(".js_select_data .selectpicker").on(
			"changed.bs.select",
			function (e) {
			  _this.queryParams["pageHelp.pageNo"] = "1";
			  _this.queryParams["pageHelp.beginPage"] = "1";
			  _this.queryParams.quarter = $(
				".js_select_data .selectpicker"
			  ).val();
			  setTimeout(function () {
				_that.getData(1);
			  }, 500);
			}
		  );
		},
	  });
	},
	getData: function getData(pageIndex) {
	  var _this = hgtzjcyslPage;
	  var htmlHead = "<thead><tr>";
	  htmlHead += '<th class="text-left">证券代码</th>';
	  htmlHead += '<th class="text-left">证券简称</th>';
	  htmlHead += '<th class="text-left">沪股通投资者合计持有数量</th>';
	  htmlHead += "</tr></thead>";
	  if (!paginationChange(_this.params.queryParams, pageIndex)) return; //触发分页改变分页参数
	  //-----------------------------------------------------------------------
	  _this.params.queryParams.tradeDate = _this.params.queryParams.quarter
		? _this
			.dateConversion(
			  _this.params.queryParams.year,
			  _this.params.queryParams.quarter
			)
			.replace(/\-/g, "")
		: "";
		var objData = JSON.parse(JSON.stringify(_this.params.queryParams))
		delete objData.quarter
		delete objData.year
	  getJSONP({
		type: "post",
		dataType: "jsonp",
		url: _this.url,
		data: objData,
		successCallback: function (data) {
		  if (data && data.result && data.result.length > 0) {
			var yearDate = data.result;
			$(".js_year_data input").val(yearDate[0].tradeDate.substring(0, 4));
			_this.params.queryParams.year = yearDate[0].tradeDate.substring(0, 4);
			var html = "<tbody>";
			$.each(yearDate, function (index, item) {
			  html += "<tr>";
			  html +=
				'<td class="text-left">' +
				(item.secCode ? item.secCode : "-") +
				"</td><td class='text-left'> " +
				(item.secAbbr ? item.secAbbr : "-") +
				"</td><td class='text-left'> " +
				(item.totalHoldings ? item.totalHoldings : "-") +
				" </td>";
			  html += "</tr>";
			});
			html += "</tbody>";
			_this.params.queryParams.quarter = _this.quarterly(
			  Number(yearDate[0].tradeDate.substring(4, 6))
			);
			$(".js_select_data .selectpicker").val(
			  _this.params.queryParams.quarter
			);
			$(".js_select_data .selectpicker").selectpicker("refresh");
			$(".js_holding_quantity .table").html(htmlHead + html);
  
			var downUrl =
			  sseQueryURL +
			  "commonSoaExcelDd.do?sqlId=FW_HGTZL_HGTSCSJ_HGTZQCYSL_L&secCodeName=" +
			  _this.params.queryParams.secCodeName +
			  "&tradeDate=" +
			  _this.params.queryParams.tradeDate;
			$(".js_holding_quantity h2.title_lev2").html(
			  "沪股通证券持有数量" +
				"<span class='new_date'>数据日期：" +
				turnDateAddLine(yearDate[0].tradeDate) +
				"</span><a id='download' class='tableDownload js_download_market' href='" +
				downUrl +
				"'>下载</a>"
			);
  
			Page.navigation(
			  ".js_holding_quantity .pagination-box",
			  data.pageHelp.pageCount,
			  data.pageHelp.total,
			  data.pageHelp.pageNo,
			  data.pageHelp.pageSize,
			  "hgtzjcyslPage.methods.getData"
			);
			// $(".js_holding_quantity .change-pageSize").remove();
		  } else {
			if (_this.params.queryParams.year) {
			  var yearDate = _this.params.queryParams.year;
			} else {
			  var yearDate = get_systemDate_global().substring(0, 4);
			  _this.params.queryParams.quarter = _this.quarterly(
				Number(get_systemDate_global().split("-")[1])
			  );
			  $(".js_select_data .selectpicker").val(
				_this.params.queryParams.quarter
			  );
			  $(".js_select_data .selectpicker").selectpicker("refresh");
			}
			$(".js_year_data input").val(yearDate);
			_this.params.queryParams.year = yearDate;
			var emptyTr = '<tbody><tr><td colspan="3">暂无数据</td></tr></tbody>';
			$(".js_holding_quantity .table").html(htmlHead + emptyTr);
  
			var downUrl =
			  sseQueryURL +
			  "commonSoaExcelDd.do?sqlId=FW_HGTZL_HGTSCSJ_HGTZQCYSL_L&secCodeName=" +
			  _this.params.queryParams.secCodeName +
			  "&tradeDate=" +
			  _this.params.queryParams.tradeDate;
			$(".js_holding_quantity h2.title_lev2").html(
			  "沪股通证券持有数量" +
				"<span class='new_date'>数据日期：" +
				_this.dateConversion(yearDate, _this.params.queryParams.quarter) +
				"</span><a id='download' class='tableDownload js_download_market' href='" +
				downUrl +
				"'>下载</a>"
			);
			$(".js_holding_quantity .pagination-box").html("");
		  }
		},
		errCallback: function () {
		  if (_this.params.queryParams.year) {
			var yearDate = _this.params.queryParams.year;
		  } else {
			var yearDate = get_systemDate_global().substring(0, 4);
			_this.params.queryParams.quarter = _this.quarterly(
			  Number(get_systemDate_global().split("-")[1])
			);
			$(".js_select_data .selectpicker").val(
			  _this.params.queryParams.quarter
			);
			$(".js_select_data .selectpicker").selectpicker("refresh");
		  }
		  $(".js_year_data input").val(yearDate);
		  _this.params.queryParams.year = yearDate;
		  var emptyTr = '<tbody><tr><td colspan="3">暂无数据</td></tr></tbody>';
		  $(".js_holding_quantity .table").html(htmlHead + emptyTr);
  
		  var downUrl =
			sseQueryURL +
			"commonSoaExcelDd.do?sqlId=FW_HGTZL_HGTSCSJ_HGTZQCYSL_L&secCodeName=" +
			_this.params.queryParams.secCodeName +
			"&tradeDate=" +
			_this.params.queryParams.tradeDate;
		  $(".js_holding_quantity h2.title_lev2").html(
			"沪股通证券持有数量" +
			  "<span class='new_date'>数据日期：" +
			  _this.dateConversion(yearDate, _this.params.queryParams.quarter) +
			  "</span><a id='download' class='tableDownload js_download_market' href='" +
			  downUrl +
			  "'>下载</a>"
		  );
		  $(".js_holding_quantity .pagination-box").html("");
		},
	  });
	  //-----------------------------------------------------------------------
	},
  };
  
  //沪股通证券持有数量
  if ($(".js_holding_quantity").length > 0) {
	hgtzjcyslPage.methods.init();
  }