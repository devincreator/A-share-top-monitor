		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(0).css("transform", "matrix(1, 0, 0, 1, 10, 20)");
		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(1).css("transform", "matrix(1, 0, 0, 1, 10, 45)");

		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(2).hide();
		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(3).hide();
		$(obj).find(".highcharts-root").css("transform", "matrix(1, 0, 0, 1, 10, -25)");
		$(obj).css("margin-bottom", "-30px");
	},
	//数组排序取最大值返回
	QuickSort: function (obj) {
		function sortNumber(a, b) {
			return a - b;
		}
		var quickArr = obj.arr,
			index = obj.index,
			maxA = quickArr[index];

		if (obj.type == '亿元') {
			return parseFloat(maxA + 2);
		} else {
			return parseFloat(maxA + 300);
		}
	},
	//股指行情图
	getStockIndex: function () {
		var _this = this;
		var htm = '<thead><tr>';
		htm += '<th>指数名称</th>';
		htm += '<th class="text-right">最新</th>';
		htm += '<th class="text-right">涨跌</th>';
		htm += '</tr></thead><tbody>';
		var emptyTr = '<tr><td colspan="18">暂无数据</td></tr>';
		$.ajax({
			type: 'GET',
			dataType: 'jsonp',
			url: hq_queryUrl + "/v1/csip/list/self/000159_CES300",
			jsonp: 'callback',
			data: {
				select: 'code,name,last,chg_rate'
			},
			cache: false,
			success: function (res) {
				var returnArray = res.list;
				var lastTr = [];

				if (res && returnArray.length > 0) {
					for (var i = 0; i < returnArray.length; ++i) {
						var data = returnArray[i];
						var dataTime = returnArray[0].date;
						if (data[0] == "000159") {
							htm += '<tr class="' + data[0] + '"><td><img src="/xhtml/images/sse.jpg" border="0">';
						} else {
							htm += '<tr class="' + data[0] + '"><td><img src="/xhtml/images/ces.ico" border="0">';
						}
						if (parseFloat(data[3]) > 0) {
							htm += data[1] + '</td><td class="text-right"><font color="red">' + data[2].toFixed(2) + '</font></td>';
							htm += '<td class="text-right"><font color="red">' + data[3].toFixed(2) + '%</font></td>';
							htm += '</tr>';
						} else if (parseFloat(data.sRate) < 0) {
							htm += data[1] + '</td><td class="text-right"><font color="green">' + data[2].toFixed(2) + '</font></td>';
							htm += '<td class="text-right"><font color="green">' + data[3].toFixed(2) + '%</font></td>';
							htm += '</tr>';
						} else {
							htm += data[1] + '</td><td class="text-right">' + data[2].toFixed(2) + '</td>';
							htm += '<td class="text-right">' + data[3].toFixed(2) + '%</td>';
							htm += '</tr>';
						}
						htm += '<tr><td colspan="3" id="stockQC' + data[0] + '" class="stockTr" style="background-color:white;padding:10px 0;"><img src="/xhtml/images/ui/Highcharts-NotData.png" id="Highcharts-NotData" style="width: 90%;"></td></tr>';
						lastTr.push("stockQC" + data[0]);
					}
				} else {
					htm += emptyTr;
				}
				htm += '</tbody>';
				$(".js_stockIndex .table").html(htm);
				/**
				 * 折叠效果
				 */
				for (var i = 0; i < lastTr.length; i++) {
					var selector = lastTr[i];
					var trCode = selector.substring(selector.length - 6, selector.length);
					drawOnehgtZChart(trCode, selector, true, ("#" + selector));
					// 获取当前展开的索引，设置为show()
					$("#" + lastTr[i]).parent('tr').hide();
					$("#" + lastTr[0]).parent('tr').show();
				}
				$(".js_stockIndex .table").find('tr').click(function () {
					var _cliCode = $(this).attr('class');
					if (_cliCode == 'undefined' || _cliCode == null || _cliCode == '') {
						return
					} else {
						$(this).parent().find('.stockTr').parent('tr').hide();
						$(this).next().show();
					}
				});
			}
		});
	}
}
if ($(".js_southboundTrading").length > 0) {
	southboundTrading.init();
}
//港股通--专栏首页 end

/**
 * 港股通交易日安排 
 * 沪港通--专栏首页
 */
 var dayArrangement = {
	tableData: tableData['tableData_1135'],
	init: function () {
		this.getDayList();
	},
	//渲染日安排静态数据列表
	getDayList: function (pageYear,pageMonth) {
		var _this = this;
		if($(".js_table").length <= 0 && $(".js_bottom").length <= 0){
			$(".js_dayArrangement .js_transaction").after('<div class="js_table"></div><div class="js_bottom"></div>');
		}
		if (_this.tableData.list && _this.tableData.list.length > 1) {
			var yearList = {};//selsect的选框数组
			var tableDataList = _this.trimSpace(_this.tableData.list);
			var yearStar = tableDataList[0][0].substring(0,4);
			var yearEnd = tableDataList[tableDataList.length - 1][0].substring(0,4);
			for(var i = yearStar;i <= yearEnd;i++){
				if(i == yearStar){
					yearList[i] = (Number(tableDataList[0][0].substring(5,7)) > 9 ? tableDataList[0][0].substring(5,7) : tableDataList[0][0].substring(6,7));
				} else if(i == yearEnd){
					yearList[i] = (Number(tableDataList[tableDataList.length - 1][0].substring(5,7)) > 9 ? tableDataList[tableDataList.length - 1][0].substring(5,7) : tableDataList[tableDataList.length - 1][0].substring(6,7));
				} else {
					yearList[i] = '12';
				}
			}
			var PageData_Array = [];//渲染页面的数组
			var onDay = 0;//过去一个月几天
			var monthDay = 0;//本月一号周几
			var date = new Date();
			if(!isNull(pageYear) && !isNull(pageMonth)){
				//获取当前的年月
				var year = Number(date.getFullYear());
				var monthNumber = Number(date.getMonth() + 1);
			} else {
				var year = Number(pageYear);
				var monthNumber = Number(pageMonth);
			}
			if(year == yearStar){
				if(new Date(year,monthNumber).getTime() < new Date(yearStar,yearList[yearStar]).getTime()){
					$('#pageMonth').text(yearList[yearStar] + '月');
					monthNumber = Number(yearList[yearStar]);
				}
			}
			if(year == yearEnd){
				if(new Date(year,monthNumber).getTime() > new Date(yearEnd,yearList[yearEnd]).getTime()){
					$('#pageMonth').text(yearList[yearEnd] + '月');
					monthNumber = Number(yearList[yearStar]);
				}
			}
			month = (monthNumber > 9) ? monthNumber : ("0" + monthNumber);
			var today = year + "-" + month + "-" + '01';//当年页面渲染
			var weekDay = [7, 1, 2, 3, 4, 5, 6];  
			var myDate = new Date(Date.parse(today));//例如value:2023-02-01 
			monthDay = weekDay[myDate.getDay()];//算当前月1号周几
			onDay = monthDay;//上个月需要补的天数
			if(monthNumber == 1){
				onMonth = new Date(year - 1, 12, 0).getDate();//上月天数
			} else {
				onMonth = new Date(year, monthNumber - 1, 0).getDate();//上月天数
			}
			toMonth = new Date(year, monthNumber, 0).getDate();//当月天数
			for(var i = onDay-1;i >= 0;i--){
				PageData_Array.push({'pageData':onMonth - i,'year':(monthNumber > 1 ? year : year - 1),'month':(monthNumber > 1 ? monthNumber - 1 : 12),'color':'grey'});
			}
			for(var i = 1;i <= toMonth;i++){
				PageData_Array.push({'pageData':i,'year':year,'month':monthNumber,'color':'black'});
			}
			var length = PageData_Array.length;
			for(var i = 1;i <= 42 - length;i++){
				PageData_Array.push({'pageData':i,'year':(monthNumber < 12 ? year : year + 1),'month':(monthNumber < 12 ? monthNumber + 1 : 1),'color':'grey'});
			}
			var PageData_Array_result = [];//最终渲染数组
			for(var j = 0;j<PageData_Array.length;j++){
				if((new Date(PageData_Array[j].year,PageData_Array[j].month,PageData_Array[j].pageData).getTime() < new Date(yearStar,yearList[yearStar],tableDataList[0][0].substring(8,10)).getTime()) || (new Date(PageData_Array[j].year,PageData_Array[j].month,PageData_Array[j].pageData).getTime() > new Date(yearEnd,yearList[yearEnd],tableDataList[tableDataList.length - 1][0].substring(8,10)).getTime())){
					PageData_Array_result.push({'pageData':'','ymr':PageData_Array[j].year + '-' +((PageData_Array[j].month > 9) ? PageData_Array[j].month : ("0" + PageData_Array[j].month)) + '-' + ((PageData_Array[j].pageData > 9) ? PageData_Array[j].pageData : ("0" + PageData_Array[j].pageData)),'state':'','reason':'','weekDays':'','color':''});
				} else {
					PageData_Array_result.push({'pageData':PageData_Array[j].pageData,'ymr':PageData_Array[j].year + '-' +((PageData_Array[j].month > 9) ? PageData_Array[j].month : ("0" + PageData_Array[j].month)) + '-' + ((PageData_Array[j].pageData > 9) ? PageData_Array[j].pageData : ("0" + PageData_Array[j].pageData)),'state':'','reason':'','weekDays':'','color':PageData_Array[j].color});
				}
			}
			for(var i = 0;i<tableDataList.length;i++){
				for(var j = 0;j<PageData_Array_result.length;j++){
					var myDate = new Date(Date.parse(PageData_Array_result[j].ymr));//例如value:2023-02-01 
					weekDays = weekDay[myDate.getDay()];
					if(PageData_Array_result[j].ymr == tableDataList[i][0]){
						PageData_Array_result[j].state = tableDataList[i][1];
						PageData_Array_result[j].reason = tableDataList[i][2];
					}
					PageData_Array_result[j].weekDays = weekDays;
				}
			}
			var htm_year_li = '';
			for(let key in yearList){
				htm_year_li += '<li class="sse_arrange_head_li '+(year == key? 'sse_arrange_li_select':'')+'" value="'+key+'" >'+key+'</li>';
			}
			var htm_month_li = '';
			for(let key in yearList){
				if(year == key){
					if(key == yearStar){
						for(var i = yearList[key];i <= 12;i++){//测试点1
							htm_month_li += '<li class="sse_arrange_head_li'+(monthNumber == i? ' sse_arrange_li_select':'')+'" >'+(i > 9 ? i : ("0" + i))+'</li>';
						}
					} else if(key == yearEnd){
						for(var i = 1;i <= yearList[key];i++){
							htm_month_li += '<li class="sse_arrange_head_li'+(monthNumber == i? ' sse_arrange_li_select':'')+'" >'+(i > 9 ? i : ("0" + i))+'</li>';
						}
					} else {
						for(var i = 1; i <= 12; i++){
							htm_month_li += '<li class="sse_arrange_head_li'+(monthNumber == i? ' sse_arrange_li_select':'')+'">'+(i > 9 ? i : ("0" + i))+'</li>';
						}
					}
				}
			}
			$(".js_dayArrangement .js_table").css({'display': 'table','width': '100%','padding-bottom': '20px'});
			var htm = '<div class="sse_arrange_head">'+
			'<em class="month_next'+(year == Number(yearEnd) && monthNumber == Number(yearList[yearEnd]) ? ' disable':'')+'" id="imgRight"></em>'+
			'<div class="sse_arrange_head_flex">'+
			   '<div class="sse_arrange_head_year" id="headYear"><span id="pageYear">'+year+'年</span>'+
			   '<img class="sse_arrange_img_down" src="/xhtml/images/table-down.png">'+
			   '<div>'+
			   '<ul class="sse_arrange_year_ul sse_arrange_hide" id="sse_year_select">'+
			   htm_year_li+
			   '</ul>'+
			   '</div>'+
			   '</div>'+
			   '<div class="sse_arrange_head_month" id="headMonth"><span id="pageMonth">'+monthNumber+'月</span><img class="sse_arrange_img_down" src="/xhtml/images/table-down.png"><div>'+
			   '<ul class="sse_arrange_month_ul sse_arrange_hide" id="sse_month_select">'+
			   htm_month_li+
			   '</ul>'+
			   '</div>'+
			   '</div>'+
			'</div>'+
			'<em class="month_pre'+(year == Number(yearStar) && monthNumber == Number(yearList[yearStar]) ? ' disable':'')+'" id="imgLeft"></em>';
			var htm_table = '<thead><tr>';
			htm_table += '<th class="sse_arrange_table_th">日</th>';
			htm_table += '<th class="sse_arrange_table_th">一</th>';
			htm_table += '<th class="sse_arrange_table_th">二</th>';
			htm_table += '<th class="sse_arrange_table_th">三</th>';
			htm_table += '<th class="sse_arrange_table_th">四</th>';
			htm_table += '<th class="sse_arrange_table_th">五</th>';
			htm_table += '<th class="sse_arrange_table_th">六</th>';
			htm_table += '</tr></thead><tbody>';
			var emptyTr = '<tr><td colspan="18">暂无数据</td></tr>';
			htm_table += '<tr>';
      // 在生成每个日期单元格时，添加月份判断
      var currentDisplayYear = year.toString();   // 当前显示的年份
      var currentDisplayMonth = monthNumber.toString().padStart(2, '0');  // 当前显示的月份
			for(var i = 0; i< PageData_Array_result.length; i++){
				var ymrdateStr = PageData_Array_result[i].ymr;
        var [dateYear, dateMonth] = ymrdateStr.split('-');
        var isCurrentMonth = dateYear === currentDisplayYear && dateMonth === currentDisplayMonth;
				if(ymrdateStr <= '2024-12-29' && ymrdateStr > tableDataList[0][0] && PageData_Array_result[i].pageData == ''){
					PageData_Array_result[i].pageData = (ymrdateStr.substring(ymrdateStr.length - 2) < 10 ? ymrdateStr.substring(ymrdateStr.length - 1) : ymrdateStr.substring(ymrdateStr.length - 2));
				}
        
        var dateCellClass = isCurrentMonth ? 'sse_arrange_td_date' : 'sse_arrange_td_date sse_arrange_td_date_ncurrentmonth';
        // 只在当前月显示休市背景
        var haltClass = '';
        if (isCurrentMonth) {
            if (PageData_Array_result[i].state == '全天' && PageData_Array_result[i].reason != '周末' && 
                PageData_Array_result[i].weekDays != 6 && PageData_Array_result[i].weekDays != 7) {
                haltClass = ' sse_arrange_td_date_xiushiallday';
            } else if (PageData_Array_result[i].state == '上午' && PageData_Array_result[i].reason != '周末' && 
                      PageData_Array_result[i].weekDays != 6 && PageData_Array_result[i].weekDays != 7) {
                haltClass = ' sse_arrange_td_date_xiushiam';
            } else if (PageData_Array_result[i].state == '下午' && PageData_Array_result[i].reason != '周末' && 
                      PageData_Array_result[i].weekDays != 6 && PageData_Array_result[i].weekDays != 7) {
                haltClass = ' sse_arrange_td_date_xiushipm';
            }
        }
        var weekendClass ='';
        if (isCurrentMonth) {
          if (PageData_Array_result[i].reason == '周末' || PageData_Array_result[i].weekDays == 6 || PageData_Array_result[i].weekDays == 7)
          weekendClass = 'sse_arrange_zhoumo';
        }

				htm_table += 
				'<td class="sse_arrange_table_td '+ weekendClass +'">'+
				'<div class="sse_arrange_td_container">'+
				'<div class="sse_arrange_td_allday">'+
        '<div class="' + dateCellClass + haltClass + '">' + PageData_Array_result[i].pageData + '</div>' +
				'<div class="sse_arrange_td_txt '+ (!isCurrentMonth ? 'sse_arrange_hide' : (PageData_Array_result[i].reason == '周末' || PageData_Array_result[i].weekDays == 6 || PageData_Array_result[i].weekDays == 7 ? 'sse_arrange_hide':''))+'">'+PageData_Array_result[i].reason+'</div>'+
        '</div>'+
				'</div>'+
				'</td>';
			}
			htm_table += '</tr>';
			htm_table += '</tbody>';
			var htm_bottom = 
			'<div class="sse_arrange_bottom">'+
			'<div class="sse_arrange_statebtns">'+
			'<span class="sse_arrange_each">'+
			'<i class="sse_arrange_tradeday"></i>交易日</span>'+
			'<span  class="sse_arrange_each">'+
			'<i class="sse_arrange_tradeweenken"> </i>周  末</span>'+
			'<span  class="sse_arrange_each">'+
			'<i class="sse_arrange_xiushiallday"> </i>全日休市</span>'+
			'<span  class="sse_arrange_each">'+
			'<i class="sse_arrange_xiushiam"> </i>上午休市</span>'+
			'<span  class="sse_arrange_each">'+
			'<i class="sse_arrange_xiushipm"> </i>下午休市</span>'+
			'</div>'+
			'<div class="sse_arrange_gototoday" id="gototoday">'+
			'<span class="sse_arrange_btn-gototoday">回到当月</span>'+
			'</div>'+
			'</div>'
			// +'<div class="sse_arrange_comment">'+_this.tableData.desc+'</div>';
			$(".js_dayArrangement .js_transaction").html(htm);
			$(".js_dayArrangement .new_date").html($('#pageYear').text() + month + '月');
			$(".js_dayArrangement .js_table").html(htm_table);
			$(".js_dayArrangement .js_bottom").html(htm_bottom);
			var yearScroll = {'yscroll':'','year':$('#pageYear').text()};//年selsect的位置偏移量
			var monthScroll = {'mscroll':'','month':$('#pageMonth').text()};//月selsect的位置偏移量
		} else {
			var emptyTr = '<tr><td colspan="18">暂无数据</td></tr>';
			$(".js_dayArrangement .js_table").html(emptyTr);
			// $(".js_dayArrangement").append('<div class="remarks">' + _this.tableData.desc + '</div>')
			return;
		}
		$("#headYear").click(function(){
			//判断是否有class
			if($("#sse_year_select").hasClass("sse_arrange_hide")){
				//有就删除
				$("#sse_year_select").removeClass("sse_arrange_hide");
				if( yearScroll.year != $('#pageYear').text() || !isNull(yearScroll.yscroll)){
					yearScroll.yscroll = $('#sse_year_select .sse_arrange_li_select').offset().top;
					yearScroll.year = $('#pageYear').text();
				}
				$('#sse_year_select').animate({
					scrollTop:yearScroll.yscroll - $('#sse_year_select').offset().top - 60
				},100)
			}else{
				//没有就添加
				$("#sse_year_select").addClass("sse_arrange_hide");
			}
			$("#sse_month_select").addClass("sse_arrange_hide");
		})

		$("#headMonth").click(function(){
			//判断是否有class
			if($("#sse_month_select").hasClass("sse_arrange_hide")){
				//有就删除
				$("#sse_month_select").removeClass("sse_arrange_hide");
				if( monthScroll.month != $('#pageMonth').text() || !isNull(monthScroll.mscroll)){
					monthScroll.mscroll = $('#sse_month_select .sse_arrange_li_select').offset().top;
					monthScroll.month = $('#pageMonth').text();
				}
				$('#sse_month_select').animate({
					scrollTop:monthScroll.mscroll - $('#sse_month_select').offset().top - 60
				},100)
			}else{
				//没有就添加
				$("#sse_month_select").addClass("sse_arrange_hide");
			}
			$("#sse_year_select").addClass("sse_arrange_hide");
		})
		//点击空白select框消失
		$(document).on("click", function (e) {
			if (!$('#headYear').is(e.target) && $('#headYear').has(e.target).length === 0 && !$('#headMonth').is(e.target) && $('#headMonth').has(e.target).length === 0) {
			  	$("#sse_month_select").addClass("sse_arrange_hide");
				$("#sse_year_select").addClass("sse_arrange_hide");
			}
		});
		//年的点击事件
		$("ul#sse_year_select").on("click","li",function(){
			$('#pageYear').text(_this.yearTransformation($(this).text()));
			_this.selectYearMonth();
		});
		//月的点击事件
		$("ul#sse_month_select").on("click","li",function(){
			if(year == yearEnd && monthNumber == yearList[yearEnd]){
				$('#imgRight').hide();
			}
			$('#pageMonth').text(_this.monthTransformation($(this).text()));
			_this.selectYearMonth();
		});

		$("ul#sse_year_select li").hover(function () {
			$(this).addClass("sse_arrange_li_hover");
	    },function () {
			$(this).removeClass("sse_arrange_li_hover");
	    });

		$("ul#sse_month_select li").hover(function () {
			$(this).addClass("sse_arrange_li_hover");
	    },function () {
			$(this).removeClass("sse_arrange_li_hover");
	    });
		//回到当月
		$('#gototoday').click(function(){
			_this.getDayList();
		})
		$('#imgLeft').click(function(){
			if(year == Number(yearStar) && monthNumber == Number(yearList[yearStar])){
				return;
			}
			if(monthNumber > 1 ){
				var reductionMonth = monthNumber - 1;
				$('#pageMonth').text(reductionMonth + '月');
			} else {
				$('#pageYear').text(year - 1 +'年')
				$('#pageMonth').text(12 + '月');
			}
			_this.selectYearMonth();
		})
		$('#imgRight').click(function(){
			if(year == Number(yearEnd) && monthNumber == Number(yearList[yearEnd])){
				return;
			}
			if(monthNumber < 12 ){
				var add = monthNumber + 1;
				$('#pageMonth').text(add + '月');
			} else {
				$('#pageYear').text(year + 1 +'年')
				$('#pageMonth').text(1 + '月');
			}
			_this.selectYearMonth();
		})
	},
	//去除数组中空的字符串
	trimSpace:function (array){  
		for(var i = 0 ;i<array.length;i++)  
		{  
			if(array[i] == "" || array[i] == null || typeof(array[i]) == "undefined")  
			{  
				array.splice(i,1);  
				i= i-1;  
			}  
		}  
		return array;  
    },
	//选择年月触发
	selectYearMonth:function(){
		var _this = this;
		var pageYear = ($('#pageYear').text()).replace('年','');
		var pageMonth = ($('#pageMonth').text()).replace('月','');
		_this.getDayList(pageYear,pageMonth);
	},
	//年份转化
	yearTransformation:function(val){
		return val + '年';
	},
	//月份转化
	monthTransformation:function(val){
		if(val == '01'){
			return '1月';
		} else if(val == '02'){
			return '2月';
		} else if(val == '03'){
			return '3月';
		} else if(val == '04'){
			return '4月';
		} else if(val == '05'){
			return '5月';
		} else if(val == '06'){
			return '6月';
		} else if(val == '07'){
			return '7月';
		} else if(val == '08'){
			return '8月';
		} else if(val == '09'){
			return '9月';
		} else if(val == '10'){
			return '10月';
		} else if(val == '11'){
			return '11月';
		} else if(val == '12'){
			return '12月';
		}
	}
}
if ($(".js_dayArrangement").length > 0) {
	dayArrangement.init();
}
//沪港通--专栏首页




/* 获取沪港通行情走势值(无成交量) */
function drawOnehgtZChart(code, area, isFirst, id) {
	var linedata = [],
		volume = [],
		volmax = [],
		dateseries = [],
		high = 0,
		low = 0,
		prev_close = 0,
		name = '';
	var obj = {};

	$.ajax({
		type: 'GET',
		dataType: "jsonp",
		url: hq_queryUrl + 'v1/csip/line/' + code,
		jsonp: "callback",
		data: {
			select: 'time,price,volume,avg_price,amount,highest,lowest',
		},
		cache: false,
		success: function (res) {
			prev_close = res.prev_close;
			name = res.code;
			obj['prev_close'] = prev_close;
			obj['name'] = name;
			if (res.line.length == 0 && id) {
				$(id).empty();
				$(id).append('<div class="d-flex align-items-center justify-content-center noChart_message">暂无走势信息</div>');
				return;
			}
			for (var i = 0; i < res.line.length; i++) {
				var linedate = res.date * 1000000 + res.line[i][0];
				linedata.push([convertDateToUTC(String(linedate)), res.line[i][1]]);
				volume.push([convertDateToUTC(String(linedate)), res.line[i][2]]);
				volmax.push(res.line[i][2]);
			}
			obj['linedata'] = linedata;
			obj['volume'] = volume;
			obj['volmax'] = volmax;
			dateseries.push(String(res.date));
			obj['dateseries'] = dateseries;
			high = res.highest;
			low = res.lowest;
			yPositions1 = [
				(parseInt((prev_close - Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low))) * 1000)) / 1000,
				(parseInt((prev_close - Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low)) / 2) * 1000)) / 1000,
				prev_close,
				(parseInt((prev_close + Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low)) / 2) * 1000)) / 1000,
				(parseInt((prev_close + Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low))) * 1000)) / 1000
			];
			yPositions2 = [
				(parseInt(((prev_close - Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low))) / prev_close - 1) * 10000)) / 100,
				(parseInt(((prev_close - Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low)) / 2) / prev_close - 1) * 10000)) / 100,
				'0.00',
				(parseInt(((prev_close + Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low)) / 2) / prev_close - 1) * 10000)) / 100,
				(parseInt(((prev_close + Math.max(Math.abs(high - prev_close), Math.abs(prev_close - low))) / prev_close - 1) * 10000)) / 100
			];
			yPositions3 = [
				0,
				Math.max.apply(null, obj['volmax']) * 0.5,
				Math.max.apply(null, obj['volmax'])
			];
			obj['yPositions1'] = yPositions1;
			obj['yPositions2'] = yPositions2;
			obj['yPositions3'] = yPositions3;
			if (isFirst == true) {
				createOnehgtZChart(area, obj);
			} else {
				updateOnehgtZChart(obj);
			}
		},
		error: function (err) {
			console.log(err);
		},
	});
}

/* 绘制沪港通无成交量行情图 start */
var onehgtChart;
function createOnehgtZChart(area, obj) {
	var areaWidth = $('#' + area).width();
	var showWidth = window.innerWidth > 767 ? 390 : Number(window.innerWidth - 60);
	onehgtChart = Highcharts.stockChart(area, {
		chart: {
			backgroundColor: '',
			height: 150,
			width: showWidth,
			margin: [0, 1, 0, 0],
			//zoomType: 'x',
			events: {
				load: function (e) { },
			},
		},
		colors: ['#2c7be5', '#0d233a', '#8bbc21', '#910000', '#1aadce', '#492970', '#f28f43', '#77a1e5', '#c42525', '#a6c96a'],
		title: {
			text: null
		},
		legend: {
			enabled: false
		},
		tooltip: {
			valueDecinale: 2,
			shared: true,
			useHTML: true,
			formatter: function () {
				var _name = obj['name'];
				var _date = Highcharts.dateFormat('%m月%e日', this.x);
				var _week = convertWeek(Highcharts.dateFormat('%A', this.x));
				var _time = Highcharts.dateFormat('%H:%M', this.x);
				var _y = this.points[0].y.toFixed(2);
				$(".highcharts-tooltip .highcharts-label-box").attr("stroke", this.points[0].color + "");
				return '<p style="margin:0px;padding:0px;font-size:14px;"><span>' + _name + '   </span><span style="' + Comparative(_y, obj['prev_close']) + ';">' + _y + '</span></p><p style="margin:0px;padding:0px;color:#999">' + _date + ' ' + _week + ' ' + _time + '</p>';
			}
		},
		rangeSelector: {
			enabled: false
		},
		navigator: {
			enabled: false
		},
		scrollbar: {
			enabled: false
		},
		xAxis: {
			tickLength: 0,
			startOnTick: true,
			endOnTick: true,
			crosshair: {
				enabled: true,
				color: 'rgba(45,38,27,.4)'
			},
			breaks: [{
				/* 中午时间 */
				from: Date.UTC(2011, 9, 6, 11, 30),
				to: Date.UTC(2011, 9, 6, 13),
				repeat: 24 * 36e5,
				breakSize: 1
			}],
			gridLineColor: 'rgba(224,224,224)',
			gridLineDashStyle: 'ShortDash',
			gridLineWidth: 1,
			labels: {
				enabled: false,
				style: {
					'font-size': '12px',
				},
				useHTML: true,
				step: 1,
				formatter: function () {
					var returnTime = Highcharts.dateFormat('%H:%M', this.value);
					if (returnTime == "11:30") {
						return '<span >11:30/13:00</span>';
					} else if (returnTime == "09:30") {
						return '<span  style="margin-left:32px;">09:30</span>';
					} else if (returnTime == "15:00") {
						return '<span  style="margin-left:-32px;">15:00</span>';
					} else {
						return returnTime;
					}
				},
			},
			/* 以yesterdayClose为界限，统一间隔值，从 最小到最大步进 */
			tickPositioner: function () {
				var positions = [];
				if (areaWidth > 600) {
					for (var i = 0; i < obj['dateseries'].length; i++) {
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 93000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 100000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 103000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 110000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 113000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 133000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 140000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 143000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 150000)));
					}
				} else {
					for (var i = 0; i < obj['dateseries'].length; i++) {
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 93000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 103000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 113000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 140000)));
						positions.push(convertDateToUTC(String(obj['dateseries'][i] * 1000000 + 150000)));
					}
				}

				return positions;
			}
		},
		credits: {
			enabled: false,
		},
		yAxis: [{
			opposite: false,
			minPadding: 0,
			showFirstLabel: true,
			showLastLabel: true,
			offset: 0,
			crosshair: {
				enabled: true,
				color: 'rgba(45,38,27,.4)'
			},
			labels: {
				enabled: false,
				align: 'left',
				x: 2,
				y: 0,
				style: {
					'color': '#231e18',
					'fontSize': '12'
				},
				useHTML: true,
				formatter: function () {
					return '<span style="position:relative;top:3px;">' + (this.value * 1).toFixed(2) + '</span>'
				}
			},
			height: '100%',
			gridLineColor: 'rgba(45,38,27,.1)',
			lineColor: 'rgba(45,38,27,.1)',
			gridLineWidth: 1,
			gridLineDashStyle: 'ShortDash',
			// tickPositions: obj['yPositions1'], //以yesterdayClose为界限，统一间隔值，从 最小到最大步进
		}, {
			opposite: true, //是否把它显示到另一边（右边）
			showFirstLabel: true,
			showLastLabel: true,
			minPadding: 0,
			offset: 0,
			labels: {
				align: 'right',
				x: 0,
				y: 5,
				style: {
					'color': 'rgba(102,102,102)',
					'fontSize': '12'
				},
				useHTML: true,
				formatter: function () {
					/* 主图右侧轴描述 */
					return '<span style="position:relative;top:-2px;font-size:12px;" class=' + Comparative(this.value, 0) + '>' + Math.abs(this.value * 1).toFixed(2) + '%</span>'
				}
			},
			height: '100%',
			lineWidth: 0,
			gridLineWidth: 0,
			// tickPositions: obj['yPositions2'], //以yesterdayClose为界限，统一间隔值，从 最小到最大步进
		}],
		series: [{
			data: obj['linedata'],
			type: 'area',
			color: '#dc3545',
			shadow: true,
			dataGrouping: {
				enabled: false
			},
			lineWidth: 1,
			threshold: obj['prev_close'],
			negativeColor: '#28a745',
			negativeFillColor: {
				lineWidth: 1,
				linearGradient: { //渐变方向
					x1: 0,
					y1: 1,
					x2: 0,
					y2: 0
				},
				shadow: true,
				stops: [
					[0, Highcharts.Color('#28a745').setOpacity(0.2).get('rgba')],
					[1, Highcharts.Color('#28a745').setOpacity(0).get('rgba')]
				]
			},
			fillColor: {
				lineWidth: 1,
				linearGradient: { //渐变方向
					x1: 0,
					y1: 0,
					x2: 0,
					y2: 1
				},
				shadow: true,
				stops: [
					[0, Highcharts.Color('#dc3545').setOpacity(0.2).get('rgba')],
					[1, Highcharts.Color('#dc3545').setOpacity(0).get('rgba')]
				]
			},
			zIndex: 40,
			id: 'sz1',
		}],
	});
}

/* 行情图更新数据重绘 */
function updateOnehgtZChart(obj) {
	onehgtChart.yAxis[0].update({
		tickPositions: obj['yPositions1'],
		redraw: false,
	});
	onehgtChart.yAxis[1].update({
		tickPositions: obj['yPositions2'],
		redraw: false,
	});
	var sz1 = onehgtChart.get('sz1');
	sz1.setData(obj['linedata'], true, false, false);
	onehgtChart.redraw();
}
/* 绘制沪港通行情图 end */


/**
 * 服务->沪港通 ->港股通信息披露 ->港股通标的证券调整信息
 */

var eligiblead = {
	newTableList : {
		sqlId: "COMMON_SSE_JYFW_HGT_XXPL_BDZQTZXX_L",
		isPagination: true,
		"pageHelp.pageSize": 10,
		"pageHelp.pageNo": 1,
		"pageHelp.beginPage": 1,
		"pageHelp.cacheSize": 1,
		"pageHelp.endPage": 1,
		keyword: '',
		validDate: '',
		},
	init: function () {
		this.loadEvents();
		// 证券代码或简称 输入框
		$(".search_btn").on("click", function (e) {
			e.stopPropagation();
			eligiblead.newTableList.keyword = $("#inputCode").val();
			eligiblead.newTableData(1);
		});
	},
	loadEvents: function() {
		// 下载
		var downUrl = sseQueryURL + 'commonExcelDd.do?sqlId=COMMON_SSE_JYFW_HGT_XXPL_BDZQTZXX_L&keyword=' + eligiblead.newTableList.keyword + '&validDate=' + eligiblead.newTableList.validDate;
		var downHtm = '<a id="download" class="tableDownload js_download_market" href="' + downUrl + '">' + "下载</a>";
		$(".js_eligiblead .title_lev2 .new_date").after(downHtm);
		$('#download').bind('click', function(){
			var downUrl = sseQueryURL + 'commonExcelDd.do?sqlId=COMMON_SSE_JYFW_HGT_XXPL_BDZQTZXX_L&keyword=' + eligiblead.newTableList.keyword + '&validDate=' + eligiblead.newTableList.validDate;
			$('#download').attr({href:downUrl});
		})
		$(".sse_searchInput .sse_input").attr("placeholder", "生效日期");
		$("#inputCode").attr("placeholder", "代码/中文简称/英文简称");
		//日期范围渲染
		var _this = this;
		laydate({
			elem: ".js_date input",
			theme: "#b50005",
			format: "yyyy-MM-dd",
			trigger: "click",
			btns: ["clear", "confirm"],
			done: function (value, date, endDate) {
			  //选择时间触发查询
			  setTimeout(function () {
				eligiblead.newTableList.validDate = value.replace(/-/g,'')
				_this.newTableData(1);
			  }, 500);
			},
		  });
		eligiblead.newTableData(1);
	},
	newTableData: function (pageIndex) {
		var _this = this;
		if (!paginationChange(_this.newTableList, pageIndex)) {//触发分页改变分页参数
			return
		} 
		var emptyTr = '<tr><td colspan="4">暂无数据</td></tr>';
		var stockNewTable = "<thead><tr>";
		stockNewTable += '<th class="text-nowrap">序号</th>';
		stockNewTable += '<th class="text-nowrap">证券代码</th>';
		stockNewTable += '<th class="text-nowrap">英文简称</th>';
		stockNewTable += '<th class="text-nowrap">中文简称(参考)</th>';
		stockNewTable += '<th class="text-nowrap">品种</th>';
		stockNewTable += '<th class="text-nowrap">调整内容</th>';
		stockNewTable += '<th class="text-nowrap">生效日期</th>';
		stockNewTable += "</tr></thead><tbody>";
		getJSONP({
			type: "post",
			url: sseQueryURL + "commonQuery.do?jsonCallBack=?",
			data: _this.newTableList,
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0) {
					$.each(data.result, function (k, v) {
						stockNewTable += "<tr>";
						stockNewTable += '<td class="text-nowrap">' + v.NUM + "</td>";
						stockNewTable += '<td class="text-nowrap">' + v.SECURITY_CODE + "</td>"
						stockNewTable += '<td class="text-nowrap">' + v.ABBR_EN + "</td>";
						stockNewTable += '<td class="text-nowrap">' + v.SECURITY_ABBR + "</td>";
						stockNewTable += '<td class="text-nowrap">' + v.SECURITY_TYPE + "</td>";
						stockNewTable += '<td class="text-nowrap">' + v.ADJUST_TYPE + "</td>"
						stockNewTable += '<td class="text-nowrap">' + v.VALID_DATE + "</td>";
						stockNewTable += "</tr>";
					});
					Page.navigation(
					  ".js_eligiblead .pagination-box",
					  data.pageHelp.pageCount,
					  data.pageHelp.total,
					  data.pageHelp.pageNo,
					  data.pageHelp.pageSize,
					  "eligiblead.newTableData"
					);
				   //日期赋值
					$(".js_eligiblead .new_date").html("更新日期：" + data.result[0].FILE_DATE);
				  } else {
					stockNewTable += emptyTr;
					stockNewTable += "</tbody>";
					$(".js_eligiblead .table").html(stockNewTable);
					$(".js_eligiblead .pagination-box").html("");
				  }
				  stockNewTable += "</tbody>";
				  $(".js_eligiblead .table").html(stockNewTable);
			},
			errCallback: function () {
			  stockNewTable += emptyTr;
			  stockNewTable += "</tbody>";
			  $(".js_eligiblead .table").html(stockNewTable);
			  $(".js_eligiblead .pagination-box").html("");
			},
		  });
	}
}
if ($(".js_eligiblead").length > 0) {
	eligiblead.init();
}

