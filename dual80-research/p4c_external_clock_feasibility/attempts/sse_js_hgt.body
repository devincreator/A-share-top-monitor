/**
 * @param {数据处理} data 
 */
function dataTreating(data){
	if(data.indexOf(',') < 0){
		return data;
	} else {
		return data.replace(/\,/g, '');
	}
}
function public(params) {
	this.url = sseQueryURL + "commonSoaQuery.do";
  }
  
  public.prototype.quarterly = function quarterly(params) {
	if (params <= 3) {
	  return "1";
	} else if (3 < params && params <= 6) {
	  return "2";
	} else if (6 < params && params <= 9) {
	  return "3";
	} else if (9 < params && params <= 12) {
	  return "4";
	} else {
	  return "";
	}
  };
  
  public.prototype.dateConversion = function dateConversion(year, quarter) {
	switch (quarter) {
	  case "1":
		return year + "-03-31";
	  case "2":
		return year + "-06-30";
	  case "3":
		return year + "-09-30";
	  case "4":
		return year + "-12-31";
	  default:
		return "";
	}
  };
  
  public.prototype.getEndMonth = function getEndMonth() {
	var month = get_systemDate_global().substring(5, 7);
	switch (month) {
	  case "01":
	  case "03":
	  case "05":
	  case "07":
	  case "08":
	  case "10":
	  case "12":
		return get_systemDate_global().substring(0, 8) + "31";
	  case "04":
	  case "06":
	  case "09":
	  case "11":
		return get_systemDate_global().substring(0, 8) + "30";
	  case "02":
		return turnDateToString(
		  new Date(
			new Date(
			  get_systemDate_global().substring(0, 4) + "/03/01"
			).getTime() -
			  1000 * 3600 * 24
		  )
		);
	  default:
		break;
	}
  };
  
  public.prototype.getEndYear = function getEndYear(params) {
	return get_systemDate_global().substring(0, 4) + "-12-31";
  };


