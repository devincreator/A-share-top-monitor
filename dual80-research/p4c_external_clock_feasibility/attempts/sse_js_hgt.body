		var emptyTr = '<tr><td colspan="2">暂无数据</td></tr>'
		var hkexsctradingYearHtml = '<thead><tr>';
		hkexsctradingYearHtml += '<th class="text-nowrap">当年情况</th>';
		hkexsctradingYearHtml += '<th class="text-right">成交概况</th>';
		hkexsctradingYearHtml += '</tr></thead><tbody>';
		$(".js_hkexsctrading_year .remarks").remove();
		getJSONP({
			type: 'post',
			dataType: 'jsonp',
			url: _this.hkexsctradingYearUrl,
			data: _this.hkexsctradingYearParam,
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0 && data.result[0]) {
					var v = data.result[0];
					if (v) {
						hkexsctradingYearHtml += '<tr>';
						hkexsctradingYearHtml += '<td class="text-nowrap">当年买入成交金额（亿元）</td><td class="text-right">' + (v.BUY_AMT ? v.BUY_AMT : '-') + '</td>';
						hkexsctradingYearHtml += '</tr>';
						hkexsctradingYearHtml += '<tr>';
						hkexsctradingYearHtml += '<td class="text-nowrap">当年买入成交笔数（万笔）</td><td class="text-right">' + (v.BUY_VOL ? v.BUY_VOL : '-') + '</td>';
						hkexsctradingYearHtml += '</tr>';
						hkexsctradingYearHtml += '<tr>';
						hkexsctradingYearHtml += '<td class="text-nowrap">当年卖出成交金额（亿元）</td><td class="text-right">' + (v.SELL_AMT ? v.SELL_AMT : '-') + '</td>';
						hkexsctradingYearHtml += '</tr>';
						hkexsctradingYearHtml += '<tr>';
						hkexsctradingYearHtml += '<td class="text-nowrap">当年卖出成交笔数（万笔）</td><td class="text-right">' + (v.SELL_VOL ? v.SELL_VOL : '-') + '</td>';
						hkexsctradingYearHtml += '</tr>';
					}
					hkexsctradingYearHtml += '</tbody>';
					$(".js_hkexsctrading_year .table").html(hkexsctradingYearHtml);
				} else {
					hkexsctradingYearHtml += emptyTr;
					hkexsctradingYearHtml += '</tbody>';
					$(".js_hkexsctrading_year .table").html(hkexsctradingYearHtml);
				}
				if (_this.hkexsctradingYearParam.year == get_systemDate_global().substring(0, 4)) {
					$(".js_hkexsctrading_year").append('<div class="remarks"><span>*本年度数据统计截止前1交易月</span></div>');
				}
			},
			errCallback: function () {
				hkexsctradingYearHtml += emptyTr;
				hkexsctradingYearHtml += '</tbody>';
				$(".js_hkexsctrading_year .table").html(hkexsctradingYearHtml);
			}
		})
	}
}
if ($(".js_hkexsctrading_year").length > 0) {
	hkexsctradingYear.init();
}
//每年成交信息END
// 港股通成交信息 END

/**
 * 港股通--专栏首页
 */
var southboundTrading = {
	amountUrl: hq_queryUrl + "/v1/hkp/status/amount_status",
	tableData: tableData['tableData_1120'],
	amount: [], //成交笔数
	money: [],//成交金额
	groupingUnits: [
		['minute', [1]]
	],
	init: function () {
		var _this = this;
		_this.loadEvents();
		_this.getTradingDay();
		require(['highstock'], function () {
			_this.setMarkData();
			_this.getyunhqChart();
			setInterval(function () {
				var ret = _this.getyunhqChart();
				if (ret.success == true) {
					_this.hgtChart(ret);
				}
			}, 60000);
			_this.getStockIndex();
			setInterval(_this.getStockIndex, 60000); //定时任务
		});
	},
	loadEvents: function () {
		this.amount = [ //成交笔数
			transactionData[0].BUY_VOLUME,
			transactionData[1].BUY_VOLUME,
			transactionData[0].SELL_VOLUME,
			transactionData[1].SELL_VOLUME
		],
			this.money = [ //成交金额
				transactionData[0].BUY_AMOUNT,
				transactionData[1].BUY_AMOUNT,
				transactionData[0].SELL_AMOUNT,
				transactionData[1].SELL_AMOUNT
			],
			//移动端--轮播
			setSwiper({
				el: '.swiper-container4',
				param: {
					autoplay: {
						delay: 8000,
						disableOnInteraction: false,
					},
					speed: 900,
					loop: false,
					pagination: {
						el: '.pagination',
						type: 'bullets',
						clickable: true,
					},
				},
			})
		//右侧标题下面的日期拼接--港股通服务状态、当日额度余额
		$(".js_serviceStatus .table-responsive").before('<div class="table_tip"></div>');
		$("#viewCharthgt").before('<div class="table_tip"></div>');
		//参考汇率、结算汇兑比率赋值
		$(".js_referenceRate .rateCon").before('<div class="table_tip">' + "货币种类：" + CURRENCY_TYPE + " 适用日期：" + VALID_DATE + '</div>');
		$(".js_referenceRate .rateBottom").eq(0).text(BUY_PRICE);
		$(".js_referenceRate .rateBottom").eq(1).text(SELL_PRICE);

		$(".js_settlementRate .rateCon").before('<div class="table_tip">' + "货币种类：" + CURRENCY_TYPE_clear + " 适用日期：" + VALID_DATE_clear + '</div>');
		$(".js_settlementRate .rateBottom").eq(0).text(BUY_PRICE_clear);
		$(".js_settlementRate .rateBottom").eq(1).text(SELL_PRICE_clear);

		//港股通服务状态表格填充
		var htm = '<tbody>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">是否港股通交易日</td>';
		htm += '<td id="chartId1" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">买入申报状态</td>';
		htm += '<td id="chartId2" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">卖出申报状态</td>';
		htm += '<td id="chartId3" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '</tbody>';
		$(".js_serviceStatus .table").html(htm);
		//当日额度余额--注
		var txtHtm = '<div class="remarks">注: 1、每日额度为420亿。<br>     2、上表在交易日的交易期间每1分钟更新一次。<br>     3、上表当日额度余额，按照去尾法截取整数部分。<br>     4、发生下述三种情形之一的，当日额度余额显示为0：情形一，因为显示精度的原因，当日额度余额少于100万时，显示为0；情形二，当日额度余额计算结果小于等于0时，显示为0；情形三，因当日额度使用完毕或者其他任何原因，在全市场范围暂停接受买入申报时，当日额度余额显示为0。<br>     5、申报状态仅在港股通交易日有效。</div>'
		$(".js_viewChartCon").append(txtHtm);
	},
	//成交信息需要的数据
	setMarkData: function () {
		var _this = this;
		//成交金额
		var quickSortArr = [Number(_this.money[0]), Number(_this.money[1]), Number(_this.money[2]), Number(_this.money[3])];
		_this.buyC("#js_turnoverChart", quickSortArr, '亿元');
		//成交笔数
		var quickSortArr02 = [Number(_this.amount[0]), Number(_this.amount[1]), Number(_this.amount[2]), Number(_this.amount[3])];
		_this.buyC("#js_transactionsChart", quickSortArr02, '万笔');
	},
	//交易日安排
	getTradingDay: function () {
		var _this = this;
		var emptyTr = '<tr><td colspan="3">暂无数据</td></tr>';
		var htm = '<thead>';
		htm += '<tr>';
		htm += '<th>日期</th>';
		htm += '<th>不提供港股通服务</th>';
		htm += '<th>原因</th>';
		htm += '</tr>';
		htm += '</thead>';
		htm += '<tbody>';
		if (_this.tableData.list && _this.tableData.list.length > 1) {
			$.each(_this.tableData.list, function (k, v) {
				if (v) {
					htm += '<tr>';
					htm += '<td>' + v[0] + '</td>';
					htm += '<td>' + v[1] + '</td>';
					htm += '<td>' + v[2] + '</td>';
					htm += '</tr>';
				}
			})
		} else {
			htm += emptyTr;
		}
		htm += '</tbody>';
		$(".js_southboundTrading .table").html(htm);
		var pHead = '<div class="text-center" style="padding:10px 8px 6px 8px;font-size:14px;color: rgb(255, 255, 255); background-color: rgb(65, 141, 211);">近期不提供港股通服务的日期</div>';
		$(".js_southboundTrading .table-responsive").before(pHead);
	},
	//当日额度余额
	getyunhqChart: function () {
		var _this = this;
		var hgtDailyInfo = {
			daily_amt: '',
			day_unused: '',
			mktstatus_first: -1,
			mktstatus_second: -1,
			mktstatus_third: -1,
			create_time: '',
			success: false
		}
		$.ajax({
			type: 'POST',
			dataType: "jsonp",
			url: _this.amountUrl,
			jsonp: "callback",
			data: {},
			cache: false,
			success: function (resultData) {
				var dateStr = new String(resultData.date);
				var status = resultData.status;
				var timeStr = new String(status[0][1]); //港股通交易余额时间 Hmmss***
				dateStr = dateStr.substring(0, 4) + '-' + dateStr.substring(4, 6) + '-' + dateStr.substring(6);
				if (timeStr.length >= 9) {//hour > 9 clock
					timeStr = timeStr.substring(0, 2) + ':' + timeStr.substring(2, 4) + ':' + timeStr.substring(4, 6);
				} else {//hour <= 9 clock
					timeStr = timeStr.substring(0, 1) + ':' + timeStr.substring(1, 3) + ':' + timeStr.substring(3, 5);
				}
				var mktStatus = new String(status[2][1]); //第1位：‘0’表示全市场限制买入，‘1’表示正常无此限制。第2位：‘0’表示全市场限制卖出，‘1’表示正常无此限制。
				//第3位：‘0’表示当日非港股通交易日，‘1’表示当日港股通交易日
				hgtDailyInfo.mktstatus_first = mktStatus.substring(0, 1);
				hgtDailyInfo.mktstatus_second = mktStatus.substring(1, 2);
				hgtDailyInfo.mktstatus_third = mktStatus.substring(2, 3);
				hgtDailyInfo.daily_amt = status[3] / 1000000;
				hgtDailyInfo.day_unused = status[4] / 1000000;
				hgtDailyInfo.create_time = dateStr + ' ' + timeStr;
				hgtDailyInfo.success = true;
				_this.hgtChart(hgtDailyInfo);
			}
		});
		return hgtDailyInfo;
	},
	//服务状态
	hgtChart: function (dailyinfo) {
		var _this = this;
		var chart_mktstatus_first = "";
		var chart_mktstatus_second = "";
		var chart_mktstatus_third = "";
		var daily_amt = parseInt(dailyinfo.daily_amt);
		var day_unused = parseInt(dailyinfo.day_unused);
		var remain_amt = daily_amt - day_unused < 0 ? 0 : daily_amt - day_unused;
		if ("1" == dailyinfo.mktstatus_first) {
			chart_mktstatus_first = "接受";
		} else if ("0" == dailyinfo.mktstatus_first) {
			chart_mktstatus_first = "不接受";
		}
		if ("1" == dailyinfo.mktstatus_second) {
			chart_mktstatus_second = "接受";
		} else if ("0" == dailyinfo.mktstatus_second) {
			chart_mktstatus_second = "不接受";
		}
		if ("1" == dailyinfo.mktstatus_third) {
			chart_mktstatus_third = "是";
		} else if ("0" == dailyinfo.mktstatus_third) {
			chart_mktstatus_third = "否";
		}

		$("#chartId1").html(chart_mktstatus_third);
		$("#chartId2").html(chart_mktstatus_first);
		$("#chartId3").html(chart_mktstatus_second);
		$(".js_serviceStatus .table_tip").html("日期：" + dailyinfo.create_time.substring(0, 10));
		$(".js_viewChartCon .table_tip").html("更新时间：" + dailyinfo.create_time);

		_this.doughnutChart({
			done: remain_amt,
			undone: day_unused
		});
	},
	//画图--当日额度余额
	doughnutChart: function (obj) {
		var _this = this;
		var done = obj.done,
			undone = obj.undone;
		var sizeNum = 24;
		if (clientWidth < 1200 && clientWidth > 768) {
			sizeNum = 18;
		}
		$('#viewCharthgt').highcharts({
			chart: {
				plotBackgroundColor: null,
				plotBorderWidth: null,
				plotShadow: false,
				animation: false,
				height: 210
			},
			title: {
				floating: true,
				text: '<span style="margin-left:23px;">当日额度余额</span><br><span style="font-size:' + sizeNum + 'px;">' + Number((undone / 100).toFixed(2)) + '亿元</span>',
				style: {
					fontSize: '12px',
					fontFamily: 'microsoft yahei',
					color: '#666',
					fill: '#666'
				}
			},
			tooltip: {
				formatter: function () {
					return this.key + ':' + Number((this.y / 100).toFixed(2)) + "亿元";
				}
			},
			credits: {
				enabled: false
			},
			plotOptions: {
				pie: {
					allowPointSelect: false,//点击后中间标题换成当前鼠标选中标题
					cursor: 'pointer',
					dataLabels: {
						enabled: false
					}
				}
			},
			series: [{
				type: 'pie',
				innerSize: '90%',
				animation: false,
				data: [{
					name: '已用额度',
					y: done,
					color: '#7cb5ec'
				},
				{
					name: '可用额度',
					y: undone,
					color: '#f15c80'
				}
				]
			}]
		}, function (c) {
			// 环形图圆心
			var centerY = c.series[0].center[1],
				titleHeight = parseInt(c.title.styles.fontSize);
			c.setTitle({
				y: centerY + titleHeight / 2 - 20
			});
			chart = c;
		});
	},
	//画图--成交信息
	buyC: function (obj, quickSortArr, strType) {
		var _this = this;
		var dataShadow = [],
			yMax = _this.QuickSort({
				arr: quickSortArr,
				index: quickSortArr.length - 1,
				type: strType
			});
		$(obj).highcharts({
			chart: {
				type: 'column',
				inverted: true,
				height: 220,
			},
			title: {
				text: ''
			},
			xAxis: {
				categories: [
					'买入',
					'卖出'
				],
				title: {
					text: null
				},
				labels: {
					enabled: true
				},
				tickWidth: 0,
				lineColor: '#FFFFFF'
			},
			yAxis: [{
				min: 0,
				labels: {
					enabled: false
