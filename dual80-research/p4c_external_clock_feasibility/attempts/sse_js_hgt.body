	init: function () {
		this.loadEvents();
	},
	loadEvents: function () {
		var _this = this;
		//月渲染
		laydate({
			elem: ".js_hkexsctrading_month .js_date input",
			theme: '#b50005',
			type: 'month',
			format: 'yyyy-MM',
			min: '2014-01-01',
			max: public.prototype.getEndMonth(),
