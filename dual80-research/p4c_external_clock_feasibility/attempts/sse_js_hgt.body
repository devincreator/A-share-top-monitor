				x: -8,
				y: -4, //图例在Y轴显示的垂直位置
				itemStyle: {
					color: '#898989',
					fontWeight: "normal",
					cursor: "pointer"
				}
			},
			tooltip: {
				formatter: function () {
					if (this.series.name.split(' ')[0] == 'Series') {
						return false;
