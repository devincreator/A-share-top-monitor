/**
 * 港股通--专栏首页（新）
 */
var southboundTrading_new = {
	amountUrl: hq_queryUrl + "/v1/hkp/status/amount_status",
	tableData: tableData['tableData_1120'],
	amount: [], //成交笔数
	money: [],//成交金额
	groupingUnits: [
		['minute', [1]]
	],
	init: function () {
		var _this = this;
		_this.loadEvents();
		_this.getTradingDay();
		require(['highstock'], function () {
			_this.setMarkData();
			_this.getyunhqChart();
			setInterval(function () {
				var ret = _this.getyunhqChart();
				if (ret.success == true) {
					_this.hgtChart(ret);
				}
			}, 60000);
			_this.getStockIndex();
			setInterval(_this.getStockIndex, 60000); //定时任务
		});
	},
	loadEvents: function () {
		this.amount = [ //成交笔数
			transactionData[0].BUY_VOLUME,
			transactionData[1].BUY_VOLUME,
			transactionData[0].SELL_VOLUME,
			transactionData[1].SELL_VOLUME
		],
			this.money = [ //成交金额
				transactionData[0].BUY_AMOUNT,
				transactionData[1].BUY_AMOUNT,
				transactionData[0].SELL_AMOUNT,
				transactionData[1].SELL_AMOUNT
			],
			//移动端--轮播
			setSwiper({
				el: '.swiper-container4',
				param: {
					autoplay: {
						delay: 8000,
						disableOnInteraction: false,
					},
					speed: 900,
					loop: false,
					pagination: {
						el: '.pagination',
						type: 'bullets',
						clickable: true,
					},
				},
			})
		//右侧标题下面的日期拼接--港股通服务状态、当日额度余额
		$(".js_serviceStatus_new .table-responsive").before('<div class="table_tip"></div>');
		$("#js_viewCharthgt_new").before('<div class="table_tip"></div>');
		//参考汇率、结算汇兑比率赋值
		$(".js_referenceRate_new .rateCon").before('<div class="table_tip">' + "货币种类：" + CURRENCY_TYPE + " 适用日期：" + VALID_DATE + '</div>');
		$(".js_referenceRate_new .rateBottom").eq(0).text(BUY_PRICE);
		$(".js_referenceRate_new .rateBottom").eq(1).text(SELL_PRICE);

		$(".js_settlementRate_new .rateCon").before('<div class="table_tip">' + "货币种类：" + CURRENCY_TYPE_clear + " 适用日期：" + VALID_DATE_clear + '</div>');
		$(".js_settlementRate_new .rateBottom").eq(0).text(BUY_PRICE_clear);
		$(".js_settlementRate_new .rateBottom").eq(1).text(SELL_PRICE_clear);

		//港股通服务状态表格填充
		var htm = '<tbody>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">是否港股通交易日</td>';
		htm += '<td id="js_chartId1_new" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">买入申报状态</td>';
		htm += '<td id="js_chartId2_new" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '<tr>';
		htm += '<td class="text-nowrap">卖出申报状态</td>';
		htm += '<td id="js_chartId3_new" class="text-nowrap"></td>';
		htm += '</tr>';
		htm += '</tbody>';
		$(".js_serviceStatus_new .table").html(htm);
		//当日额度余额--注
		var txtHtm = '<div class="remarks">注: 1、每日额度为420亿。<br>     2、上表在交易日的交易期间每1分钟更新一次。<br>     3、交易日的交易时间内，当日额度剩余大于等于30%（即126亿元）时，不展示具体的数值，仅提示“额度充足”；当日额度剩余小于30%时，公布当日额度余额，按照去尾法截取整数部分。<br>     4、发生下述三种情形之一的，当日额度余额显示为0：情形一，因为显示精度的原因，当日额度余额少于100万时，显示为0；情形二，当日额度余额计算结果小于等于0时，显示为0；情形三，因当日额度使用完毕或者其他任何原因，在全市场范围暂停接受买入申报时，当日额度余额显示为0。<br>     5、申报状态仅在港股通交易日有效。</div>'
		$(".js_viewChartCon_new").append(txtHtm);
	},
	//成交信息需要的数据
	setMarkData: function () {
		var _this = this;
		//成交金额
		var quickSortArr = [Number(dataTreating(_this.money[0])), Number(dataTreating(_this.money[1])), Number(dataTreating(_this.money[2])), Number(dataTreating(_this.money[3]))];
		_this.buyC("#js_turnoverChart_new", quickSortArr, '亿元');
		//成交笔数
		var quickSortArr02 = [Number(dataTreating(_this.amount[0])), Number(dataTreating(_this.amount[1])), Number(dataTreating(_this.amount[2])), Number(dataTreating(_this.amount[3]))];
		_this.buyC("#js_transactionsChart_new", quickSortArr02, '万笔');
	},
	//交易日安排
	getTradingDay: function () {
		var _this = this;
		var emptyTr = '<tr><td colspan="3">暂无数据</td></tr>';
		var htm = '<thead>';
		htm += '<tr>';
		htm += '<th>日期</th>';
		htm += '<th>不提供港股通服务</th>';
		htm += '<th>原因</th>';
		htm += '</tr>';
		htm += '</thead>';
		htm += '<tbody>';
		if (_this.tableData.list && _this.tableData.list.length > 1) {
			$.each(_this.tableData.list, function (k, v) {
				if (v) {
					htm += '<tr>';
					htm += '<td>' + v[0] + '</td>';
					htm += '<td>' + v[1] + '</td>';
					htm += '<td>' + v[2] + '</td>';
					htm += '</tr>';
				}
			})
		} else {
			htm += emptyTr;
		}
		htm += '</tbody>';
		$(".js_southboundTrading_new .table").html(htm);
		var pHead = '<div class="text-center" style="padding:10px 8px 6px 8px;font-size:14px;color: rgb(255, 255, 255); background-color: rgb(65, 141, 211);">近期不提供港股通服务的日期</div>';
		$(".js_southboundTrading_new .table-responsive").before(pHead);
	},
	//当日额度余额
	getyunhqChart: function () {
		var _this = this;
		var hgtDailyInfo = {
			daily_amt: '',
			day_unused: '',
			mktstatus_first: -1,
			mktstatus_second: -1,
			mktstatus_third: -1,
			create_time: '',
			success: false
		}
		$.ajax({
			type: 'POST',
			dataType: "jsonp",
			url: _this.amountUrl,
			jsonp: "callback",
			data: {},
			cache: false,
			success: function (resultData) {
				var dateStr = new String(resultData.date);
				var status = resultData.status;
				var timeStr = new String(status[0][1]); //港股通交易余额时间 Hmmss***
				dateStr = dateStr.substring(0, 4) + '-' + dateStr.substring(4, 6) + '-' + dateStr.substring(6);
				if (timeStr.length >= 9) {//hour > 9 clock
					timeStr = timeStr.substring(0, 2) + ':' + timeStr.substring(2, 4) + ':' + timeStr.substring(4, 6);
				} else {//hour <= 9 clock
					timeStr = timeStr.substring(0, 1) + ':' + timeStr.substring(1, 3) + ':' + timeStr.substring(3, 5);
				}
				var mktStatus = new String(status[2][1]); //第1位：‘0’表示全市场限制买入，‘1’表示正常无此限制。第2位：‘0’表示全市场限制卖出，‘1’表示正常无此限制。
				//第3位：‘0’表示当日非港股通交易日，‘1’表示当日港股通交易日
				hgtDailyInfo.mktstatus_first = mktStatus.substring(0, 1);
				hgtDailyInfo.mktstatus_second = mktStatus.substring(1, 2);
				hgtDailyInfo.mktstatus_third = mktStatus.substring(2, 3);
				hgtDailyInfo.daily_amt = status[3] / 1000000;
				hgtDailyInfo.day_unused = status[5] == '3' ? status[3] / 1000000 : status[4] / 1000000;
				hgtDailyInfo.create_time = dateStr + ' ' + timeStr;
				hgtDailyInfo.success = true;
				hgtDailyInfo.amount_status = status[5];
				_this.hgtChart(hgtDailyInfo);
			}
		});
		return hgtDailyInfo;
	},
	//服务状态
	hgtChart: function (dailyinfo) {
		var _this = this;
		var chart_mktstatus_first = "";
		var chart_mktstatus_second = "";
		var chart_mktstatus_third = "";
		var daily_amt = parseInt(dailyinfo.daily_amt);//总额度
		var day_unused = parseInt(dailyinfo.day_unused);//可用额度
		var amount_status = dailyinfo.amount_status;
		var remain_amt = daily_amt - day_unused < 0 ? 0 : daily_amt - day_unused;//已用额度
		if ("1" == dailyinfo.mktstatus_first) {
			chart_mktstatus_first = "接受";
		} else if ("0" == dailyinfo.mktstatus_first) {
			chart_mktstatus_first = "不接受";
		}
		if ("1" == dailyinfo.mktstatus_second) {
			chart_mktstatus_second = "接受";
		} else if ("0" == dailyinfo.mktstatus_second) {
			chart_mktstatus_second = "不接受";
		}
		if ("1" == dailyinfo.mktstatus_third) {
			chart_mktstatus_third = "是";
		} else if ("0" == dailyinfo.mktstatus_third) {
			chart_mktstatus_third = "否";
		}

		$("#js_chartId1_new").html(chart_mktstatus_third);
		$("#js_chartId2_new").html(chart_mktstatus_first);
		$("#js_chartId3_new").html(chart_mktstatus_second);
		$(".js_serviceStatus_new .table_tip").html("日期：" + dailyinfo.create_time.substring(0, 10));
		$(".js_viewChartCon_new .table_tip").html("更新时间：" + dailyinfo.create_time);

		_this.doughnutChart({
			done: remain_amt,//已用额度
			undone: day_unused,//可用额度
			status: amount_status
		});
	},
	//画图--当日额度余额
	doughnutChart: function (obj) {
		var _this = this;
		var done = obj.done,//已用额度
			undone = obj.undone;//可用额度
		var sizeNum = 24;
		if (clientWidth < 1200 && clientWidth > 768) {
			sizeNum = 18;
		}
		var undone_new = 0;
		if(obj.status == '1'){
			undone_new = '0';
		} else if(obj.status == '2'){
			undone_new = (Number((undone / 100).toFixed(2))) <= 0 ? '0' : (Number((undone / 100).toFixed(2))) + '亿元';
		} else if(obj.status == '3'){
			undone_new = '额度充足';
		}
		$('#js_viewCharthgt_new').highcharts({
			chart: {
				plotBackgroundColor: null,
				plotBorderWidth: null,
				plotShadow: false,
				animation: false,
				height: 210
			},
			title: {
				floating: true,
				text: '<span style="margin-left:23px;">当日额度余额</span><br><span style="font-size:' + sizeNum + 'px;">' + undone_new + '</span>',
				style: {
					fontSize: '12px',
					fontFamily: 'microsoft yahei',
					color: '#666',
					fill: '#666'
				}
			},
			tooltip: {
				formatter: function () {
					return this.key + ':' + Number((this.y / 100).toFixed(2)) + "亿元";
				},
				enabled:undone_new == 0 || undone_new == '额度充足'  ? false : true
			},
			credits: {
				enabled: false
			},
			plotOptions: {
				pie: {
					allowPointSelect: false,//点击后中间标题换成当前鼠标选中标题
					cursor: 'pointer',
					dataLabels: {
						enabled: false
					}
				}
			},
			series: [{
				type: 'pie',
				innerSize: '90%',
				animation: false,
				data: [{
					name: '已用额度',
					y: done,
					color: '#7cb5ec'
				},
				{
					name: '可用额度',
					y: undone,
					color: '#f15c80'
				}
				]
			}]
		}, function (c) {
			// 环形图圆心
			var centerY = c.series[0].center[1],
				titleHeight = parseInt(c.title.styles.fontSize);
			c.setTitle({
				y: centerY + titleHeight / 2 - 20
			});
			chart = c;
		});
	},
	//画图--成交信息
	buyC: function (obj, quickSortArr, strType) {
		var _this = this;
		var dataShadow = [],
			yMax = _this.QuickSort({
				arr: quickSortArr,
				index: quickSortArr.length - 1,
				type: strType
			});
		$(obj).highcharts({
			chart: {
				type: 'column',
				inverted: true,
				height: 220,
			},
			title: {
				text: ''
			},
			xAxis: {
				categories: [
					'买入',
					'卖出'
				],
				title: {
					text: null
				},
				labels: {
					enabled: true
				},
				tickWidth: 0,
				lineColor: '#FFFFFF'
			},
			yAxis: [{
				min: 0,
				labels: {
					enabled: false
				},
				title: {
					text: ''
				},
				gridLineWidth: 0,
				lineColor: '#FFFFFF'
			}, {
				title: {
					text: ''
				},
				labels: {
					enabled: false
				},
				opposite: false,
				gridLineWidth: 0,
				lineColor: '#FFFFFF'
			}],
			credits: {
				enabled: false
			},
			legend: {
				itemHoverStyle: "#898989",
				enabled: true,
				shadow: false,
				align: 'left',
				reversed: true,
				verticalAlign: 'top',
				height: 150,
				x: -8,
				y: -4, //图例在Y轴显示的垂直位置
				itemStyle: {
					color: '#898989',
					fontWeight: "normal",
					cursor: "pointer"
				}
			},
			tooltip: {
				formatter: function () {
					if (this.series.name.split(' ')[0] == 'Series') {
						return false;
					} else {
						return this.key + '：' + this.y + strType + '<br>' + this.series.name;
					}
				}
			},
			plotOptions: {
				column: {
					cursor: 'pointer',
					dataLabels: {
						enabled: true,
						crop: false,
						useHTML: false
					},
					grouping: false,
					shadow: false,
					borderWidth: 0,
					pointWidth: 15 //柱状图宽度
				}
			},
			series: [
				{
					name: '',
					color: 'rgba(0,0,0,0.05)',
					data: [yMax, yMax],
					dataLabels: {
						enabled: false,
						format: '{y}',
						useHTML: true
					},
					pointPadding: 0.3,
					pointPlacement: -0.32,
					animation: false
				}, {
					name: '',
					color: 'rgba(0,0,0,0.05)',
					data: [yMax, yMax],
					dataLabels: {
						enabled: false
					},
					pointPadding: 0.3,
					pointPlacement: 0.2,
					yAxis: 1,
					animation: false
				}, {
					name: '    交易日  ' + transactionData[0].TRADE_DATE,
					color: '#418dd3',
					data: [quickSortArr[0], quickSortArr[2]],
					dataLabels: {
						enabled: true
					},
					pointPadding: 0.36,
					pointPlacement: 0.2,
					yAxis: 1
				}, {
					name: '    上一日  ' + transactionData[1].TRADE_DATE,
					color: '#bee0ff',
					data: [quickSortArr[1], quickSortArr[3]],
					dataLabels: {
						enabled: true,
						format: '{y}',
					},
					pointPadding: 0.36,
					pointPlacement: -0.32
				}]
		});

		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(0).css("transform", "matrix(1, 0, 0, 1, 10, 20)");
		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(1).css("transform", "matrix(1, 0, 0, 1, 10, 45)");

		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(2).hide();
		$(obj).find(".highcharts-legend .highcharts-legend-item").eq(3).hide();
		$(obj).find(".highcharts-root").css("transform", "matrix(1, 0, 0, 1, 10, -25)");
		$(obj).css("margin-bottom", "-30px");
	},
	//数组排序取最大值返回
	QuickSort: function (obj) {
		function sortNumber(a, b) {
			return a - b;
		}
		var quickArr = obj.arr,
			index = obj.index,
			maxA = quickArr[index];

		if (obj.type == '亿元') {
			return parseFloat(maxA + 2);
		} else {
			return parseFloat(maxA + 300);
		}
	},
	//股指行情图
	getStockIndex: function () {
		var _this = this;
		var htm = '<thead><tr>';
		htm += '<th>指数名称</th>';
		htm += '<th class="text-right">最新</th>';
		htm += '<th class="text-right">涨跌</th>';
		htm += '</tr></thead><tbody>';
		var emptyTr = '<tr><td colspan="18">暂无数据</td></tr>';
		$.ajax({
			type: 'GET',
			dataType: 'jsonp',
			url: hq_queryUrl + "/v1/csip/list/self/000159_CES300",
			jsonp: 'callback',
			data: {
				select: 'code,name,last,chg_rate'
			},
			cache: false,
			success: function (res) {
				var returnArray = res.list;
				var lastTr = [];

				if (res && returnArray.length > 0) {
					for (var i = 0; i < returnArray.length; ++i) {
						var data = returnArray[i];
						var dataTime = returnArray[0].date;
						if (data[0] == "000159") {
							htm += '<tr class="' + data[0] + '"><td><img src="/xhtml/images/sse.jpg" border="0">';
						} else {
							htm += '<tr class="' + data[0] + '"><td><img src="/xhtml/images/ces.ico" border="0">';
						}
						if (parseFloat(data[3]) > 0) {
							htm += data[1] + '</td><td class="text-right"><font color="red">' + data[2].toFixed(2) + '</font></td>';
							htm += '<td class="text-right"><font color="red">' + data[3].toFixed(2) + '%</font></td>';
							htm += '</tr>';
						} else if (parseFloat(data.sRate) < 0) {
							htm += data[1] + '</td><td class="text-right"><font color="green">' + data[2].toFixed(2) + '</font></td>';
							htm += '<td class="text-right"><font color="green">' + data[3].toFixed(2) + '%</font></td>';
							htm += '</tr>';
						} else {
							htm += data[1] + '</td><td class="text-right">' + data[2].toFixed(2) + '</td>';
							htm += '<td class="text-right">' + data[3].toFixed(2) + '%</td>';
							htm += '</tr>';
						}
						htm += '<tr><td colspan="3" id="stockQC' + data[0] + '" class="stockTr" style="background-color:white;padding:10px 0;"><img src="/xhtml/images/ui/Highcharts-NotData.png" id="Highcharts-NotData" style="width: 90%;"></td></tr>';
						lastTr.push("stockQC" + data[0]);
					}
				} else {
					htm += emptyTr;
				}
				htm += '</tbody>';
				$(".js_stockIndex_new .table").html(htm);
				/**
				 * 折叠效果
				 */
				for (var i = 0; i < lastTr.length; i++) {
					var selector = lastTr[i];
					var trCode = selector.substring(selector.length - 6, selector.length);
					drawOnehgtZChart(trCode, selector, true, ("#" + selector));
					// 获取当前展开的索引，设置为show()
					$("#" + lastTr[i]).parent('tr').hide();
					$("#" + lastTr[0]).parent('tr').show();
				}
				$(".js_stockIndex_new .table").find('tr').click(function () {
					var _cliCode = $(this).attr('class');
					if (_cliCode == 'undefined' || _cliCode == null || _cliCode == '') {
						return
					} else {
						$(this).parent().find('.stockTr').parent('tr').hide();
						$(this).next().show();
					}
				});
			}
		});
	}
}
if ($(".js_southboundTrading_new").length > 0) {
	southboundTrading_new.init();
}
//港股通--专栏首页(新) end

/**
 * 港股通成交概况
 */

//每日成交信息
var hkexsctradingDay_New = {
	hkexsctradingDayUrl_New: sseQueryURL + 'ggt/getQuatationInfo.do?jsonCallBack=?',
	hkexsctradingDayParam_New: {
		'tradeDate': ''
	},
	init: function () {
		this.loadEvents();
	},
	loadEvents: function () {
		var _this = this;
		//日渲染
		laydate({
			elem: ".js_hkexsctradingNew_day .js_date input",
			theme: '#b50005',
			format: 'yyyy-MM-dd',
			trigger: 'click',
			btns: ['confirm'],
			done: function (value, date, endDate) {
				//选择时间触发查询
				setTimeout(function () {
					_this.searchtradingDayParams();
				}, 500);
			},
		});
		$(".js_hkexsctradingNew_day .js_date input").attr("placeholder", "查询日期");
		_this.searchtradingDayList();
	},
	searchtradingDayParams: function () {
		var _this = hkexsctradingDay_New;
		var tradeDate = $(".js_hkexsctradingNew_day .js_date input").val() ? $(".js_hkexsctradingNew_day .js_date input").val() : '';
		$('.js_hkexsctradingNew_day .title_lev3 .new_date').html('数据日期：' + tradeDate);
		_this.hkexsctradingDayParam_New.tradeDate = tradeDate.replace(/\-/g, '');
		_this.searchtradingDayList();
	},
	searchtradingDayList: function () {
		var _this = this;
		var emptyTr = '<tr><td colspan="2">暂无数据</td></tr>'
		var hkexsctradingDayHtml = '<thead><tr>';
		hkexsctradingDayHtml += '<th class="text-nowrap">当日情况</th>';
		hkexsctradingDayHtml += '<th class="text-right">成交概况</th>';
		hkexsctradingDayHtml += '</tr></thead><tbody>';
		getJSONP({
			type: 'post',
			dataType: 'jsonp',
			url: _this.hkexsctradingDayUrl_New,
			data: _this.hkexsctradingDayParam_New,
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0 && data.result[0]) {
					var v = data.result[0];
					if(_this.hkexsctradingDayParam_New.tradeDate == ''){
						$('.js_hkexsctradingNew_day .title_lev3 .new_date').html('数据日期：' + v.TRADE_DATE);
						$(".js_hkexsctradingNew_day .js_date input").val(v.TRADE_DATE);
					}
					if (v) {
						hkexsctradingDayHtml += '<tr>';
						hkexsctradingDayHtml += '<td class="text-nowrap">当日买入成交金额（亿元）</td><td class="text-right">' + (v.BUY_AMOUNT ? v.BUY_AMOUNT : '-') + '</td>';
						hkexsctradingDayHtml += '</tr>';
						hkexsctradingDayHtml += '<tr>';
						hkexsctradingDayHtml += '<td class="text-nowrap">当日买入成交笔数（万笔）</td><td class="text-right">' + (v.BUY_VOLUME ? v.BUY_VOLUME : '-') + '</td>';
						hkexsctradingDayHtml += '</tr>';
						hkexsctradingDayHtml += '<tr>';
						hkexsctradingDayHtml += '<td class="text-nowrap">当日卖出成交金额（亿元）</td><td class="text-right">' + (v.SELL_AMOUNT ? v.SELL_AMOUNT : '-') + '</td>';
						hkexsctradingDayHtml += '</tr>';
						hkexsctradingDayHtml += '<tr>';
