/**
 * 港股通标的证券名单/港股通股票调整信息-品种转义
 */

function varietiesEscape(val) {
	if(val == 'BOND'){
		return '债券';
	} else if(val == 'BWRT'){
		return '一篮子权证';
	} else if(val == 'EQTY'){
		return '股票';
	} else if(val == 'TRST'){
		return 'ETF';
	} else if(val == 'WRNT'){
		return '权证';
	}else{
		return '-';
	}
}

/**
 * 历史参考汇率/结算汇兑比率
 */
var exchangeRatio = {
	commonUrl: sseQueryURL + "commonSoaQuery.do",
	commonParam: {
		"isPagination": true,
		"updateDate": changeFormatDate(get_systemDate_global(), -30, 0, 0),
		"updateDateEnd": get_systemDate_global(),
		"sqlId": "FW_HGT_GGTHL",
		"pageHelp.cacheSize": 1,
		"pageHelp.pageSize": 25,
	},
	typeOption: [  //类型数据，value --> 接口参数 sqlId 的值
		{ name: "历史参考汇率", value: "FW_HGT_GGTHL" },
		{ name: "结算汇兑比率", value: "FW_HGT_JSHDBL" }
	],
	init: function () {
		this.loadEvents();
	},
	loadEvents: function () {
		var _this = this;
		bootstrapSelect({
			method: function () {
				//类型数据渲染
				$(".js_type .selectpicker").html(addSelectOption(_this.typeOption)).selectpicker('refresh').selectpicker('render');
				//类型初始化完成调用接口
				$(".js_type .selectpicker").on('loaded.bs.select', function (e) {
					setTimeout(function () {
						_this.setStockParam();
					}, 500)
				});
				//下拉框改变触发查询
				$(".js_type .selectpicker").on('changed.bs.select', function (e) {
					_this.setStockParam();
				});
			}
		});
		//日期范围渲染
		laydate({
			elem: ".js_dateRange input",
			theme: '#b50005',
			format: 'yyyy-MM-dd',
			min: '1990-12-19',
			value: _this.commonParam.updateDate + " - " + _this.commonParam.updateDateEnd,
			max: get_systemDate_global(),
			range: true,
			trigger: 'click',
			btns: ['confirm'],
			done: function (value, date, endDate) {
				setTimeout(function () {
					_this.setStockParam();
				}, 500)
			},
		});
	},
	setStockParam: function () {
		var dateArr = $(".js_dateRange input").val().split(" - ");
		if (new Date(dateArr[0]) > new Date(get_systemDate_global()) || new Date(dateArr[1]) > new Date(get_systemDate_global())) {
			bootstrapModal({ text: "日期不能超过当前日期" });
			return;
		}
		this.commonParam.updateDate = dateArr[0].replace(/\-/g, "");
		this.commonParam.updateDateEnd = dateArr[1].replace(/\-/g, "");
		this.commonParam.sqlId = $(".js_type .selectpicker").val();
		this.getStockList(1);
	},
	getStockList: function (pageIndex) {
		var _this = this;
		if (!paginationChange(_this.commonParam, pageIndex)) {//触发分页改变分页参数
			return
		}
		var htm = '<thead><tr>';
		$(".js_exchangeRatio .remarks").remove();
		if (_this.commonParam.sqlId == "FW_HGT_GGTHL") {  //历史参考汇率
			htm += '<th>适用日期</th><th class="text-right">参考汇率买入价</th><th class="text-right">参考汇率卖出价</th><th>货币种类</th>';
			//表格下方的注
			$(".js_exchangeRatio").append('<div class="remarks"><span>注：投资者提交港股通买入申报时，证券公司可利用参考汇率卖出价计算投资者需要预冻结的人民币资金；投资者提交港股通卖出申报时，证券公司可利用参考汇率买入价计算投资者预计得到的人民币资金。</span></div>')
		} else {  //结算汇兑比率
			htm += '<th>适用日期</th><th class="text-right">买入结算汇兑比率</th><th class="text-right">卖出结算汇兑比率</th><th>货币种类</th>';
			//表格下方的注
			$(".js_exchangeRatio").append('<div class="remarks"><span>注：日终清算时，投资者的港股通买入交易，按卖出结算汇兑比率计算出实际需要支付的人民币；投资者的港股通卖出交易，按买入结算汇兑比率计算出实际可以得到的人民币。</span></div>')
		}
		htm += '</tr></thead><tbody>';
		var emptyTr = '<tr><td colspan="18">暂无数据</td></tr>';
		getJSONP({
			url: _this.commonUrl,
			data: _this.commonParam,
			successCallback: function (data) {
				if (data && data.result && data.result.length > 0) {
					$.each(data.result, function (k, v) {
						htm += '<tr>';
						htm += '<td class="text-nowrap">' + (v.validDate ? v.validDate.substring(0, 4) + "年" + v.validDate.substring(4, 6) + "月" + v.validDate.substring(6, 8) + "日" : "") + '</td>';
						htm += '<td class="text-nowrap text-right">' + (v.buyPrice ? v.buyPrice : "-") + '</td>';
						htm += '<td class="text-nowrap text-right">' + (v.sellPrice ? v.sellPrice : "-") + '</td>';
						htm += '<td class="text-nowrap">' + v.currencyType + '</td>';
						htm += '</tr>';
					})
					//调用分页
					Page.navigation(".js_exchangeRatio .pagination-box", data.pageHelp.pageCount, data.pageHelp.total, data.pageHelp.pageNo, data.pageHelp.pageSize, "exchangeRatio.getStockList");
				} else {
					htm += emptyTr;
					$(".js_exchangeRatio .pagination-box").html("");
				}
				htm += '</tbody>';
				$(".js_exchangeRatio .table").html(htm);
			},
			errCallback: function () {
				htm += emptyTr;
				htm += '</tbody>';
				$(".js_exchangeRatio .table").html(htm);
				$(".js_exchangeRatio .pagination-box").html("");
			}
		})
	}
}
if ($(".js_exchangeRatio").length > 0) {
	exchangeRatio.init();
}
//历史参考汇率/结算汇兑比率 end



