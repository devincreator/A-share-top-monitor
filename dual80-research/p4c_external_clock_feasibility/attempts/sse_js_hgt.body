					  data.pageHelp.pageSize,
					  "stockList.newTableData"
					);
					//日期赋值
					$(".js_stockList .new_date").html("更新日期：" + data.result[0].UPDATE_DATE);
				  } else {
					stockNewTable += emptyTr;
					stockNewTable += "</tbody>";
					$(".js_stockList .table").html(stockNewTable);
					$(".js_stockList .pagination-box").html("");
				  }
				  stockNewTable += "</tbody>";
				  $(".js_stockList .table").html(stockNewTable);
			},
			errCallback: function () {
			  stockNewTable += emptyTr;
			  stockNewTable += "</tbody>";
			  $(".js_stockList .table").html(stockNewTable);
			  $(".js_stockList .pagination-box").html("");
			},
		  });
	},
	// setPeriodicParams: function () {
