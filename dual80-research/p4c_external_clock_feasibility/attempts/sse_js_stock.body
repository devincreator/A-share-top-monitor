/**
* 活跃股排名-主板活跃股排名
*/
var activityMain = {
  activityMainTypeOption: [{
    value: "TRADE_VOL_DESC",
    name: "成交量",
  },
  {
    value: "TRADE_AMT_DESC",
    name: "成交金额",
  },
  {
    value: "CHANGE_RATIO_DESC",
    name: "涨幅",
  },
  {
    value: "CHANGE_RATIO_ASC",
    name: "跌幅",
  },
  {
    value: "QJZF_DESC",
    name: "振幅",
  },
  {
    value: "TO_RATE_DESC",
    name: "换手率",
  },
  ],
  activityMainUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  activityMainParams: {
    isPagination: true,
    "pageHelp.pageSize": 20,
    "pageHelp.cacheSize": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_HYGPM_L",
    LIST_BOARD: 1,
    TRADE_VOL_DESC: 1, // 按成交量排序，参数值为1
    TRADE_DATE: '',//查询日期
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      trigger: "click",
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setActivityMainParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //会员类型数据渲染
        $(".js_activityMainType .selectpicker")
          .html(addSelectOption(_this.activityMainTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_activityMainType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setActivityMainParams();
          }
        );
      },
    });
    _this.getActivityMainList();
  },
  setActivityMainParams: function () {
    var _this = activityMain;
    _this.activityMainParams = {
      isPagination: true,
      "pageHelp.pageSize": 20,
      "pageHelp.cacheSize": 1,
      sqlId: "COMMON_SSE_SJ_GPSJ_HYGPM_L",
      LIST_BOARD: 1,
      TRADE_DATE: '',//查询日期
    };
    var activityMainType = $(".js_activityMainType .selectpicker").val() ?
      $(".js_activityMainType .selectpicker").val() :
      "";
    _this.activityMainParams[activityMainType] = 1;
    _this.activityMainParams.TRADE_DATE = $(".js_date input").val();
    _this.getActivityMainList();
  },
  getActivityMainList: function (funcname) {
    var _this = activityMain;
    var emptyTr = '<tr><td colspan="11">暂无数据</td></tr>';
    var activityMainHtml = "<thead><tr>";
    activityMainHtml += "<th>名次</th>";
    activityMainHtml += '<th class="codeNameWidth">股票代码</th>';
    activityMainHtml += '<th class="codeNameWidth">股票简称</th>';
    activityMainHtml += '<th class="text-right">开盘价</th>';
    activityMainHtml += '<th class="text-right">收盘价</th>';
    activityMainHtml += '<th class="text-right">平均价</th>';
    activityMainHtml += '<th class="text-right">累计成交量<br>(万股)</th>';
    activityMainHtml += '<th class="text-right">累计成交金额<br>(万元)</th>';
    activityMainHtml += '<th class="text-right">累计涨跌幅(%)</th>';
    activityMainHtml += '<th class="text-right">期间振幅(%)</th>';
    activityMainHtml += '<th class="text-right">累计换手率%</th>';
    activityMainHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.activityMainUrl,
      data: _this.activityMainParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $(".js_activityMain .new_date").html(
            "数据日期：" + turnDateAddLine(data.result[0].TRADE_DATE)
          );
          if (!isNull($(".js_date input").val())) {
            $(".js_date input").val(turnDateAddLine(data.result[0].TRADE_DATE));
          }
          $.each(data.result, function (k, v) {
            if (v) {
              activityMainHtml += "<tr>";
              activityMainHtml += "<td>" + v.RN + "</td>"; //名次
              activityMainHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.SEC_CODE +
                '" target="_black">' +
                v.SEC_CODE +
                "</a></td>"; //股票代码
              activityMainHtml +=
                '<td class="codeNameWidth"><span>' + v.SEC_NAME + "<span></td>"; //股票简称
              activityMainHtml +=
                '<td class="text-right">' + v.OPEN_PRICE + "</td>"; //开盘价
              activityMainHtml +=
                '<td class="text-right">' + v.CLOSE_PRICE + "</td>"; //收盘价
              activityMainHtml +=
                '<td class="text-right">' + v.AVG_PRICE + "</td>"; //平均价
              activityMainHtml +=
                '<td class="text-right">' + v.TRADE_VOL + "</td>"; //累计成交量
              activityMainHtml +=
                '<td class="text-right">' + v.TRADE_AMT + "</td>"; //累计成交金额
              activityMainHtml +=
                '<td class="text-right">' + v.CHANGE_RATIO + "</td>"; //累计涨跌幅
              activityMainHtml += '<td class="text-right">' + v.QJZF + "</td>"; //期间振幅
              activityMainHtml +=
                '<td class="text-right">' + v.TO_RATE + "</td>"; //累计换手率
              activityMainHtml += "</tr>";
            }
          });
          activityMainHtml += "</tbody>";
          $(".js_activityMain .table").html(activityMainHtml);
        } else {
          activityMainHtml += emptyTr;
          activityMainHtml += "</tbody>";
          $(".js_activityMain .table").html(activityMainHtml);
          $(".js_activityMain .new_date").html(
            "数据日期：" + $(".js_date input").val()
          );
        }
      },
      errCallback: function () {
        activityMainHtml += emptyTr;
        activityMainHtml += "</tbody>";
        $(".js_activityMain .table").html(activityMainHtml);
        $(".js_activityMain .new_date").html(
          "数据日期：" + $(".js_date input").val()
        );
      },
    });
  },
};
if ($(".js_activityMain").length > 0) {
  activityMain.init();
}
