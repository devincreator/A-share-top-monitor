            "截止日期：" + turnDateAddLine(data.result[0].TRADE_DATE) + ""
          );
        } else {
          structureOverviewFXHtml += emptyTr;
          structureOverviewFXHtml += "</tbody>";
          $(".js_structureOverviewFX .table").html(structureOverviewFXHtml);
        }
      },
      errCallback: function () {
        structureOverviewFXHtml += emptyTr;
        structureOverviewFXHtml += "</tbody>";
        $(".js_structureOverviewFX .table").html(structureOverviewFXHtml);
      },
    });
  },
};
if ($(".js_structureOverviewFX").length > 0) {
  structureOverviewFX.init();
}
