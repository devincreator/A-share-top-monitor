var structureOverviewFX = {
  init: function () {
    this.loadEvents();
  },
  structureOverviewFXListURL: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  structureOverviewFXListParams: {
    isPagination: true,
    "pageHelp.pageSize": 5,
    "pageHelp.cacheSize": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_GBJG_L",
    ISSUE_VOL: 1,
    TOP_TEN: 1,
  },
  loadEvents: function () {
