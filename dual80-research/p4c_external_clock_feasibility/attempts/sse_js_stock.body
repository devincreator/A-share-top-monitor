/**
* 新股首日表现
*/
var firstday = {
  todayDate: get_systemDate_global(),
  firstdayUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  firstdayParams: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_SRBX_L",
    COMPANY_CODE: "",
    START_DATE: "",
    END_DATE: "",
    ISSUE_TYPE0: 1,
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期范围
    laydate({
      elem: ".js_dateRange input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      range: true,
      min: "1990-12-19",
      max: get_systemDate_global(),
      trigger: "click",
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setfirstdayParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setfirstdayParams);
    //初始加载
    _this.firstdayParams.START_DATE = _this.todayDate.substr(0, 4) + "-01-01";
    _this.firstdayParams.END_DATE = _this.todayDate;
    $(".js_firstday .title_lev2 .new_date").html(
      "查询日期：" +
      _this.firstdayParams.START_DATE +
      "至" +
      _this.firstdayParams.END_DATE
    );
    _this.getFirstDayList(1);
  },
  setfirstdayParams: function () {
    var _this = firstday;
    var inputCode = $("#inputCode").val() ? $("#inputCode").val() : ""; //证券代码
    var res = (reg = /^\d{6}$/);
    if (inputCode && !res.test(inputCode)) {
      bootstrapModal({
        text: "证券代码必须为6位数字",
      });
      return;
    }
    _this.firstdayParams.COMPANY_CODE = inputCode; //证券代码
    var timeStr = $(".js_dateRange input").val();
    var beginDate = timeStr ? timeStr.substr(0, 10) : ""; //开始日期
    var endDate = timeStr ? timeStr.substr(-10) : ""; //结束日期
    if (inputCode == "" && beginDate == "") {
      bootstrapModal({
        text: "请输入查询条件",
      });
      return;
    }
    if (timeStr != "") {
      $(".js_firstday .title_lev2 .new_date").html(
        "查询日期：" + beginDate + "至" + endDate
      );
    } else {
      $(".js_firstday .title_lev2 .new_date").html(
        "查询日期："
      );
    }

    _this.firstdayParams.START_DATE = beginDate;
    _this.firstdayParams.END_DATE = endDate;
    if (
      _this.firstdayParams.START_DATE ||
      _this.firstdayParams.END_DATE ||
      _this.firstdayParams.COMPANY_CODE
    )
      _this.firstdayParams.DEFAULT_CONDITION = undefined;
    _this.getFirstDayList(1);
  },
  getFirstDayList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.firstdayParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="10">暂无数据</td></tr>';
    var firstdayHtml = "<thead><tr>";
    firstdayHtml += '<th class="text-nowrap">公司代码</th>';
    firstdayHtml += '<th class="text-nowrap">公司名称</th>';
    firstdayHtml += '<th class="text-nowrap">日期</th>';
    firstdayHtml += '<th class="text-right">开盘价</th>';
    firstdayHtml += '<th class="text-right">最高价</th>';
    firstdayHtml += '<th class="text-right">最低价</th>';
    firstdayHtml += '<th class="text-right">收盘价</th>';
    firstdayHtml += '<th class="text-right">成交量(万股/万份)</th>';
    firstdayHtml += '<th class="text-right">成交额(万元)</th>';
    firstdayHtml += '<th class="text-right">日换手率</th>';
    firstdayHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.firstdayUrl,
      data: _this.firstdayParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            firstdayHtml += "<tr>";
            firstdayHtml +=
              '<td class="text-nowrap"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
              v.COMPANY_CODE +
              '" target="_black">' +
              v.COMPANY_CODE +
              "</a></td>"; //公司代码
            firstdayHtml += '<td class="text-nowrap">' + v.FULL_NAME + "</td>"; //公司名称
            firstdayHtml +=
              '<td class="text-nowrap">' +
              turnDateAddLine(v.TRADE_DATE) +
              "</td>"; //日期
            firstdayHtml += '<td class="text-right">' + v.OPEN_PRICE + "</td>"; //开盘价
            firstdayHtml += '<td class="text-right">' + v.HIGH_PRICE + "</td>"; //最高价
            firstdayHtml += '<td class="text-right">' + v.LOW_PRICE + "</td>"; //最低价
            firstdayHtml += '<td class="text-right">' + v.CLOSE_PRICE + "</td>"; //收盘价
            firstdayHtml += '<td class="text-right">' + v.TRADE_VOL + "</td>"; //成交量
            firstdayHtml += '<td class="text-right">' + v.TRADE_AMT + "</td>"; //成交额
            firstdayHtml +=
              '<td class="text-right">' +
              (v.TO_RATE ? _this.toFixedEx(v.TO_RATE) : "-") +
              "</td>"; //日换手率
            firstdayHtml += "</tr>";
          });
          firstdayHtml += "</tbody>";
          $(".js_firstday .table").html(firstdayHtml);
          //调用分页
          Page.navigation(
            ".js_firstday .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "firstday.getFirstDayList"
          );
        } else {
          firstdayHtml += emptyTr;
          firstdayHtml += "</tbody>";
          $(".js_firstday .table").html(firstdayHtml);
          $(".js_firstday .pagination-box").html("");
        }
        //搜索代码添加cookie
        popularize.saveCpyIntoCookie(
          $("#inputCode").val().trim(),
          $("#inputCode"),
          1
        );
      },
      errCallback: function () {
        firstdayHtml += emptyTr;
        firstdayHtml += "</tbody>";
        $(".js_firstday .table").html(firstdayHtml);
        $(".js_firstday .pagination-box").html("");
      },
    });
  },
  toFixedEx: function (d) {
    d += "";
    if (d == null || d == undefined || d == "null" || "" == d || "-" == d) {
      return "-";
    } else {
      if (d.indexOf(".") == -1) {
        return d;
      } else {
        if (d.substring(d.indexOf(".")).length > 2) {
          return parseFloat(d).toFixed(2);
        } else {
          return d;
        }
      }
    }
  },
};
if ($(".js_firstday").length > 0) {
  firstday.init();
}
//新股首日表现 END

/**
* 募集资金-概况
*/
/*---------------------------------------------------------------------------*/
/**
*
* @param { Array } arr
* @param { key } key
* @param { String } field
* @returns
*/
function findExistField(arr, key, field) {
  for (var i = 0; i < arr.length; i++) {
    if (arr[i][key] == field) {
      return i;
    }
  }
  return -1;
}
/**
*
* @param { Arrat } arr
* @param { Function } cbs
*/
function publicStockList(arr, cbs) {
  var stockList = [];
  if (findExistField(arr, "SEC_TYPE", "股票") != -1) {
    var arrList = [
      "首发：公开发行",
      "首发：超额配售",
      "首发小计",
      "再发：公开增发",
      "再发：定向增发",
      "再发：配股",
      "再发：转债转股",
      "再发：优先股",
      "再发小计",
      "普通股合计",
    ];
    for (var i = 0; i < arrList.length; i++) {
      if (findExistField(arr, "RAISING_FORM", arrList[i]) == -1) {
        var obj = {
          MONTH_COM_CNT: "-",
          MONTH_ISS_AMT: "-",
          M_MAIN_COM_NUM: "-",
          M_MAIN_RAISED_AMT: "-",
          M_STAR_COM_NUM: "-",
          M_STAR_RAISED_AMT: "-",
          RAISING_FORM: "",
          SEC_TYPE: "",
          TRADE_DATE: "-",
          YEAR_COM_CNT: "-",
          YEAR_ISS_AMT: "-",
          Y_MAIN_COM_NUM: "-",
          Y_MAIN_RAISED_AMT: "-",
          Y_STAR_COM_NUM: "-",
          Y_STAR_RAISED_AMT: "-",
        };
        obj["SEC_TYPE"] = "股票";
        obj["RAISING_FORM"] = arrList[i];
        stockList.push(obj);
      } else {
        stockList.push(arr[findExistField(arr, "RAISING_FORM", arrList[i])]);
      }
    }
  }
  if (findExistField(arr, "SEC_TYPE", "债券") != -1) {
    var arrList = ["公司债", "资产支持证券", "债券合计"];
    if (new Date(turnDateAddLine(arr[0].TRADE_DATE)) > new Date('2023-10-21')) {
      arrList[0] = "公司债券（含企业债券）";
    }
    for (var i = 0; i < arrList.length; i++) {
      if (findExistField(arr, "RAISING_FORM", arrList[i]) == -1) {
        var obj = {
          MONTH_COM_CNT: "-",
          MONTH_ISS_AMT: "-",
          M_MAIN_COM_NUM: "-",
          M_MAIN_RAISED_AMT: "-",
          M_STAR_COM_NUM: "-",
          M_STAR_RAISED_AMT: "-",
          RAISING_FORM: "",
          SEC_TYPE: "",
          TRADE_DATE: "-",
          YEAR_COM_CNT: "-",
          YEAR_ISS_AMT: "-",
          Y_MAIN_COM_NUM: "-",
          Y_MAIN_RAISED_AMT: "-",
          Y_STAR_COM_NUM: "-",
          Y_STAR_RAISED_AMT: "-",
        };
        obj["SEC_TYPE"] = "债券";
        obj["RAISING_FORM"] = arrList[i];
        stockList.push(obj);
      } else {
        stockList.push(arr[findExistField(arr, "RAISING_FORM", arrList[i])]);
      }
    }
  }
  if (findExistField(arr, "SEC_TYPE", "公募REITs") != -1) {
    var arrList = ["公募REITs合计"];
    for (var i = 0; i < arrList.length; i++) {
      if (findExistField(arr, "RAISING_FORM", arrList[i]) == -1) {
        var obj = {
          MONTH_COM_CNT: "-",
          MONTH_ISS_AMT: "-",
          M_MAIN_COM_NUM: "-",
          M_MAIN_RAISED_AMT: "-",
          M_STAR_COM_NUM: "-",
          M_STAR_RAISED_AMT: "-",
          RAISING_FORM: "",
          SEC_TYPE: "",
          TRADE_DATE: "-",
          YEAR_COM_CNT: "-",
          YEAR_ISS_AMT: "-",
          Y_MAIN_COM_NUM: "-",
          Y_MAIN_RAISED_AMT: "-",
          Y_STAR_COM_NUM: "-",
          Y_STAR_RAISED_AMT: "-",
        };
        obj["SEC_TYPE"] = "公募REITs";
        obj["RAISING_FORM"] = arrList[i];
        stockList.push(obj);
      } else {
        stockList.push(arr[findExistField(arr, "RAISING_FORM", arrList[i])]);
      }
    }
  }
  setTimeout(function () {
    cbs(stockList);
  });
}
