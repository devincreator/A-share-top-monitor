var raiseOverview = {
  todayDate: get_systemDate_global(),
  raiseOverviewUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  raiseOverviewParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_MJZJ_ZJGK_C",
    SEARCH_DATE: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "month",
      format: "yyyy-MM",
      trigger: "click",
      min: "2019-07-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setRaiseOverviewParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setRaiseOverviewParams);
    //初始加载
    _this.getRaiseOverviewList();
  },
  setRaiseOverviewParams: function () {
    var _this = raiseOverview;
    var searchDate = $(".js_date input").val() ? $(".js_date input").val() : "";
    _this.raiseOverviewParams.SEARCH_DATE = searchDate; //日期
    $(".js_raiseOverview .title_lev2 .new_date").html(
      "* 截止时间：" + searchDate
    );
    _this.getRaiseOverviewList();
  },
  getRaiseOverviewList: function () {
    var _this = this;
    var emptyTr = '<tr><td colspan="20">暂无数据</td></tr>';
    var raiseOverviewHtml = "<thead>";
    raiseOverviewHtml += "<tr>";
    raiseOverviewHtml += '<th class="table_grayBg" rowspan="3">证券类型</th>';
    raiseOverviewHtml +=
      '<th class="table_grayBg" rowspan="3" colspan="2">筹、融资方式</th>';
    raiseOverviewHtml += '<th class="table_grayBg" colspan="4">公司数</th>';
    raiseOverviewHtml +=
      '<th class="table_grayBg" colspan="4">筹资金额(亿元)</th>';
    raiseOverviewHtml += "</tr>";
    raiseOverviewHtml += "<tr>";
    raiseOverviewHtml += '<th class="table_grayBg" colspan="2">本月</th>';
    raiseOverviewHtml += '<th class="table_grayBg" colspan="2">本年</th>';
    raiseOverviewHtml += '<th class="table_grayBg" colspan="2">本月</th>';
    raiseOverviewHtml += '<th class="table_grayBg" colspan="2">本年</th>';
    raiseOverviewHtml += "</tr>";
    raiseOverviewHtml += "<tr>";
    raiseOverviewHtml += '<th class="table_grayBg">主板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">科创板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">主板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">科创板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">主板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">科创板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">主板</th>';
    raiseOverviewHtml += '<th class="table_grayBg">科创板</th>';
    raiseOverviewHtml += "</tr>";
    raiseOverviewHtml += "</thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.raiseOverviewUrl,
      data: _this.raiseOverviewParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          publicStockList(data.result, function (res_arr) {
            data.result = res_arr;
            var fristDate = turnDateAddLine(data.result[0].TRADE_DATE);
            $(".js_raiseOverview .title_lev2 .new_date").html(
              "* 截止时间：" + fristDate
            );
            if (!$(".js_date input").val()) {
              //初次加载无时间，默认添加
              $(".js_date input").val(fristDate.substr(0, 7));
            }
            var resultDatas = [];
            $.each(data.result, function (k, v) {
              var resultHtml = "<tr>",
                resultData = {};
              if (v.RAISING_FORM == "首发：公开发行") {
                resultHtml +=
                  '<td class="table_borderRight" rowspan="10">股票</td><td class="table_borderRight" rowspan="3">首发</td><td>公开发行</td>';
                resultData.key = 1;
              }
              if (v.RAISING_FORM == "首发：超额配售") {
                resultHtml += "<td>超额配售</td>";
                resultData.key = 2;
              }
              if (v.RAISING_FORM == "首发小计") {
                resultHtml += '<td class="txtBlue">首发小计</td>';
                resultData.key = 3;
              }
              if (v.RAISING_FORM == "再发：公开增发") {
                resultHtml +=
                  '<td class="table_borderRight" rowspan="6">再发</td><td>公开增发</td>';
                resultData.key = 4;
              }
              if (v.RAISING_FORM == "再发：定向增发") {
                resultHtml += "<td>定向增发</td>";
                resultData.key = 5;
              }
              if (v.RAISING_FORM == "再发：配股") {
                resultHtml += "<td>配股</td>";
                resultData.key = 6;
              }
              if (v.RAISING_FORM == "再发：转债转股") {
                resultHtml += "<td>转债转股</td>";
                resultData.key = 7;
              }
              if (v.RAISING_FORM == "再发：优先股") {
                resultHtml += "<td>优先股</td>";
                resultData.key = 8;
              }
              if (v.RAISING_FORM == "再发小计") {
                resultHtml += '<td class="txtBlue">再发小计</td>';
                resultData.key = 9;
              }
              if (v.RAISING_FORM == "普通股合计") {
                resultHtml +=
                  '<td colspan="2" class="txtBlue font-weight-bold">普通股合计</td>';
                resultData.key = 10;
              }
              if (/公司债/.test(v.RAISING_FORM)) {
                resultHtml +=
                  '<td class="table_borderRight" rowspan="3">债券</td><td colspan="2">' + v.RAISING_FORM + '</td>';
                resultData.key = 11;
              }
              if (v.RAISING_FORM == "资产支持证券") {
                resultHtml += '<td colspan="2">资产支持证券</td>';
                resultData.key = 12;
              }
              if (v.RAISING_FORM == "债券合计") {
                resultHtml +=
                  '<td colspan="2" class="txtBlue font-weight-bold">债券合计</td>';
                resultData.key = 13;
              }
              if (v.RAISING_FORM == "公募REITs合计") {
                resultHtml +=
                  '<td class="table_borderRight">公募REITs</td><td colspan="2" class="txtBlue font-weight-bold">公募REITs合计</td>';
                resultData.key = 14;
              }
              if (
                v.RAISING_FORM == "首发小计" ||
                v.RAISING_FORM == "再发小计" ||
                v.RAISING_FORM == "普通股合计" ||
                v.RAISING_FORM == "债券合计" ||
                v.RAISING_FORM == "公募REITs合计" ||
                /公司债/.test(v.RAISING_FORM) ||
                v.RAISING_FORM == "资产支持证券"
              ) {
                resultHtml +=
                  '<td class="text-right' +
                  (v.RAISING_FORM == "首发小计" || v.RAISING_FORM == "再发小计" ?
                    " txtBlue" :
                    "") +
                  (v.RAISING_FORM == "普通股合计" ||
                    v.RAISING_FORM == "债券合计" ||
                    v.RAISING_FORM == "公募REITs合计" ?
                    " txtBlue font-weight-bold" :
                    "") +
                  '" colspan="2">' +
                  v.MONTH_COM_CNT +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  (v.RAISING_FORM == "首发小计" || v.RAISING_FORM == "再发小计" ?
                    " txtBlue" :
                    "") +
                  (v.RAISING_FORM == "普通股合计" ||
                    v.RAISING_FORM == "债券合计" ||
                    v.RAISING_FORM == "公募REITs合计" ?
                    " txtBlue font-weight-bold" :
                    "") +
                  '" colspan="2">' +
                  v.YEAR_COM_CNT +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  (v.RAISING_FORM == "首发小计" || v.RAISING_FORM == "再发小计" ?
                    " txtBlue" :
                    "") +
                  (v.RAISING_FORM == "普通股合计" ||
                    v.RAISING_FORM == "债券合计" ||
                    v.RAISING_FORM == "公募REITs合计" ?
                    " txtBlue font-weight-bold" :
                    "") +
                  '" colspan="2">' +
                  (v.MONTH_ISS_AMT == 0 ?
                    0 :
                    v.MONTH_ISS_AMT && v.MONTH_ISS_AMT != "-" ?
                      Number(v.MONTH_ISS_AMT).toFixed(2) :
                      "-") +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  (v.RAISING_FORM == "首发小计" || v.RAISING_FORM == "再发小计" ?
                    " txtBlue" :
                    "") +
                  (v.RAISING_FORM == "普通股合计" ||
                    v.RAISING_FORM == "债券合计" ||
                    v.RAISING_FORM == "公募REITs合计" ?
                    " txtBlue font-weight-bold" :
                    "") +
                  '" colspan="2">' +
                  (v.YEAR_ISS_AMT == 0 ?
                    0 :
                    v.YEAR_ISS_AMT && v.YEAR_ISS_AMT != "-" ?
                      Number(v.YEAR_ISS_AMT).toFixed(2) :
                      "-") +
                  "</td>";
              } else if (
                v.RAISING_FORM == "首发：公开发行" ||
                v.RAISING_FORM == "首发：超额配售" ||
                v.RAISING_FORM == "再发：公开增发" ||
                v.RAISING_FORM == "再发：定向增发" ||
                v.RAISING_FORM == "再发：配股" ||
                v.RAISING_FORM == "再发：转债转股" ||
                v.RAISING_FORM == "再发：优先股"
              ) {
                resultHtml +=
                  '<td class="text-right' + '">' + v.M_MAIN_COM_NUM + "</td>";
                resultHtml +=
                  '<td class="text-right' + '">' + v.M_STAR_COM_NUM + "</td>";
                resultHtml +=
                  '<td class="text-right' + '">' + v.Y_MAIN_COM_NUM + "</td>";
                resultHtml +=
                  '<td class="text-right' + '">' + v.Y_STAR_COM_NUM + "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  '">' +
                  v.M_MAIN_RAISED_AMT.str_toFixed(2) +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  '">' +
                  v.M_STAR_RAISED_AMT.str_toFixed(2) +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  '">' +
                  v.Y_MAIN_RAISED_AMT.str_toFixed(2) +
                  "</td>";
                resultHtml +=
                  '<td class="text-right' +
                  '">' +
                  v.Y_STAR_RAISED_AMT.str_toFixed(2) +
                  "</td>";
              }
              resultHtml += "</tr>";
              resultData.html = resultHtml;
              resultDatas.push(resultData);
            });
            // }
            resultDatas.sort(function (a, b) {
              //按key正序排序
              var c = a.key;
              var d = b.key;
              return c - d;
            });
            //结果循环
            $.each(resultDatas, function (k, v) {
