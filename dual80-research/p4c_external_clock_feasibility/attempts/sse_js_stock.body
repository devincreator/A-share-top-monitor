      isPagination: true,
      "pageHelp.pageSize": 5,
      "pageHelp.cacheSize": 1,
      sqlId: "COMMON_SSE_SJ_GPSJ_HYGPM_L",
      LIST_BOARD: 2,
      TRADE_DATE: '',//查询日期
    };
    var activityStarType = $(".js_activityStarType .selectpicker").val() ?
      $(".js_activityStarType .selectpicker").val() :
      "";
    _this.activityStarParams[activityStarType] = 1;
    _this.activityStarParams.TRADE_DATE = $(".js_date input").val();
    _this.getactivityStarList();
  },
  getactivityStarList: function (funcname) {
    var _this = activityStar;
    var emptyTr = '<tr><td colspan="11">暂无数据</td></tr>';
    var activityStarHtml = "<thead><tr>";
    activityStarHtml += "<th>名次</th>";
    activityStarHtml += '<th class="codeNameWidth">股票代码</th>';
    activityStarHtml += '<th class="codeNameWidth">股票简称</th>';
    activityStarHtml += '<th class="text-right">开盘价</th>';
    activityStarHtml += '<th class="text-right">收盘价</th>';
    activityStarHtml += '<th class="text-right">平均价</th>';
    activityStarHtml += '<th class="text-right">累计成交量<br>(万股/万份)</th>';
    activityStarHtml += '<th class="text-right">累计成交金额<br>(万元)</th>';
    activityStarHtml += '<th class="text-right">累计涨跌幅(%)</th>';
    activityStarHtml += '<th class="text-right">期间振幅(%)</th>';
    activityStarHtml += '<th class="text-right">累计换手率%</th>';
    activityStarHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.activityStarUrl,
      data: _this.activityStarParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $(".js_activityStar .new_date").html(
            "数据日期：" + turnDateAddLine(data.result[0].TRADE_DATE)
          );
          if (!isNull($(".js_date input").val())) {
            $(".js_date input").val(turnDateAddLine(data.result[0].TRADE_DATE));
          }
          $.each(data.result, function (k, v) {
            if (v) {
              activityStarHtml += "<tr>";
              activityStarHtml += "<td>" + v.RN + "</td>"; //名次
              activityStarHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.SEC_CODE +
                '" target="_black">' +
                v.SEC_CODE +
                "</a></td>"; //股票代码
              activityStarHtml +=
                '<td class="codeNameWidth"><span>' + v.SEC_NAME + "<span></td>"; //股票简称
              activityStarHtml +=
                '<td class="text-right">' + v.OPEN_PRICE + "</td>"; //开盘价
              activityStarHtml +=
                '<td class="text-right">' + v.CLOSE_PRICE + "</td>"; //收盘价
              activityStarHtml +=
                '<td class="text-right">' + v.AVG_PRICE + "</td>"; //平均价
              activityStarHtml +=
                '<td class="text-right">' + v.TRADE_VOL + "</td>"; //累计成交量
              activityStarHtml +=
                '<td class="text-right">' + v.TRADE_AMT + "</td>"; //累计成交金额
              activityStarHtml +=
                '<td class="text-right">' + v.CHANGE_RATIO + "</td>"; //累计涨跌幅
              activityStarHtml += '<td class="text-right">' + v.QJZF + "</td>"; //期间振幅
              activityStarHtml +=
                '<td class="text-right">' + v.TO_RATE + "</td>"; //累计换手率
              activityStarHtml += "</tr>";
            }
          });
          activityStarHtml += "</tbody>";
          $(".js_activityStar .table").html(activityStarHtml);
        } else {
          activityStarHtml += emptyTr;
          activityStarHtml += "</tbody>";
          $(".js_activityStar .table").html(activityStarHtml);
          $(".js_activityStar .new_date").html(
            "数据日期：" + $(".js_date input").val()
          );
        }
      },
      errCallback: function () {
        activityStarHtml += emptyTr;
        activityStarHtml += "</tbody>";
        $(".js_activityStar .table").html(activityStarHtml);
        $(".js_activityStar .new_date").html(
          "数据日期：" + $(".js_date input").val()
        );
      },
    });
  },
};
if ($(".js_activityStar").length > 0) {
  activityStar.init();
}
//活跃股排名-科创板活跃股排名 END