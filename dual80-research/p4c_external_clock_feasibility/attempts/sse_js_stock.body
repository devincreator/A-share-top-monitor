                '<td class="text-right' + '">' + v.M_MAIN_COM_NUM + "</td>";
              resultHtml +=
                '<td class="text-right' + '">' + v.M_STAR_COM_NUM + "</td>";
              resultHtml +=
                '<td class="text-right' + '">' + v.Y_MAIN_COM_NUM + "</td>";
              resultHtml +=
