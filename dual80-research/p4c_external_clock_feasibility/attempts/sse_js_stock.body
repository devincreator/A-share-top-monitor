/**
* 优先股成交统计信息
*/
var pshare = {
  pshareUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  pshareParams: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_ZQPZ_GP_YXG_L",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //初始加载
    _this.getPshareList(1);
  },
  setpshareParams: function () {
    var _this = pshare;
    _this.getPshareList(1);
  },
  getPshareList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.pshareParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="8">暂无数据</td></tr>';
    var pshareHtml = "<thead><tr>";
    pshareHtml += '<th class="text-nowrap">交易日期</th>';
    pshareHtml += '<th class="text-nowrap">证券代码</th>';
    pshareHtml += '<th class="text-nowrap">证券简称</th>';
    pshareHtml += '<th class="text-right">成交价</th>';
    pshareHtml += '<th class="text-right">成交金额（万元）</th>';
    pshareHtml += '<th class="text-right">成交量（万股）</th>';
    pshareHtml += "<th>买入营业部</th>";
    pshareHtml += "<th>卖出营业部</th>";
    pshareHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.pshareUrl,
      data: _this.pshareParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            pshareHtml += "<tr>";
            pshareHtml += '<td class="text-nowrap">' + v.TRADE_DATE + "</td>"; //交易日期
            pshareHtml +=
              '<td class="text-nowrap">' + v.SECURITY_CODE + "</td>"; //证券代码
            pshareHtml +=
              '<td class="text-nowrap"><span>' +
              v.SECURITY_ABBR +
              "</span></td>"; //证券简称
            pshareHtml +=
              '<td class="text-right">' +
              (v.PRICE && v.PRICE != "-" ? v.PRICE : "-") +
              "</td>"; //成交价
            pshareHtml +=
              '<td class="text-right">' +
              (v.AMOUNT && v.AMOUNT != "-" ? v.AMOUNT : "-") +
              "</td>"; //成交金额（万元）
            pshareHtml +=
              '<td class="text-right">' +
              (v.VOLUME && v.VOLUME != "-" ? v.VOLUME : "-") +
              "</td>"; //成交量（手）
            pshareHtml += '<td class="text-nowrap">' + v.BUYER + "</td>"; //买入营业部
            pshareHtml += '<td class="text-nowrap">' + v.SELLER + "</td>"; //卖出营业部
            pshareHtml += "</tr>";
          });
          pshareHtml += "</tbody>";
          $(".js_pshare .table").html(pshareHtml);
          //调用分页
          Page.navigation(
            ".js_pshare .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "pshare.getPshareList"
          );
        } else {
          pshareHtml += emptyTr;
          pshareHtml += "</tbody>";
          $(".js_pshare .table").html(pshareHtml);
          $(".js_pshare .pagination-box").html("");
        }
      },
      errCallback: function () {
        pshareHtml += emptyTr;
        pshareHtml += "</tbody>";
        $(".js_pshare .table").html(pshareHtml);
        $(".js_pshare .pagination-box").html("");
      },
    });
  },
};
if ($(".js_pshare").length > 0) {
  pshare.init();
}
