/**
* 上海市场A股市盈率
*/
var priceSh = {
  priceShUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  priceShParams: {
    sqlId: "COMMON_SYL_BKPE_LIST_L",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    _this.getPriceShList();
  },
  getPriceShList: function () {
    var _this = this;
    var emptyTr = '<tr><td colspan="9">暂无数据</td></tr>';
    var priceShHtml = "<thead>";
    priceShHtml += "<tr>";
    priceShHtml +=
      '<th class="table_grayBg text-center" rowspan="2">行业分类名称</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center" colspan="2">上证A股</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center" colspan="2">上证180成分股</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center" colspan="2">上证380成分股</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center" colspan="2">其他A股</th>';
    priceShHtml += "</tr>";
    priceShHtml += "<tr>";
    priceShHtml +=
      '<th class="table_grayBg text-center">股票数<br>(亏损数)</th>';
    priceShHtml += '<th class="table_grayBg text-center">静态市盈率</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center">股票数<br>(亏损数)</th>';
    priceShHtml += '<th class="table_grayBg text-center">静态市盈率</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center">股票数<br>(亏损数)</th>';
    priceShHtml += '<th class="table_grayBg text-center">静态市盈率</th>';
    priceShHtml +=
      '<th class="table_grayBg text-center">股票数<br>(亏损数)</th>';
    priceShHtml += '<th class="table_grayBg text-center">静态市盈率</th>';
    priceShHtml += "</tr>";
    priceShHtml += "</thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.priceShUrl,
      data: _this.priceShParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $(".system_date").html("数据截止日期：" + data.result[0].FILEDATE);
          $.each(data.result, function (k, v) {
            priceShHtml += "<tr>";
            priceShHtml +=
              '<td class="text-nowrap text-left"><a target="_blank"' +
              (k == data.result.length - 1 ?
                "" :
                ' href="/market/stockdata/price/sh/index_detail.shtml?type=' +
                v.INDCODE +
                "&abbName=" +
                v.MAIORNAME +
                '"') +
              ">" +
              v.MAIORNAME +
              "</a></td>";
            priceShHtml +=
              '<td class="text-right">' +
              v.COMCNTALL +
              (v.COMCNTALLBAD && v.COMCNTALLBAD != "-" ?
                "(" + v.COMCNTALLBAD + ")" :
                "") +
              "</td>";
            priceShHtml += '<td class="text-right">' + v.PEALL + "</td>";
            priceShHtml +=
              '<td class="text-right">' +
              v.COMCNT180 +
              (v.COMCNT180BAD && v.COMCNT180BAD != "-" ?
                "(" + v.COMCNT180BAD + ")" :
                "") +
              "</td>";
            priceShHtml += '<td class="text-right">' + v.PE180 + "</td>";
            priceShHtml +=
              '<td class="text-right">' +
              v.COMCNT380 +
              (v.COMCNT380BAD && v.COMCNT380BAD != "-" ?
                "(" + v.COMCNT380BAD + ")" :
                "") +
              "</td>";
            priceShHtml += '<td class="text-right">' + v.PE380 + "</td>";
            priceShHtml +=
              '<td class="text-right">' +
              v.COMCNTOTHER +
              (v.COMCNTOTHERBAD && v.COMCNTOTHERBAD != "-" ?
                "(" + v.COMCNTOTHERBAD + ")" :
                "") +
              "</td>";
            priceShHtml += '<td class="text-right">' + v.PEOTHER + "</td>";
            priceShHtml += "</tr>";
          });
          priceShHtml += "</tbody>";
          $(".js_priceSh .table").html(priceShHtml);
        } else {
          priceShHtml += emptyTr;
          priceShHtml += "</tbody>";
          $(".js_priceSh .table").html(priceShHtml);
        }
      },
      errCallback: function () {
        priceShHtml += emptyTr;
        priceShHtml += "</tbody>";
        $(".js_priceSh .table").html(priceShHtml);
      },
    });
  },
};
if ($(".js_priceSh").length > 0) {
  priceSh.init();
}
//上海市场A股市盈率 END

/**
* 上海市场A股市盈率详情
*/
var priceShDetail = {
  priceShDetailUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  priceShDetailParams: {
    sqlId: "COMMON_SYL_GPMX_LIST_L",
    indCode: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    var indCode = getWindowHref().type,
      abbName = getWindowHref().abbName;
    if (indCode) {
      _this.priceShDetailParams.indCode = indCode;
      _this.getPriceShDetailList();
    }
    if (abbName) {
      $(".js_priceShDetail .title_lev3").html(
        decodeURI($.trim(abbName)) + " 行业股票列表"
      );
    }
  },
  getPriceShDetailList: function () {
    var _this = this;
    var emptyTr = '<tr><td colspan="4">暂无数据</td></tr>';
    var priceShDetailHtml = "<thead><tr>";
    priceShDetailHtml += '<th class="text-center">股票代码</th>';
    priceShDetailHtml += '<th class="text-center">股票简称</th>';
    priceShDetailHtml += '<th class="text-center">上证180成份股</th>';
    priceShDetailHtml += '<th class="text-center">上证380成份股</th>';
    priceShDetailHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.priceShDetailUrl,
      data: _this.priceShDetailParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            priceShDetailHtml += "<tr>";
            priceShDetailHtml +=
              '<td class="text-center text-nowrap">' + v.SECURITYCODE + "</td>";
            priceShDetailHtml +=
              '<td class="text-center text-nowrap">' + v.SECURITYABBR + "</td>";
            priceShDetailHtml += '<td class="text-center">' + v.IS180 + "</td>";
            priceShDetailHtml += '<td class="text-center">' + v.IS380 + "</td>";
            priceShDetailHtml += "</tr>";
          });
          priceShDetailHtml += "</tbody>";
          $(".js_priceShDetail .table").html(priceShDetailHtml);
        } else {
          priceShDetailHtml += emptyTr;
          priceShDetailHtml += "</tbody>";
          $(".js_priceShDetail .table").html(priceShDetailHtml);
        }
      },
      errCallback: function () {
        priceShDetailHtml += emptyTr;
        priceShDetailHtml += "</tbody>";
        $(".js_priceShDetail .table").html(priceShDetailHtml);
      },
    });
  },
};
if ($(".js_priceShDetail").length > 0) {
  priceShDetail.init();
