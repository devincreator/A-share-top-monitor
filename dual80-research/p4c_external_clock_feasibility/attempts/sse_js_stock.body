/**
* 市值排名-主板市值排名
*/
var marketvalueMain = {
  todayDate: get_systemDate_global(),
  marketvalueMainUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?", // 股票市价总值 && 股票流通市值
  marketvalueMainParams: {
    isPagination: true,
    sqlId: "COMMON_SSE_SJ_SZPM_L",
    LIST_BOARD: 1,
    SEARCH_DATE: "",
    TOTAL_VALUE_DESC: 1, // 市价总值;'NEGO_VALUE_DESC': 流通市值
  },
  marketvalueMainTypeOption: [{
    value: "1",
    name: "股票市价总值",
  },
  {
    value: "2",
    name: "股票流通市值",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //类型数据渲染
        $(".js_marketvalueMainType .selectpicker")
          .html(addSelectOption(_this.marketvalueMainTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_marketvalueMainType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setMarketvalueMainParams();
          }
        );
      },
    });
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      trigger: "click",
      min: "1990-12-19",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setMarketvalueMainParams();
        }, 500);
      },
    });

    $(".js_date input").attr("placeholder", "请选择日期");
    _this.getMarketvalueMainList();
  },
  setMarketvalueMainParams: function () {
    var _this = marketvalueMain;
    var marketvalueMainType = $(".js_marketvalueMainType .selectpicker").val() ?
      $(".js_marketvalueMainType .selectpicker").val() :
      "";
    var searchDate = $(".js_date input").val() ? $(".js_date input").val() : "";
    _this.marketvalueMainParams.SEARCH_DATE = searchDate;
    if (marketvalueMainType == "2") {
      _this.marketvalueMainParams.TOTAL_VALUE_DESC = undefined;
      _this.marketvalueMainParams.NEGO_VALUE_DESC = 1;
    } else {
      _this.marketvalueMainParams.TOTAL_VALUE_DESC = 1;
      _this.marketvalueMainParams.NEGO_VALUE_DESC = undefined;
    }

    _this.getMarketvalueMainList();
  },
  getMarketvalueMainList: function () {
    var _this = this,
      url = _this.marketvalueMainUrl;
    var marketvalueMainType = $(".js_marketvalueMainType .selectpicker").val() ?
      $(".js_marketvalueMainType .selectpicker").val() :
      "";
    var emptyTr = '<tr><td colspan="5">暂无数据</td></tr>';
    var marketvalueMainHtml = "<thead><tr>";
    marketvalueMainHtml += "<th>名次</th>";
    marketvalueMainHtml += '<th class="codeNameWidth">股票代码</th>';
    marketvalueMainHtml += '<th class="codeNameWidth">股票简称</th>';
    if (marketvalueMainType == "2") {
      marketvalueMainHtml += '<th class="text-right">流通市值(万元)</th>';
      marketvalueMainHtml +=
        '<th class="text-right">所占流通市值的比例(%)</th>';
    } else {
      marketvalueMainHtml += '<th class="text-right">市价总值(万元)</th>';
      marketvalueMainHtml += '<th class="text-right">所占总市值的比例(%)</th>';
    }
    marketvalueMainHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: url,
      data: _this.marketvalueMainParams,
      successCallback: function (data) {
        var totalPer = 0; // 比例总计
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            marketvalueMainHtml += "<tr>";
            marketvalueMainHtml += "<td>" + v.RN + "</td>"; // 名次
            marketvalueMainHtml +=
              '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
              v.SEC_CODE +
              "&FULLNAME=" +
              v.SEC_NAME +
              '" target="_blank">' +
              v.SEC_CODE +
              "</a></td>"; //股票代码
            marketvalueMainHtml +=
              '<td class="codeNameWidth"><span>' + v.SEC_NAME + "</span></td>"; // 股票简称
            if (marketvalueMainType == "2") {
              marketvalueMainHtml +=
                '<td class="text-right">' + v.NEGO_VALUE + "</td>"; //流通市值(万元)
              marketvalueMainHtml +=
                '<td class="text-right">' + v.NEGO_VALUE_RATIO + "</td>"; // 所占流通市值的比例(%)
            } else {
              marketvalueMainHtml +=
                '<td class="text-right">' + v.TOTAL_VALUE + "</td>"; //市价总值(万元)
              marketvalueMainHtml +=
                '<td class="text-right">' + v.TOTAL_VALUE_RATIO + "</td>"; // 所占总市值的比例(%)
            }
            marketvalueMainHtml += "</tr>";
          });
          marketvalueMainHtml += "</tbody>";
          $(".js_marketvalueMain .table").html(marketvalueMainHtml);

          if (marketvalueMainType == "2") {
            $(".js_marketvalueMain .title_lev2").html(
              '股票流通市值排名前十名<span class="new_date">数据更新日期：' +
              turnDateAddLine(data.result[0].TRADE_DATE) +
              "</span>"
            );
            totalPer = data.result[0].NEGO_VALUE_PER;
          } else {
            $(".js_marketvalueMain .title_lev2").html(
              '股票市价总值排名前十名<span class="new_date">数据更新日期：' +
              turnDateAddLine(data.result[0].TRADE_DATE) +
              "</span>"
            );
            totalPer = data.result[0].TOTAL_VALUE_PER;
          }
          if (!$(".js_date input").val()) {
            $(".js_date input").val(turnDateAddLine(data.result[0].TRADE_DATE));
          }
        } else {
          marketvalueMainHtml += emptyTr;
          marketvalueMainHtml += "</tbody>";
          $(".js_marketvalueMain .table").html(marketvalueMainHtml);
          var emtDataDate = $(".js_date input").val();
          if (marketvalueMainType == "2") {
            $(".js_marketvalueMain .title_lev2").html(
              '股票流通市值排名前十名<span class="new_date">数据更新日期：' +
              emtDataDate +
              "</span>"
            );
          } else {
            $(".js_marketvalueMain .title_lev2").html(
              '股票市价总值排名前十名<span class="new_date">数据更新日期：' +
              emtDataDate +
              "</span>"
            );
          }
        }
      },
      errCallback: function () {
        marketvalueMainHtml += emptyTr;
        marketvalueMainHtml += "</tbody>";
        $(".js_marketvalueMain .table").html(marketvalueMainHtml);
      },
    });
  },
};
if ($(".js_marketvalueMain").length > 0) {
  marketvalueMain.init();
}
