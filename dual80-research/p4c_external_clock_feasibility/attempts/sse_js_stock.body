//募集资金-概况 END

//募集资金公用保留小数的方法
var fixedNum = {
  tofixedNum: function (val, n) {
    var ps = String(val).split(".");
    if (ps.length == 1) {
      return val;
    } else {
      if (ps[1].length < 2) {
        return val;
      }
    }
    var num = Number(val);
    if (num == 0) {
      return num;
    }
    return num.toFixed(n);
  },
};

/**
* 首发募集资金情况
*/
var raiseIpo = {
  todayDate: get_systemDate_global(),
  raiseIpoUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  raiseIpoAShareAndStarParams: {
    //主板A和科创板
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_MJZJ_SF_ZBA_L",
    SEARCH_YEAR: "",
    LIST_BOARD: "1",
    SEC_CODE_ASC: "",
    SEC_CODE_DESC: 1,
    ISS_DATE_ASC: "",
    ISS_DATE_DESC: "",
    LIST_DATE_ASC: "",
    LIST_DATE_DESC: "",
  },
  raiseIpoBShareParams: {
    //主板B
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    type: "inParams",
    sqlId: "COMMON_SSE_GP_SJTJ_MJZJ_SF_BGSF_ZQDM_L_NEW_ASC",
    searchyear: "",
  },
  raiseIpoTypeOption: [{
    value: "1",
    name: "主板A",
  },
  {
    value: "2",
    name: "主板B",
  },
  {
    value: "3",
    name: "科创板",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "year",
      format: "yyyy",
      trigger: "click",
      min: "1991-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setRaiseIpoParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //会员类型数据渲染
        $(".js_raiseIpoType .selectpicker")
          .html(addSelectOption(_this.raiseIpoTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_raiseIpoType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setRaiseIpoParams();
          }
        );
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setRaiseIpoParams);

    //初始加载
    $(".js_date input").val(_this.todayDate.substr(0, 4));
    _this.raiseIpoAShareAndStarParams.SEARCH_YEAR = _this.todayDate.substr(
      0,
      4
    );
    $(".js_raiseIpo .title_lev2 .new_date").html(
      "数据日期：" + _this.todayDate.substr(0, 4) + "年"
    );
    $(".js_raiseIpo .title_lev2 .new_date").hide();
    _this.raiseIpoAShareAndStarParams.LIST_BOARD = "1";
    _this.raiseIpoAShareAndStarParams.SEC_CODE_DESC = 1;
    _this.getRaiseIpoAShareAndStarList(1);

    //排序事件
    $(".js_raiseIpo").on("click", ".js_orderBtn", function () {
      _this.raiseIpoAShareAndStarParams.SEC_CODE_ASC = null;
      _this.raiseIpoAShareAndStarParams.SEC_CODE_DESC = null;
      _this.raiseIpoAShareAndStarParams.ISS_DATE_ASC = null;
      _this.raiseIpoAShareAndStarParams.ISS_DATE_DESC = null;
      _this.raiseIpoAShareAndStarParams.LIST_DATE_ASC = null;
      _this.raiseIpoAShareAndStarParams.LIST_DATE_DESC = null;
      var sort = $(this).attr("data-order").split(",")[0],
        order = $(this).attr("data-order").split(",")[1];
      if ((order == "00" || order == "10") && sort == "SEC_CODE") {
        _this.raiseIpoAShareAndStarParams.SEC_CODE_DESC = 1; //原无排序/正序 现倒序
      }
      if ((order == "00" || order == "10") && sort == "ISS_DATE") {
        _this.raiseIpoAShareAndStarParams.ISS_DATE_DESC = 1; //原无排序/正序 现倒序
      }
      if ((order == "00" || order == "10") && sort == "LIST_DATE") {
        _this.raiseIpoAShareAndStarParams.LIST_DATE_DESC = 1; //原无排序/正序 现倒序
      }
      if (order == "01" && sort == "SEC_CODE") {
        _this.raiseIpoAShareAndStarParams.SEC_CODE_ASC = 1; //原倒序现正序
      }
      if (order == "01" && sort == "ISS_DATE") {
        _this.raiseIpoAShareAndStarParams.ISS_DATE_ASC = 1; //原倒序现正序
      }
      if (order == "01" && sort == "LIST_DATE") {
        _this.raiseIpoAShareAndStarParams.LIST_DATE_ASC = 1; //原倒序现正序
      }
      _this.setRaiseIpoParams(true);
    });
  },
  setRaiseIpoParams: function (isSort) {
    var _this = raiseIpo;
    if (!isSort) {
      _this.raiseIpoAShareAndStarParams.SEC_CODE_ASC = "";
      _this.raiseIpoAShareAndStarParams.SEC_CODE_DESC = 1;
      _this.raiseIpoAShareAndStarParams.ISS_DATE_ASC = "";
      _this.raiseIpoAShareAndStarParams.ISS_DATE_DESC = "";
      _this.raiseIpoAShareAndStarParams.LIST_DATE_ASC = "";
      _this.raiseIpoAShareAndStarParams.LIST_DATE_DESC = "";
    }
    var raiseIpoType = $(".js_raiseIpoType .selectpicker").val() ?
      $(".js_raiseIpoType .selectpicker").val() :
      "";
    var searchYear = $(".js_date input").val() ? $(".js_date input").val() : ""; //日期
    $(".js_raiseIpo .title_lev2 .new_date").html(
      "数据日期：" + searchYear + "年"
    );
    $(".js_raiseIpo .title_lev2 .new_date").hide();
    if (raiseIpoType == "1") {
      //主板A
      _this.raiseIpoAShareAndStarParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseIpoAShareAndStarParams.LIST_BOARD = "1";
      _this.getRaiseIpoAShareAndStarList(1);
    }
    if (raiseIpoType == "2") {
      //主板B
      _this.raiseIpoBShareParams.searchyear = searchYear;
      _this.getRaiseIpoBShareList(1);
    }
    if (raiseIpoType == "3") {
      //科创板
      _this.raiseIpoAShareAndStarParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseIpoAShareAndStarParams.LIST_BOARD = "2";
      _this.getRaiseIpoAShareAndStarList(1);
    }
  },
  getRaiseIpoAShareAndStarList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.raiseIpoAShareAndStarParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="11">暂无数据</td></tr>';
    var raiseIpoHtml = "<thead><tr>";

    raiseIpoHtml +=
      '<th class="js_orderBtn codeNameWidth " data-order="SEC_CODE,' +
      (_this.raiseIpoAShareAndStarParams.SEC_CODE_ASC == 1 ? "1" : "0") +
      (_this.raiseIpoAShareAndStarParams.SEC_CODE_DESC == 1 ? "1" : "0") +
      '">证券代码<span class="sort_btn"><em class="caret_up  ' +
      (_this.raiseIpoAShareAndStarParams.SEC_CODE_ASC == 1 ? "fill" : "") +
      '"></em><em class="caret_down ' +
      (_this.raiseIpoAShareAndStarParams.SEC_CODE_DESC == 1 ? "fill" : "") +
      '"></em></span></th>';
    raiseIpoHtml += '<th class="codeNameWidth">证券简称</th>';
    raiseIpoHtml +=
      '<th class="js_orderBtn text-nowrap " data-order="ISS_DATE,' +
      (_this.raiseIpoAShareAndStarParams.ISS_DATE_ASC == 1 ? "1" : "0") +
      (_this.raiseIpoAShareAndStarParams.ISS_DATE_DESC == 1 ? "1" : "0") +
      '">发行日期<span class="sort_btn"><em class="caret_up ' +
      (_this.raiseIpoAShareAndStarParams.ISS_DATE_ASC == 1 ? "fill" : "") +
      '"></em><em class="caret_down ' +
      (_this.raiseIpoAShareAndStarParams.ISS_DATE_DESC == 1 ? "fill" : "") +
      '"></em></span></th>';

    if (_this.raiseIpoAShareAndStarParams.LIST_BOARD == "1") {
      raiseIpoHtml += '<th class="text-right">发行股数(万股)</th>';
    } else {
      raiseIpoHtml += '<th class="text-right">发行股数(万股/万份)</th>';
    }

    raiseIpoHtml += '<th class="text-right">发行价格</th>';
    raiseIpoHtml += '<th class="text-right">筹资金额(万元)</th>';
    raiseIpoHtml += '<th class="text-right">发行市盈率</th>';
    raiseIpoHtml += "<th>发行方式</th>";
    raiseIpoHtml +=
      '<th class="js_orderBtn text-nowrap " data-order="LIST_DATE,' +
      (_this.raiseIpoAShareAndStarParams.LIST_DATE_ASC == 1 ? "1" : "0") +
      (_this.raiseIpoAShareAndStarParams.LIST_DATE_DESC == 1 ? "1" : "0") +
      '">上市日<span class="sort_btn"><em class="caret_up ' +
      (_this.raiseIpoAShareAndStarParams.LIST_DATE_ASC == 1 ? "fill" : "") +
      '"></em><em class="caret_down ' +
      (_this.raiseIpoAShareAndStarParams.LIST_DATE_DESC == 1 ? "fill" : "") +
      '"></em></span></th>';
    raiseIpoHtml += "</tr></thead><tbody>";
    //更改栏目-1.2.5.募集资金-首发主板A、科创板（符合预期)-2021-11-29
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.raiseIpoUrl,
      data: _this.raiseIpoAShareAndStarParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            raiseIpoHtml += "<tr>";
            raiseIpoHtml +=
              '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
              v.COMPANY_CODE +
              '" target="_blank">' +
              v.SEC_CODE +
              "</a></td>"; //代码
            raiseIpoHtml +=
              '<td class="codeNameWidth"><span>' +
              v.COMPANY_ABBR +
              "</span></td>"; //简称
            raiseIpoHtml +=
              '<td class="text-nowrap"><span>' +
              turnDateAddLine(v.ISS_DATE) +
              "</span></td>"; //发行日期
            raiseIpoHtml +=
              '<td class="text-right">' +
              newFormatDecimal(formatDecimal(v.ISS_VOL, 2)) +
              "</td>"; //发行股数
            raiseIpoHtml +=
              '<td class="text-right">' +
              newFormatDecimal(formatDecimal(v.ISS_PRICE, 2)) +
              "</td>"; //发行价格
            raiseIpoHtml +=
              '<td class="text-right">' +
              newFormatDecimal(formatDecimal(v.RAISE_CAP, 2)) +
              "</td>"; //筹资金额
            raiseIpoHtml += '<td class="text-right">' + v.ISS_PE + "</td>"; //发行市盈率
            raiseIpoHtml +=
              '<td class="text-nowrap">' + v.ISS_TYPE_DESC + "</td>"; //发行方式
            raiseIpoHtml +=
              '<td class="text-nowrap">' +
              turnDateAddLine(v.LIST_DATE) +
              "</td>"; //上市日
            raiseIpoHtml += "</tr>";
          });
          raiseIpoHtml += "</tbody>";
          $(".js_raiseIpo .table").html(raiseIpoHtml);
          //调用分页
          Page.navigation(
            ".js_raiseIpo .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "raiseIpo.getRaiseIpoAShareAndStarList"
          );
          $(".js_raiseIpo .title_lev2 .new_date").show();
        } else {
          raiseIpoHtml += emptyTr;
          raiseIpoHtml += "</tbody>";
          $(".js_raiseIpo .table").html(raiseIpoHtml);
          $(".js_raiseIpo .pagination-box").html("");
        }
      },
      errCallback: function () {
        raiseIpoHtml += emptyTr;
        raiseIpoHtml += "</tbody>";
        $(".js_raiseIpo .table").html(raiseIpoHtml);
        $(".js_raiseIpo .pagination-box").html("");
      },
    });
  },
  getRaiseIpoBShareList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.raiseIpoBShareParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="11">暂无数据</td></tr>';
    var raiseIpoHtml = "<thead><tr>";
    raiseIpoHtml += '<th class="codeNameWidth">证券简称</th>';
    raiseIpoHtml += '<th class="text-nowrap">发行日期</th>';
    raiseIpoHtml += '<th class="text-right">发行股数(万股)</th>';
    raiseIpoHtml += '<th class="text-right">发行价格(元人民币/美元)</th>';
    raiseIpoHtml += '<th class="text-right">筹资金额(万人民币/万美元)</th>';
    raiseIpoHtml += '<th class="text-right">发行市盈率(加权法/摊薄法)</th>';
    raiseIpoHtml += '<th class="text-nowrap">发行方式</th>';
    raiseIpoHtml += '<th class="text-right">主承销商</th>';
    raiseIpoHtml += '<th class="text-nowrap">上市日</th>';
    raiseIpoHtml += '<th class="text-nowrap">发行公告</th>';
    raiseIpoHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.raiseIpoUrl,
      data: _this.raiseIpoBShareParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            raiseIpoHtml += "<tr>";
            raiseIpoHtml +=
              '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
              v.COMPANY_CODE +
              '" target="_blank">' +
              v.SECURITY_NAME_B +
              "</a></td>"; //简称
            raiseIpoHtml +=
              '<td class="text-nowrap">' +
              v.BEGIN_DATE +
              "<br>至" +
              v.END_DATE +
              "</td>"; //发行日期
            raiseIpoHtml +=
              '<td class="text-right">' + v.ISSUED_VOLUME_B + "</td>"; //发行股数
            raiseIpoHtml +=
              '<td class="text-right">' +
              (v.ISSUED_PRICE_B2 &&
                v.ISSUED_PRICE_B2 != "-" &&
                !isNaN(v.ISSUED_PRICE_B2) ?
                fixedNum.tofixedNum(v.ISSUED_PRICE_B2, 2) :
                "-") +
              "/" +
              (v.ISSUED_PRICE_B1 &&
                v.ISSUED_PRICE_B1 != "-" &&
                isNaN(v.ISSUED_PRICE_B1) ?
                fixedNum.tofixedNum(v.ISSUED_PRICE_B1) :
                "-") +
              "</td>"; //发行价格
            raiseIpoHtml +=
              '<td class="text-right">' +
              v.RAISED_MONEY_B2 +
              "/" +
              v.RAISED_MONEY_B1 +
              "</td>"; //筹资金额
            raiseIpoHtml +=
              '<td class="text-right">' +
              v.ISSUED_PROFIT_RATE_B1 +
              "/" +
              v.ISSUED_PROFIT_RATE_B2 +
              "</td>"; //发行市盈率
            raiseIpoHtml +=
              '<td class="text-nowrap">' + v.ISSUED_MODE_CODE_B + "</td>"; //发行方式
            raiseIpoHtml +=
              '<td class="text-right">' + v.MAIN_UNDERWRITER_NAME_B + "</td>"; //主承销商
            raiseIpoHtml +=
              '<td class="text-nowrap">' + v.LISTING_DATE_B + "</td>"; //上市日
            raiseIpoHtml +=
              '<td class="text-nowrap">' + v.ANNOUNCED_DATE + "</td>"; //发行公告
            raiseIpoHtml += "</tr>";
          });
          raiseIpoHtml += "</tbody>";
          $(".js_raiseIpo .table").html(raiseIpoHtml);
          //调用分页
          Page.navigation(
            ".js_raiseIpo .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "raiseIpo.getRaiseIpoBShareList"
          );
          $(".js_raiseIpo .title_lev2 .new_date").show();
        } else {
          raiseIpoHtml += emptyTr;
          raiseIpoHtml += "</tbody>";
          $(".js_raiseIpo .table").html(raiseIpoHtml);
          $(".js_raiseIpo .pagination-box").html("");
        }
      },
      errCallback: function () {
        raiseIpoHtml += emptyTr;
        raiseIpoHtml += "</tbody>";
        $(".js_raiseIpo .table").html(raiseIpoHtml);
        $(".js_raiseIpo .pagination-box").html("");
      },
    });
  },
};
if ($(".js_raiseIpo").length > 0) {
  raiseIpo.init();
}
//首发募集资金情况 END

/**
* 增发募集资金情况
*/
var raiseAdditional = {
  todayDate: get_systemDate_global(),
  raiseAdditionalUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  raiseAdditionalParams: {
    //主板B
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_MJZJ_ZF_ZBA_L", //主板A、科创板
    LIST_BOARD: "1",
  },
  raiseAdditionalTypeOption: [{
    value: "1",
    name: "主板A",
  },
  {
    value: "2",
    name: "主板B",
  },
  {
    value: "3",
    name: "科创板",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "year",
      format: "yyyy",
      trigger: "click",
      min: "1999-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setRaiseAdditionalParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //类型数据渲染
        $(".js_raiseAdditionalType .selectpicker")
          .html(addSelectOption(_this.raiseAdditionalTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_raiseAdditionalType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setRaiseAdditionalParams();
          }
        );
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setRaiseAdditionalParams);

    //初始加载
    $(".js_date input").val(_this.todayDate.substr(0, 4));
    // _this.raiseAdditionalParams.searchyear = _this.todayDate.substr(0, 4);
    _this.raiseAdditionalParams.SEARCH_YEAR = _this.todayDate.substr(0, 4);
    $(".js_raiseAdditional .title_lev2 .new_date").html(
      "数据日期：" + _this.todayDate.substr(0, 4) + "年"
    );
    $(".js_raiseAllotment .title_lev2 .new_date").hide();
    _this.getRaiseAdditionalList(1);
  },
  setRaiseAdditionalParams: function () {
    var _this = raiseAdditional;

    var raiseAdditionalType = $(".js_raiseAdditionalType .selectpicker").val() ?
      $(".js_raiseAdditionalType .selectpicker").val() :
      "";
    var searchYear = $(".js_date input").val() ? $(".js_date input").val() : ""; //日期
    $(".js_raiseAdditional .title_lev2 .new_date").html(
      "数据日期：" + searchYear + "年"
    );
    $(".js_raiseAdditional .title_lev2 .new_date").hide();
    if (raiseAdditionalType == "1") {
      //主板A
      _this.raiseAdditionalParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseAdditionalParams.sqlId = "COMMON_SSE_SJ_GPSJ_MJZJ_ZF_ZBA_L"; //类型
      _this.raiseAdditionalParams.LIST_BOARD = "1"; //标识主板、科创板，’1’为主板，’2’为科创板
      _this.raiseAdditionalParams.searchyear = undefined;
      _this.getRaiseAdditionalList(1);
    }
    if (raiseAdditionalType == "2") {
      //主板B
      _this.raiseAdditionalParams.searchyear = searchYear;
      _this.raiseAdditionalParams.sqlId = "COMMON_SSE_GP_SJTJ_MJZJ_ZF_BGZF_L";
      _this.raiseAdditionalParams.LIST_BOARD = "1"; //标识主板、科创板，’1’为主板，’2’为科创板
      _this.raiseAdditionalParams.SEARCH_YEAR = undefined;
      _this.getRaiseAdditionalList(1);
    }
    if (raiseAdditionalType == "3") {
      //科创板
      _this.raiseAdditionalParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseAdditionalParams.sqlId = "COMMON_SSE_SJ_GPSJ_MJZJ_ZF_ZBA_L"; //类型
      _this.raiseAdditionalParams.LIST_BOARD = "2"; //标识主板、科创板，’1’为主板，’2’为科创板
      _this.raiseAdditionalParams.searchyear = undefined;
      _this.getRaiseAdditionalList(1);
    }
  },
  getRaiseAdditionalList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.raiseAdditionalParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="12">暂无数据</td></tr>';
    var raiseAdditionalHtml = "<thead><tr>";
    raiseAdditionalHtml += '<th class="codeNameWidth">证券简称</th>';
    raiseAdditionalHtml += '<th class="text-nowrap">发行日期</th>';
    if (
      _this.raiseAdditionalParams.IS_STAR == "0" ||
      _this.raiseAdditionalParams.sqlId == "COMMON_SSE_GP_SJTJ_MJZJ_ZF_BGZF_L"
    ) {
      //主板A B
      raiseAdditionalHtml += '<th class="text-right">发行股数(万股)</th>';
    } else {
      raiseAdditionalHtml += '<th class="text-right">发行股数(万股/万份)</th>';
    }
    if (
      _this.raiseAdditionalParams.sqlId == "COMMON_SSE_SJ_GPSJ_MJZJ_ZF_ZBA_L"
    ) {
      //主板A 科创板
      raiseAdditionalHtml += '<th class="text-right">发行价格</th>';
      raiseAdditionalHtml += '<th class="text-right">筹资金额(万元)</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">发行方式</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">上市日</th>';
      raiseAdditionalHtml += "</tr></thead><tbody>";
    } else {
      raiseAdditionalHtml +=
        '<th class="text-right">发行价格(元人民币/美元)</th>';
      raiseAdditionalHtml +=
        '<th class="text-right">筹资金额(万人民币/万美元)</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">发行方式</th>';
      raiseAdditionalHtml += "<th>主承销商</th>";
      raiseAdditionalHtml += '<th class="text-right">中签率(%)</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">上市日</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">招股说明书</th>';
      raiseAdditionalHtml += '<th class="text-nowrap">发行公告</th>';
    }
    raiseAdditionalHtml += "</tr></thead><tbody>";
    //更改栏目-1.2.2.募集资金-增发主板A(符合预期)-2021-11-29
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.raiseAdditionalUrl,
      data: _this.raiseAdditionalParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            raiseAdditionalHtml += "<tr>";
            if (
              _this.raiseAdditionalParams.sqlId ==
              "COMMON_SSE_SJ_GPSJ_MJZJ_ZF_ZBA_L"
            ) {
              //主板A 科创板
              raiseAdditionalHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.COMPANY_CODE +
                '" target="_blank">' +
                v.COMPANY_ABBR +
                "</a></td>"; //简称
              raiseAdditionalHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.ISS_DATE) +
                "</td>"; //发行日期
              raiseAdditionalHtml +=
                '<td class="text-right text-nowrap">' +
                newFormatDecimal(formatDecimal(v.ISS_VOL, 2)) +
                "</td>"; //发行股数
              raiseAdditionalHtml +=
                '<td class="text-right text-nowrap">' +
                newFormatDecimal(formatDecimal(v.ISS_PRICE, 2)) +
                "</td>"; //发行价格
              raiseAdditionalHtml +=
                '<td class="text-right text-nowrap">' +
                newFormatDecimal(formatDecimal(v.RAISE_CAP, 2)) +
                "</td>"; //筹资金额
              raiseAdditionalHtml +=
                '<td class="text-nowrap">' + v.ISS_TYPE_DESC + "</td>"; //发行方式
              raiseAdditionalHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.LIST_DATE) +
                "</td>"; //上市日
            } else {
              raiseAdditionalHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.COMPANY_CODE +
                '" target="_blank">' +
                v.SECURITY_NAME_B +
                "</a></td>"; //简称
              raiseAdditionalHtml += '<td class="text-nowrap">-</td>'; //发行日期
              raiseAdditionalHtml +=
                '<td class="text-right">' +
                (v.ISSUED_VOLUME_B &&
                  v.ISSUED_VOLUME_B != "-" &&
                  !isNaN(v.ISSUED_VOLUME_B) ?
                  v.ISSUED_VOLUME_B :
                  "-") +
                "</td>"; //发行股数
              raiseAdditionalHtml +=
                '<td class="text-right">' +
                (v.ISSUED_PRICE_B2 &&
                  v.ISSUED_PRICE_B2 != "-" &&
                  !isNaN(v.ISSUED_PRICE_B2) ?
                  fixedNum.tofixedNum(v.ISSUED_PRICE_B2, 2) :
                  "-") +
                "/" +
                (v.ISSUED_PRICE_B1 && !isNaN(v.ISSUED_PRICE_B1) ?
                  parseFloat(v.ISSUED_PRICE_B1).toFixed(2) :
                  "-") +
                "</td>"; //发行价格
              raiseAdditionalHtml +=
                '<td class="text-right">' +
                (v.RAISED_MONEY_B2 &&
                  v.RAISED_MONEY_B2 != "-" &&
                  !isNaN(v.RAISED_MONEY_B2) ?
                  fixedNum.tofixedNum(v.RAISED_MONEY_B2, 2) :
                  "-") +
                "/" +
                (v.RAISED_MONEY_B1 && !isNaN(v.RAISED_MONEY_B1) ?
                  parseFloat(v.RAISED_MONEY_B1).toFixed(2) :
                  "-") +
                "</td>"; //筹资金额
              raiseAdditionalHtml +=
                '<td class="text-nowrap">' + v.ISSUED_MODE_CODE_B + "</td>"; //发行方式
              raiseAdditionalHtml +=
                '<td class="text-xxl-nowrap">' +
                v.MAIN_UNDERWRITER_NAME_B +
                "</td>"; //主承销商
              raiseAdditionalHtml += '<td class="text-right">-</td>'; //中签率
              raiseAdditionalHtml +=
                '<td class="text-nowrap">' + v.LISTING_DATE_B + "</td>"; //上市日
              raiseAdditionalHtml += '<td class="text-nowrap">-</td>'; //招股说明书
              raiseAdditionalHtml += '<td class="text-nowrap">-</td>'; //发行公告
            }
            raiseAdditionalHtml += "</tr>";
          });
          raiseAdditionalHtml += "</tbody>";
          $(".js_raiseAdditional .table").html(raiseAdditionalHtml);
          //调用分页
          Page.navigation(
            ".js_raiseAdditional .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "raiseAdditional.getRaiseAdditionalList"
          );
          $(".js_raiseAdditional .title_lev2 .new_date").show();
        } else {
          raiseAdditionalHtml += emptyTr;
          raiseAdditionalHtml += "</tbody>";
          $(".js_raiseAdditional .table").html(raiseAdditionalHtml);
          $(".js_raiseAdditional .pagination-box").html("");
        }
      },
      errCallback: function () {
        raiseAdditionalHtml += emptyTr;
        raiseAdditionalHtml += "</tbody>";
        $(".js_raiseAdditional .table").html(raiseAdditionalHtml);
        $(".js_raiseAdditional .pagination-box").html("");
      },
    });
  },
};
if ($(".js_raiseAdditional").length > 0) {
  raiseAdditional.init();
}
//增发募集资金情况 END

/**
* 配股募集资金情况
*/
var raiseAllotment = {
  todayDate: get_systemDate_global(),
  raiseAllotmentUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  raiseAllotmentParams: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_MJZJ_PG_ZBAKCB_L", // 主板 A & 科创板
    SEARCH_YEAR: "",
    LIST_BOARD: 1,
  },
  raiseAllotmentParamsB: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_GP_SJTJ_MJZJ_PG_BGPG_L", // 主板 B
    searchyear: "",
  },
  raiseAllotmentTypeOption: [{
    value: "1",
    name: "主板A",
  },
  {
    value: "2",
    name: "主板B",
  },
  {
    value: "3",
    name: "科创板",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "year",
      format: "yyyy",
      trigger: "click",
      min: "1997-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setRaiseAllotmentParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //类型数据渲染
        $(".js_raiseAllotmentType .selectpicker")
          .html(addSelectOption(_this.raiseAllotmentTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_raiseAllotmentType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setRaiseAllotmentParams();
          }
        );
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setRaiseAllotmentParams);

    //初始加载
    $(".js_date input").val(_this.todayDate.substr(0, 4));
    _this.raiseAllotmentParams.SEARCH_YEAR = _this.todayDate.substr(0, 4);
    _this.getRaiseAllotmentList(1);
  },
  setRaiseAllotmentParams: function () {
    var _this = raiseAllotment;

    var raiseAllotmentType = $(".js_raiseAllotmentType .selectpicker").val() ?
      $(".js_raiseAllotmentType .selectpicker").val() :
      "";
    var searchYear = $(".js_date input").val() ? $(".js_date input").val() : ""; //日期
    $(".js_raiseAllotment .title_lev2 .new_date").html(
      "数据日期：" + searchYear + "年"
    );
    if (raiseAllotmentType == "1") {
      //主板A
      _this.raiseAllotmentParams.searchyear = undefined;
      _this.raiseAllotmentParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseAllotmentParams.LIST_BOARD = 1; //类型
      _this.raiseAllotmentParams.sqlId = "COMMON_SSE_SJ_GPSJ_MJZJ_PG_ZBAKCB_L"; //主板 A & 科创板
      _this.getRaiseAllotmentList(1);
    }
    if (raiseAllotmentType == "2") {
      //主板B
      _this.raiseAllotmentParamsB.searchyear = searchYear;
      _this.raiseAllotmentParamsB.sqlId = "COMMON_SSE_GP_SJTJ_MJZJ_PG_BGPG_L";
      _this.getRaiseAllotmentList(1, true);
    }
    if (raiseAllotmentType == "3") {
      //科创板
      _this.raiseAllotmentParams.searchyear = undefined;
      _this.raiseAllotmentParams.SEARCH_YEAR = searchYear; //日期
      _this.raiseAllotmentParams.LIST_BOARD = 2; //类型
      _this.raiseAllotmentParams.sqlId = "COMMON_SSE_SJ_GPSJ_MJZJ_PG_ZBAKCB_L"; //主板 A & 科创板
      _this.getRaiseAllotmentList(1);
    }
  },
  getRaiseAllotmentList: function (pageIndex, isStockB) {
    var _this = this;
    if (!paginationChange(_this.raiseAllotmentParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="9">暂无数据</td></tr>';
    var raiseAllotmentHtml = "<thead><tr>";
    raiseAllotmentHtml += '<th class="codeNameWidth">股票简称</th>';
    if (
      isStockB == undefined &&
      _this.raiseAllotmentParams.sqlId == "COMMON_SSE_SJ_GPSJ_MJZJ_PG_ZBAKCB_L"
    ) {
      //主板A 科创板
      raiseAllotmentHtml += '<th class="text-nowrap">A股股权登记日</th>';
      raiseAllotmentHtml += '<th class="text-nowrap">A股除权交易日</th>';
      raiseAllotmentHtml += '<th class="text-right">A股配股价格</th>';
      raiseAllotmentHtml += '<th class="text-right">配股比例<br>(10：?)</th>';
    }
    if (isStockB) {
      // 主板B
      raiseAllotmentHtml += '<th class="text-nowrap">B股股权登记日</th>';
      raiseAllotmentHtml += '<th class="text-nowrap">B股除权交易日</th>';
      raiseAllotmentHtml +=
        '<th class="text-right">B股配股价格<br>(美元/汇率)</th>';
      raiseAllotmentHtml += '<th class="text-right">配股比例<br>(10：?)</th>';
      raiseAllotmentHtml += '<th class="text-nowrap">配股缴款起始日</th>';
      raiseAllotmentHtml += '<th class="text-nowrap">配股缴款截止日</th>';
    }
    if (
      _this.raiseAllotmentParams.IS_STAR == 0 ||
      _this.raiseAllotmentParamsB.sqlId == "COMMON_SSE_GP_SJTJ_MJZJ_PG_BGPG_L"
    ) {
      //主板A 主板B
      raiseAllotmentHtml += '<th class="text-right">实际配股量(万股)</th>';
    } else {
      raiseAllotmentHtml += '<th class="text-right">实际配股量(万股/万份)</th>';
    }
    raiseAllotmentHtml += '<th class="text-nowrap">配股上市日</th>';
    raiseAllotmentHtml += "</tr></thead><tbody>";
    if (isStockB) {
      // 主板B
      getJSONP({
        type: "post",
        dataType: "jsonp",
        url: _this.raiseAllotmentUrl,
        data: _this.raiseAllotmentParamsB,
        successCallback: function (data) {
          if (data && data.result && data.result.length > 0) {
            $.each(data.result, function (k, v) {
              raiseAllotmentHtml += "<tr>";
              raiseAllotmentHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.COMPANY_CODE +
                '" target="_blank">' +
                v.SECURITY_NAME_B +
                "</a></td>"; //简称
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' + v.RECORD_DATE_B + "</td>"; //A股股权登记日
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' + v.EX_RIGHTS_DATE_B + "</td>"; //A股除权交易日
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.PRICE_OF_RIGHTS_ISSUE_B &&
                  v.PRICE_OF_RIGHTS_ISSUE_B != "-" &&
                  !isNaN(v.PRICE_OF_RIGHTS_ISSUE_B) ?
                  fixedNum.tofixedNum(v.PRICE_OF_RIGHTS_ISSUE_B, 2) :
                  "-") +
                "</td>"; //A股配股价格
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.RATIO_OF_RIGHTS_ISSUE_B &&
                  v.RATIO_OF_RIGHTS_ISSUE_B != "-" &&
                  !isNaN(v.RATIO_OF_RIGHTS_ISSUE_B) ?
                  fixedNum.tofixedNum(v.RATIO_OF_RIGHTS_ISSUE_B, 2) :
                  "-") +
                "</td>"; //配股比例
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' +
                v.START_DATE_OF_REMITTANCE_B +
                "</td>"; //配股缴款起始日
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' +
                v.END_DATE_OF_REMITTANCE_B +
                "</td>"; //配股缴款截止日
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.TRUE_COLUME_B &&
                  v.TRUE_COLUME_B != "-" &&
                  !isNaN(v.TRUE_COLUME_B) ?
                  fixedNum.tofixedNum(v.TRUE_COLUME_B, 2) :
                  "-") +
                "</td>"; //实际配股量
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' + v.LISTING_DATE_B + "</td>"; //配股上市日
              raiseAllotmentHtml += "</tr>";
            });
            raiseAllotmentHtml += "</tbody>";
            $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
            //调用分页
            Page.navigation(
              ".js_raiseAllotment .pagination-box",
              data.pageHelp.pageCount,
              data.pageHelp.total,
              data.pageHelp.pageNo,
              data.pageHelp.pageSize,
              "raiseAllotment.getRaiseAllotmentList"
            );
            $(".js_raiseAllotment .title_lev2 .new_date").show();
          } else {
            raiseAllotmentHtml += emptyTr;
            raiseAllotmentHtml += "</tbody>";
            $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
            $(".js_raiseAllotment .pagination-box").html("");
          }
        },
        errCallback: function () {
          raiseAllotmentHtml += emptyTr;
          raiseAllotmentHtml += "</tbody>";
          $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
          $(".js_raiseAllotment .pagination-box").html("");
        },
      });
    } else {
      // 主板A 科创板
      getJSONP({
        type: "post",
        dataType: "jsonp",
        url: _this.raiseAllotmentUrl,
        data: _this.raiseAllotmentParams,
        successCallback: function (data) {
          if (data && data.result && data.result.length > 0) {
            $.each(data.result, function (k, v) {
              raiseAllotmentHtml += "<tr>";
              raiseAllotmentHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.COMPANY_CODE +
                '" target="_blank">' +
                v.COMPANY_ABBR +
                "</a></td>"; //简称
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.REG_DATE) +
                "</td>"; //A股股权登记日
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.DERIGHTS_DATE) +
                "</td>"; //A股除权交易日
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.RIGHTS_PRICE &&
                  v.RIGHTS_PRICE != "-" &&
                  !isNaN(v.RIGHTS_PRICE) ?
                  v.RIGHTS_PRICE :
                  "-") +
                "</td>"; //A股配股价格
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.RIGHTS_RATIO &&
                  v.RIGHTS_RATIO != "-" &&
                  !isNaN(v.RIGHTS_RATIO) ?
                  v.RIGHTS_RATIO :
                  "-") +
                "</td>"; //配股比例
              raiseAllotmentHtml +=
                '<td class="text-right">' +
                (v.RIGHTS_VOL && v.RIGHTS_VOL != "-" && !isNaN(v.RIGHTS_VOL) ?
                  v.RIGHTS_VOL :
                  "-") +
                "</td>"; //实际配股量
              raiseAllotmentHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.RIGHTS_LIST_DATE) +
                "</td>"; //配股上市日
              raiseAllotmentHtml += "</tr>";
            });
            raiseAllotmentHtml += "</tbody>";
            $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
            //调用分页
            Page.navigation(
              ".js_raiseAllotment .pagination-box",
              data.pageHelp.pageCount,
              data.pageHelp.total,
              data.pageHelp.pageNo,
              data.pageHelp.pageSize,
              "raiseAllotment.getRaiseAllotmentList"
            );
            $(".js_raiseAllotment .title_lev2 .new_date").show();
          } else {
            raiseAllotmentHtml += emptyTr;
            raiseAllotmentHtml += "</tbody>";
            $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
            $(".js_raiseAllotment .pagination-box").html("");
          }
        },
        errCallback: function () {
          raiseAllotmentHtml += emptyTr;
          raiseAllotmentHtml += "</tbody>";
          $(".js_raiseAllotment .table").html(raiseAllotmentHtml);
          $(".js_raiseAllotment .pagination-box").html("");
        },
      });
    }
  },
};
if ($(".js_raiseAllotment").length > 0) {
  raiseAllotment.init();
}
