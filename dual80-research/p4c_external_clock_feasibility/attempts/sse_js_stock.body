/**
* 股本结构-股本排行-最新股本结构总貌
*/
var structureOverview = {
  init: function () {
    this.loadEvents();
  },
  structureOverviewUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  structureOverviewParams: {
    isPagination: false,
    sqlId: "COMMON_SSE_SJ_GPSJ_GBJG_GBJGZM_ZXGBJGZM_L",
  },
  loadEvents: function () {
    var _this = this;
    //点击搜索、回车触发查询
    triggerSearch(_this.setStructureOverview);
    _this.getstructureOverviewList();
  },
  setStructureOverview: function () {
    var _this = structureOverview;
    var inputCode = $("#inputCode").val() ? $("#inputCode").val() : "";
    var res = (reg = /^\d{6}$/);
    if (inputCode && !res.test(inputCode)) {
      bootstrapModal({
        text: "证券代码必须为6位数字",
      });
      return;
    }
    //搜索内容添加cookie
    popularize.saveCpyIntoCookie(
      $("#inputCode").val().trim(),
      $("#inputCode"),
      1
    );
    window.open(
      "/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=" +
      inputCode,
      "_blank"
    );
  },
  getstructureOverviewList: function () {
    var _this = structureOverview;
    var emptyTr = '<tr><td colspan="4">暂无数据</td></tr>';
    var structureOverviewHtml = "<thead><tr>";
    structureOverviewHtml += '<th class="text-nowrap">股份类型</th>';
    structureOverviewHtml += '<th class="text-right">股本数(亿股/亿份)</th>';
    structureOverviewHtml += '<th class="text-right">比例(%)</th>';
    structureOverviewHtml +=
      '<th class="text-right">较上月增减(亿股/亿份)</th>';
    structureOverviewHtml += "</tr></thead><tbody>";

    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.structureOverviewUrl,
      data: _this.structureOverviewParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            if (
              v &&
              v.SHARES_TYPE != "H股股本" &&
              v.SHARES_TYPE != "公司总股本"
            ) {
              structureOverviewHtml += "<tr>";
              structureOverviewHtml +=
                '<td class="text-nowrap">' + v.SHARES_TYPE + "</td>"; //股份类型
              structureOverviewHtml +=
                '<td class="text-right">' +
                newFormatDecimal(formatDecimal(v.ISSUE_VOL, 2, 1)) +
                "</td>"; //股本数
              structureOverviewHtml +=
                '<td class="text-right">' +
                newFormatDecimal(formatDecimal(v.VOL_RATIO, 3, 1)) * 10000 / 100 +
                "</td>"; //比例
              structureOverviewHtml +=
                '<td class="text-right">' +
                newFormatDecimal(formatDecimal(v.CHANGE_VOL, 2, 1)) +
                "</td>"; //较上月增减
              structureOverviewHtml += "</tr>";
            }
          });
          $(".js_structureOverview .title_lev2").append(
            '<span class="new_date">*截止日期：' +
            turnDateAddLine(data.result[0].TRADE_DATE) +
            "</span>"
          );
          structureOverviewHtml += "</tbody>";
          $(".js_structureOverview .table").html(structureOverviewHtml);
        } else {
          structureOverviewHtml += emptyTr;
          structureOverviewHtml += "</tbody>";
          $(".js_structureOverview .table").html(structureOverviewHtml);
        }
      },
      errCallback: function () {
        structureOverviewHtml += emptyTr;
        structureOverviewHtml += "</tbody>";
        $(".js_structureOverview .table").html(structureOverviewHtml);
      },
    });
  },
};
if ($(".js_structureOverview").length > 0) {
  structureOverview.init();
}
//股本结构-股本排行-最新股本结构总貌 END

