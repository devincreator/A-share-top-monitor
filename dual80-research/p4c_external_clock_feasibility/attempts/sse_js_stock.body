              overviewYearlyHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKINDEX != -1 ?
                  v[STOCKINDEX] :
                  k > 4 && k != 7 && k < 13 ?
                    "-<br/>(-)" :
                    "-") +
                "</td>"; //股票
              overviewYearlyHtml +=
                '<td class="text-right text-nowrap">' +
                (ASHAREINDEX != -1 ?
                  v[ASHAREINDEX] :
                  k > 4 && k != 7 && k < 13 ?
