          $.each(data.result, function (k, v) {
            if (v) {
              structureOverviewFXHtml += "<tr>";
              structureOverviewFXHtml += "<td>" + (k + 1) + "</td>";
              structureOverviewFXHtml +=
                '<td><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.A_STOCK_CODE +
