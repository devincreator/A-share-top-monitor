              v.RAISING_FORM == "首发：公开发行" ||
              v.RAISING_FORM == "首发：超额配售" ||
              v.RAISING_FORM == "再发：公开增发" ||
              v.RAISING_FORM == "再发：定向增发" ||
              v.RAISING_FORM == "再发：配股" ||
              v.RAISING_FORM == "再发：转债转股" ||
              v.RAISING_FORM == "再发：优先股"
            ) {
