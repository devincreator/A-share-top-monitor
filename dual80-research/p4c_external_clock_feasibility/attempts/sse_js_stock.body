*/
var structureRank = {
  todayDate: get_systemDate_global(),
  structureRankUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  structureRankParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_GBJG_L",
    SEARCH_DATE: "",
    ISSUE_VOL: 1, // 查询发行股本，参数值为 ‘1’ ; 'NEGO_VOL': 1  查询流通股本，参数值为 ‘1’
    TOP_TEN: 1,
  },
  structureRankTypeOption: [{
    value: "1",
    name: "十种发行股本最大的股票",
  },
  {
    value: "2",
    name: "十种流通股本最大的股票",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    $(".js_date input").attr("placeholder", "截止日期");
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      trigger: "click",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setStructureRankParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //类型数据渲染
        $(".js_structureRankType .selectpicker")
          .html(addSelectOption(_this.structureRankTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_structureRankType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setStructureRankParams();
          }
        );
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setStructureRankParams);
    //初始加载
    _this.getStructureRankList();
  },
  structureRankVol: function (t, v) {
    if (t == 2) {
      return {
        VOL: v.NEGO_VOL,
        VOL_PER: v.NEGO_VOL_PER,
      };
    } else {
      return {
        VOL: v.ISSUE_VOL,
        VOL_PER: v.ISSUE_VOL_PER,
      };
    }
  },
  setStructureRankParams: function () {
    var _this = structureRank;
    var searchDate = $(".js_date input").val() ? $(".js_date input").val() : ""; //日期
    var structureRankType = $(".js_structureRankType .selectpicker").val() ?
      $(".js_structureRankType .selectpicker").val() :
      "";
    if (structureRankType == "2") {
      _this.structureRankParams.NEGO_VOL = 1;
      _this.structureRankParams.ISSUE_VOL = undefined;
      $(".js_structureRank .title_lev3").html(
        '十种流通股本最大的股票<span class="new_date">截止日期：' +
        searchDate +
        "</span>"
      );
    } else {
      _this.structureRankParams.NEGO_VOL = undefined;
      _this.structureRankParams.ISSUE_VOL = 1;
      $(".js_structureRank .title_lev3").html(
        '十种发行股本最大的股票<span class="new_date">截止日期：' +
        searchDate +
        "</span>"
      );
    }
    _this.structureRankParams.SEARCH_DATE = searchDate;
    _this.getStructureRankList();
  },
  getStructureRankList: function () {
    var _this = this,
      url = _this.structureRankUrl;
    var structureRankType = $(".js_structureRankType .selectpicker").val() ?
      $(".js_structureRankType .selectpicker").val() :
      "";
    $(".js_structureRank .title_lev3 .new_date").html("");
    var emptyTr = '<tr><td colspan="6">暂无数据</td></tr>';
    var structureRankHtml = "<thead><tr>";
    structureRankHtml += "<th>名次</th>";
    structureRankHtml += '<th class="codeNameWidth">股票代码</th>';
    structureRankHtml += '<th class="codeNameWidth">股票简称</th>';
    structureRankHtml += "<th>股票全称</th>";
    structureRankHtml += '<th class="text-right">发行股本(万股/万份)</th>';
    structureRankHtml += '<th class="text-right">所占比例(%)</th>';
    structureRankHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: url,
      data: _this.structureRankParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          if (structureRankType == "2") {
            $(".js_structureRank .title_lev3").html(
              '十种流通股本最大的股票<span class="new_date">截止日期：' +
              turnDateAddLine(data.result[0].TRADE_DATE) +
              "</span>"
            );
          } else {
            $(".js_structureRank .title_lev3").html(
              '十种发行股本最大的股票<span class="new_date">截止日期：' +
              turnDateAddLine(data.result[0].TRADE_DATE) +
              "</span>"
            );
          }
          var issvolSum = 0,
            issperSum = 0;
          
          $.each(data.result, function (k, v) {
            var vol = _this.structureRankVol(structureRankType, v).VOL;
            var vol_per = _this.structureRankVol(structureRankType, v).VOL_PER;
            structureRankHtml += "<tr>";
            structureRankHtml += "<td>" + (k + 1) + "</td>"; //名次
            structureRankHtml +=
              '<td class="text-nowrap"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
              v.A_STOCK_CODE +
              '" target="_blank">' +
              v.A_STOCK_CODE +
              "</a></td>"; //代码
            structureRankHtml +=
              '<td class="text-nowrap"><span>' + v.SEC_NAME + "</span></td>"; //股票简称
            structureRankHtml +=
              '<td class="text-nowrap">' + v.FULL_NAME + "</td>"; //股票名称
            structureRankHtml += '<td class="text-right">' + vol + "</td>"; //发行股本
            structureRankHtml += '<td class="text-right">' + vol_per + "</td>"; //所占比例
            structureRankHtml += "</tr>";
            issvolSum += vol && !isNaN(vol) ? parseFloat(vol) : 0;
            issperSum += vol_per && !isNaN(vol_per) ? parseFloat(vol_per) : 0;
          });
          structureRankHtml += "<tr>";
          structureRankHtml += '<td colspan="4">合计</td>';
          structureRankHtml +=
            '<td class="text-right">' + issvolSum.toFixed(2) + "</td>"; //发行股本
          structureRankHtml +=
            '<td class="text-right">' + issperSum.toFixed(2) + "</td>"; //所占比例
          structureRankHtml += "</tr>";
          structureRankHtml += "</tbody>";
          $(".js_structureRank .table").html(structureRankHtml);
        } else {
          structureRankHtml += emptyTr;
          structureRankHtml += "</tbody>";
          $(".js_structureRank .table").html(structureRankHtml);
          $(".js_structureRank .title_lev3 .new_date").html("");
        }
      },
      errCallback: function () {
        structureRankHtml += emptyTr;
        structureRankHtml += "</tbody>";
        $(".js_structureRank .table").html(structureRankHtml);
        $(".js_structureRank .title_lev3 .new_date").html("");
      },
    });
  },
};
if ($(".js_structureRank").length > 0) {
  structureRank.init();
}
//股本结构-股本排行 END

/**
* 上市公司分红情况
*/
var dividend = {
  todayDate: get_systemDate_global(),
  dividendUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  dividendParams: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_FHSG_SSGSFHQK_L",
    CONDITION_AG: 1, // 参数值为1时查询A股
  },
  dividendTypeOption: [{
    value: "1",
    name: "A股",
  },
  {
    value: "2",
    name: "B股",
  },
  ],
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "year",
      format: "yyyy",
      trigger: "click",
      min: "1991-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setdividendParams();
        }, 500);
      },
    });
    //下拉框数据渲染
    bootstrapSelect({
      method: function () {
        //类型数据渲染
        $(".js_dividendType .selectpicker")
          .html(addSelectOption(_this.dividendTypeOption))
          .selectpicker("refresh")
          .selectpicker("render");
        //下拉框改变触发查询
        $(".js_dividendType .selectpicker").on(
          "changed.bs.select",
          function (e) {
            _this.setdividendParams();
          }
        );
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setdividendParams);
    //初始加载
    $(".js_date input").val(_this.todayDate.substr(0, 4));
    _this.dividendParams.A_REG_DATE = _this.todayDate.substr(0, 4);
    _this.getdividendList(1);
  },
  setdividendParams: function () {
    var _this = dividend;
    _this.dividendParams.CONDITION_AG = undefined;
    _this.dividendParams.A_STOCK_CODE = undefined;
    _this.dividendParams.A_REG_DATE = undefined;
    _this.dividendParams.CONDITION_BG = undefined;
    _this.dividendParams.B_STOCK_CODE = undefined;
    _this.dividendParams.B_REG_DATE = undefined;
    var dividendType = $(".js_dividendType .selectpicker").val() ?
      $(".js_dividendType .selectpicker").val() :
      "";
    var record_date = $(".js_date input").val() ?
      $(".js_date input").val() :
      ""; //日期
    var inputCode = $("#inputCode").val() ? $("#inputCode").val() : ""; //证券代码
    var res = (reg = /^\d{6}$/);
    if (inputCode && !res.test(inputCode)) {
      bootstrapModal({
        text: "证券代码必须为6位数字",
      });
      return;
    }
    if (dividendType == "1") {
      //A股
      _this.dividendParams.A_REG_DATE = record_date;
      _this.dividendParams.A_STOCK_CODE = inputCode;
      _this.dividendParams.CONDITION_AG = 1;
      _this.getdividendList(1);
    }
    if (dividendType == "2") {
      //B股
      _this.dividendParams.B_REG_DATE = record_date;
      _this.dividendParams.B_STOCK_CODE = inputCode;
      _this.dividendParams.CONDITION_BG = 1;
      _this.getdividendList(1);
    }
  },
  getdividendList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.dividendParams, pageIndex)) return; //触发分页改变分页参数
    var emptyTr = '<tr><td colspan="7">暂无数据</td></tr>';
    var dividendHtml = "<thead><tr>";
    dividendHtml += '<th class="codeNameWidth">股票代码</th>';
    dividendHtml += '<th class="codeNameWidth">股票简称</th>';
    dividendHtml += '<th class="text-nowrap">公司名称</th>';
    dividendHtml += '<th class="text-right">每股红利</th>';

    dividendHtml += '<th class="text-nowrap">股权登记日</th>';
    dividendHtml += '<th class="text-nowrap">除息日</th>';
    dividendHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.dividendUrl,
      data: _this.dividendParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            dividendHtml += "<tr>";

            if (_this.dividendParams.CONDITION_AG == 1) {
              //A
              dividendHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.A_STOCK_CODE +
                "&FULLNAME=" +
                v.FULL_NAME +
                '" target="_blank">' +
                v.A_STOCK_CODE +
                "</a></td>"; //代码
              dividendHtml +=
                '<td class="codeNameWidth"><span>' +
                v.COMPANY_ABBR +
                "</span></td>"; //股票简称
              dividendHtml +=
                '<td class="text-nowrap">' + v.FULL_NAME + "</td>"; //公司名称
              dividendHtml +=
                '<td class="text-right">' + v.A_BEFR_TAX_DIV + "</td>"; //税前每股红利
              dividendHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.A_REG_DATE) +
                "</td>"; //股权登记日
              dividendHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.A_DIV_DATE) +
                "</td>"; //除息日
            } else {
              dividendHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.B_STOCK_CODE +
                "&FULLNAME=" +
                v.FULL_NAME +
                '" target="_blank">' +
                v.B_STOCK_CODE +
                "</a></td>"; //代码
              dividendHtml +=
                '<td class="codeNameWidth"><span>' +
                v.COMPANY_ABBR +
                "</span></td>"; //股票简称
              dividendHtml +=
                '<td class="text-nowrap">' + v.FULL_NAME + "</td>"; //公司名称
              dividendHtml +=
                '<td class="text-right">' + v.B_BEFR_TAX_DIV + "</td>"; //税前每股红利
              dividendHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.B_REG_DATE) +
                "</td>"; //股权登记日
              dividendHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.B_DIV_DATE) +
                "</td>"; //除息日
            }
          });
          dividendHtml += "</tbody>";
          $(".js_dividend .table").html(dividendHtml);
          //调用分页
          Page.navigation(
            ".js_dividend .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "dividend.getdividendList"
          );
        } else {
          dividendHtml += emptyTr;
          dividendHtml += "</tbody>";
          $(".js_dividend .table").html(dividendHtml);
          $(".js_dividend .pagination-box").html("");
        }
        //搜索代码添加cookie
        popularize.saveCpyIntoCookie(
          $("#inputCode").val().trim(),
          $("#inputCode"),
          1
        );
      },
      errCallback: function () {
        dividendHtml += emptyTr;
        dividendHtml += "</tbody>";
        $(".js_dividend .table").html(dividendHtml);
        $(".js_dividend .pagination-box").html("");
      },
    });
  },
};
if ($(".js_dividend").length > 0) {
  dividend.init();
}
//上市公司分红情况 END

/**
* 上市公司送股情况
*/
var bonus = {
  todayDate: get_systemDate_global(),
  bonusUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  bonusParams: {
    isPagination: true,
    "pageHelp.pageSize": 25,
    "pageHelp.pageNo": 1,
    "pageHelp.beginPage": 1,
    "pageHelp.cacheSize": 1,
    "pageHelp.endPage": 1,
    sqlId: "COMMON_SSE_SJ_GPSJ_FHSG_SG_L",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    $(".js_date input").attr("placeholder", "请选择");
    //日期
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "year",
      format: "yyyy",
      trigger: "click",
      min: "1991-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setbonusParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setbonusParams);
    //初始加载
    _this.getBonusList(1);
  },
  setbonusParams: function () {
    var _this = bonus;
    var year = $(".js_date input").val() ? $(".js_date input").val() : ""; //日期
    var inputCode = $("#inputCode").val() ? $("#inputCode").val() : ""; //证券代码
    var reg = /^\d{6}$/;
    if (inputCode && !reg.test(inputCode)) {
      bootstrapModal({
        text: "证券代码必须为6位数字",
      });
      return;
    }
    // _this.bonusParams.sqlId = 'COMMON_SSE_GP_SJTJ_FHSG_SG_L_NEW';
    _this.bonusParams.SEARCH_YEAR = year;
    _this.bonusParams.COMPANY_CODE = inputCode;
    _this.getBonusList(1);
  },
  getBonusList: function (pageIndex) {
    var _this = this;
    if (!paginationChange(_this.bonusParams, pageIndex)) return; //触发分页改变分页参数

    var emptyTr = '<tr><td colspan="10">暂无数据</td></tr>';
    var bonusHtml = "<thead><tr>";
    bonusHtml += '<th class="codeNameWidth">公司代码</th>';
    bonusHtml += "<th>公司名称</th>";
    bonusHtml += '<th class="codeNameWidth">股票代码</th>';
    bonusHtml += '<th class="codeNameWidth">股票简称</th>';
    bonusHtml += '<th class="text-nowrap">股权登记日</th>';
    bonusHtml += '<th class="text-nowrap">除权基准日</th>';
    bonusHtml += '<th class="text-nowrap">送股比例(10:?)</th>';
    bonusHtml += '<th class="text-right">转股比例(10:?)</th>';
    bonusHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.bonusUrl,
      data: _this.bonusParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            if (v.BONUS_RATIO != "-" || v.CONVERT_RATIO != "-") {
              bonusHtml += "<tr>";
              bonusHtml +=
                '<td class="codeNameWidth"><a href="/assortment/stock/list/info/company/index.shtml?COMPANY_CODE=' +
                v.COMPANY_CODE +
                "&FULLNAME=" +
                v.COMPANY_ABBR +
                '" target="_blank">' +
                v.COMPANY_CODE +
                "</a></td>"; //代码
              bonusHtml += '<td class="text-nowrap">' + v.FULL_NAME + "</td>"; //公司名称
              bonusHtml +=
                '<td class="codeNameWidth">' + v.A_STOCK_CODE + "</td>"; //股票代码
              bonusHtml +=
                '<td class="codeNameWidth"><span>' +
                v.COMPANY_ABBR +
                "</span></td>"; //股票简称
              bonusHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.A_REG_DATE) +
                "</td>"; //股权登记日
              bonusHtml +=
                '<td class="text-nowrap">' +
                turnDateAddLine(v.A_DERIGHTS_DATE) +
                "</td>"; //除权基准日
              bonusHtml += '<td class="text-right">' + v.BONUS_RATIO + "</td>"; //送股比例(10:?)
              bonusHtml +=
                '<td class="text-right">' + v.CONVERT_RATIO + "</td>"; //转股比例(10:?)
              bonusHtml += "</tr>";
            }
          });
          bonusHtml += "</tbody>";
          $(".js_bonus .table").html(bonusHtml);
          //调用分页
          Page.navigation(
            ".js_bonus .pagination-box",
            data.pageHelp.pageCount,
            data.pageHelp.total,
            data.pageHelp.pageNo,
            data.pageHelp.pageSize,
            "bonus.getBonusList"
          );
        } else {
          bonusHtml += emptyTr;
          bonusHtml += "</tbody>";
          $(".js_bonus .table").html(bonusHtml);
          $(".js_bonus .pagination-box").html("");
        }
        //搜索代码添加cookie
        popularize.saveCpyIntoCookie(
          $("#inputCode").val().trim(),
          $("#inputCode"),
          1
        );
      },
      errCallback: function () {
        bonusHtml += emptyTr;
        bonusHtml += "</tbody>";
        $(".js_bonus .table").html(bonusHtml);
        $(".js_bonus .pagination-box").html("");
      },
    });
  },
};
if ($(".js_bonus").length > 0) {
  bonus.init();
}
