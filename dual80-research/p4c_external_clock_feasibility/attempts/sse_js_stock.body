/**
 * 股票数据-股票数据总貌-总貌
 */
String.prototype.num_toFixed = function (num) {
  var _this = "";
  if (Number(this)) {
    if (Number(this) === 0) {
      _this = "0";
    } else {
      _this = Number(this).toFixed(num);
    }
  } else if (this == "-") {
    _this = "0";
  } else {
    _this = this;
  }
  if (_this % 1 === 0) {
    _this = parseInt(_this);
  }
  return _this;
};
String.prototype.str_toFixed = function (num) {
  var _this = "";
  if (Number(this) === 0) {
    _this = "0";
  } else if (this == "-") {
    _this = "-";
  } else {
    _this = parseFloat(Number(this).toFixed(num));
  }
  return _this;
};
// 合并原有逻辑
var statisticalOverview = {
  statisticalOverviewUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  statisticalOverviewParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_GPSJZM_TJSJ_L",
    PRODUCT_NAME: "股票,主板,科创板",
    type: "inParams",
    TRADE_DATE: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    _this.getstatisticalOverviewList();
  },
  getstatisticalOverviewList: function () {
    var _this = this;
    var emptyHtml = '';
    emptyHtml += "<p><span>上市股票/只</span><b>-</b></p>";
    emptyHtml += "<p><span>总股本/亿股</span><b>-</b></p>";
    emptyHtml += "<p><span>流通股本/亿股</span><b>-</b></p>";
    emptyHtml += "<p><span>总市值/亿元</span><b>-</b></p>";
    emptyHtml += "<p><span>流通市值/亿元</span><b>-</b></p>";
    emptyHtml += "<p><span>平均市盈率/倍</span><b>-</b></p>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.statisticalOverviewUrl,
      data: _this.statisticalOverviewParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          $.each(data.result, function (k, v) {
            if (v.PRODUCT_NAME === "股票") {
              var statisticalOverviewHtml =
                "<p><span>上市公司/家</span><b>" +
                (v.LIST_COM_NUM ? v.LIST_COM_NUM : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>上市股票/只</span><b>" +
                (v.SECURITY_NUM ? v.SECURITY_NUM : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>总股本/亿股</span><b>" +
                (v.TOTAL_ISSUE_VOL ? parseFloat(v.TOTAL_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>流通股本/亿股</span><b>" +
                (v.NEGO_ISSUE_VOL ? parseFloat(v.NEGO_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>总市值/亿元</span><b>" +
                (v.TOTAL_VALUE ? parseFloat(v.TOTAL_VALUE) : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>流通市值/亿元</span><b>" +
                (v.NEGO_VALUE ? parseFloat(v.NEGO_VALUE) : "-") +
                "</b></p>";
              statisticalOverviewHtml +=
                "<p><span>平均市盈率/倍</span><b>" +
                (v.AVG_PE_RATIO ? v.AVG_PE_RATIO.num_toFixed(2) : "-") +
                "</b></p>";
              $(".js_statisticalOverview .js_dataCon").html(
                statisticalOverviewHtml
              );
              var downUrl =
                sseQueryURL +
                "commonExcelDd.do?sqlId=COMMON_SSE_SJ_GPSJ_GPSJZM_TJSJ_L&PRODUCT_NAME=" +
                "股票,主板,科创板" + "&type=inParams&TRADE_DATE=" + turnDateAddLine(v.TRADE_DATE);
              var downHtm =
                '<a class="tableDownload js_download-export" href="' +
                downUrl +
                '">' +
                "下载</a>";
              $(".title_lev2").html('统计数据<span class="new_date">数据日期：' +
                turnDateAddLine(v.TRADE_DATE) +
                "</span>" + downHtm)
              $(".js_date input").val(turnDateAddLine(v.TRADE_DATE));
              //日期
              laydate({
                elem: ".js_date input",
                theme: "#b50005",
                format: "yyyy-MM-dd",
                trigger: "click",
                // min: "1991-01-01",
                // max: v.TRADE_DATE,
                btns: ["confirm"],
                done: function (value, date, endDate) {
                  //选择时间触发查询
                  setTimeout(function () {
                    _this.statisticalOverviewParams.TRADE_DATE = $(".js_date input").val();
                    _this.getstatisticalOverviewList();
                  }, 500);
                },
              });
            } else if (v.PRODUCT_NAME === "主板") {
              var statisticalMainHtml = "";
              statisticalMainHtml +=
                "<p><span>上市股票/只</span><b>" +
                (v.SECURITY_NUM ? v.SECURITY_NUM : "-") +
                "</b></p>";
              statisticalMainHtml +=
                "<p><span>总股本/亿股</span><b>" +
                (v.TOTAL_ISSUE_VOL ? parseFloat(v.TOTAL_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalMainHtml +=
                "<p><span>流通股本/亿股</span><b>" +
                (v.NEGO_ISSUE_VOL ? parseFloat(v.NEGO_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalMainHtml +=
                "<p><span>总市值/亿元</span><b>" +
                (v.TOTAL_VALUE ? parseFloat(v.TOTAL_VALUE) : "-") +
                "</b></p>";
              statisticalMainHtml +=
                "<p><span>流通市值/亿元</span><b>" +
                (v.NEGO_VALUE ? parseFloat(v.NEGO_VALUE) : "-") +
                "</b></p>";
              statisticalMainHtml +=
                "<p><span>平均市盈率/倍</span><b>" +
                (v.AVG_PE_RATIO ? v.AVG_PE_RATIO.num_toFixed(2) : "-") +
                "</b></p>";
              $(".js_statisticalMaina .js_dataCon").html(statisticalMainHtml);
            } else if (v.PRODUCT_NAME === "科创板") {
              var statisticalStarHtml = "";
              statisticalStarHtml +=
                "<p><span>上市股票/只</span><b>" +
                (v.SECURITY_NUM ? v.SECURITY_NUM : "-") +
                "</b></p>";
              statisticalStarHtml +=
                "<p><span>总股本/亿股</span><b>" +
                (v.TOTAL_ISSUE_VOL ? parseFloat(v.TOTAL_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalStarHtml +=
                "<p><span>流通股本/亿股</span><b>" +
                (v.NEGO_ISSUE_VOL ? parseFloat(v.NEGO_ISSUE_VOL) : "-") +
                "</b></p>";
              statisticalStarHtml +=
                "<p><span>总市值/亿元</span><b>" +
                (v.TOTAL_VALUE ? parseFloat(v.TOTAL_VALUE) : "-") +
                "</b></p>";
              statisticalStarHtml +=
                "<p><span>流通市值/亿元</span><b>" +
                (v.NEGO_VALUE ? parseFloat(v.NEGO_VALUE) : "-") +
                "</b></p>";
              statisticalStarHtml +=
                "<p><span>平均市盈率/倍</span><b>" +
                (v.AVG_PE_RATIO ? v.AVG_PE_RATIO.num_toFixed(2) : "-") +
                "</b></p>";
              $(".js_statisticalStar .js_dataCon").html(statisticalStarHtml);
            }
          });
        } else {
          var downUrl =
            sseQueryURL +
            "commonExcelDd.do?sqlId=COMMON_SSE_SJ_GPSJ_GPSJZM_TJSJ_L&PRODUCT_NAME=" +
            "股票,主板,科创板" + "&type=inParams&TRADE_DATE=" + $(".js_date input").val();
          var downHtm =
            '<a class="tableDownload js_download-export" href="' +
            downUrl +
            '">' +
            "下载</a>";
          $(".title_lev2").html('统计数据<span class="new_date">数据日期：' +
            $(".js_date input").val() +
            "</span>" + downHtm)
          $(".js_statisticalOverview .js_dataCon").html('<p><span>上市公司/家</span><b>-</b></p>' + emptyHtml);
          $(".js_statisticalMaina .js_dataCon").html(emptyHtml);
          $(".js_statisticalStar .js_dataCon").html(emptyHtml);
        }
      },
      errCallback: function () {
        var downUrl =
          sseQueryURL +
          "commonExcelDd.do?sqlId=COMMON_SSE_SJ_GPSJ_GPSJZM_TJSJ_L&PRODUCT_NAME=" +
          "股票,主板,科创板" + "&type=inParams&TRADE_DATE=" + $(".js_date input").val();
        var downHtm =
          '<a class="tableDownload js_download-export" href="' +
          downUrl +
          '">' +
          "下载</a>";
        $(".title_lev2").html('统计数据<span class="new_date">数据日期：' +
          t$(".js_date input").val() +
          "</span>" + downHtm)
        $(".js_statisticalOverview .js_dataCon").html('<p><span>上市公司/家</span><b>-</b></p>' + emptyHtml);
        $(".js_statisticalMain .js_dataCon").html(emptyHtml);
        $(".js_statisticalStar .js_dataCon").html(emptyHtml);
      },
    });
  },
};
if ($(".js_statisticalOverview").length > 0) {
  statisticalOverview.init();
}

/**
* 股票成交概况-每日概况
*/
var overviewDay = {
  indexNum: 0,
  overviewDayUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  overviewDayParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_CJGK_MRGK_C",
    PRODUCT_CODE: "01,02,03,11,17",
    type: "inParams",
    SEARCH_DATE: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期范围渲染
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      trigger: "click",
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setOverviewDayParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setOverviewDayParams);
    //初始加载
    _this.getOverviewDayList();
  },
  setOverviewDayParams: function () {
    var _this = overviewDay;
    var searchDate = $(".js_date input").val() ? $(".js_date input").val() : "";
    _this.overviewDayParams.SEARCH_DATE = searchDate;
    $(".js_overviewDay .title_lev2 .new_date").html("数据日期：" + searchDate);
    _this.getOverviewDayList();
  },
  getOverviewDayList: function () {
    var _this = this;
    var emptyTr = '<tr><td colspan="6">暂无数据</td></tr>';
    var overviewDayHtml = "<thead><tr>";
    overviewDayHtml += "<th>单日情况</th>";
    overviewDayHtml += '<th class="text-right">股票</th>';
    overviewDayHtml += '<th class="text-right">主板A</th>';
    overviewDayHtml += '<th class="text-right">主板B</th>';
    overviewDayHtml += '<th class="text-right">科创板</th>';
    overviewDayHtml += '<th class="text-right">股票回购</th>';
    overviewDayHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.overviewDayUrl,
      data: _this.overviewDayParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          //初次加载 更新数据日期及插件日期
          if (_this.indexNum == 0) {
            _this.indexNum = 1;
            var dataDate = data.result[0].TRADE_DATE ?
              turnDateAddLine(data.result[0].TRADE_DATE).substr(0, 10) :
              "";
            $(".js_overviewDay .title_lev2 .new_date").html(
              "数据日期：" + dataDate
            );
            $(".js_date input").val(dataDate);
          }
          var resultDatas = [],
            tableTitle = [
              "",
              "挂牌数",
              "市价总值(亿元)",
              "流通市值(亿元)",
              "成交金额(亿元)",
              "成交量(亿股/亿份)",
              "平均市盈率(倍)",
              "换手率(%)",
              "流通换手率(%)",
            ];
          $.each(data.result, function (k, v) {
            var resultData = [];
            //数组传入顺序固定，与表格第一列抱持一致，类型作为行数据获取标准（通过类型下标获取行数据）
            resultData.push(v.PRODUCT_CODE); //股票类型

            resultData.push(v.LIST_NUM); //挂牌数
            resultData.push(v.TOTAL_VALUE.str_toFixed(2)); //市价总值(亿元)
            resultData.push(v.NEGO_VALUE.str_toFixed(2)); //流通市值(亿元)
            resultData.push(v.TRADE_AMT.str_toFixed(2)); //成交金额(亿元)
            resultData.push(v.TRADE_VOL.str_toFixed(2)); //成交量(亿股/亿份)
            resultData.push(v.AVG_PE_RATE.str_toFixed(4)); //平均市盈率(倍)
            resultData.push(v.TOTAL_TO_RATE.str_toFixed(4)); //换手率(%)
            resultData.push(v.NEGO_TO_RATE.str_toFixed(4)); //流通换手率(%)

            resultDatas.push(resultData);
          });
          //横向变纵向
          resultDatas = changearr(resultDatas);
          //获取下标 股票17 主板A 01 主板B 02 科创板 03 股票回购 11
          var STOCKINDEX = resultDatas[0].indexOf("17"); //股票下标
          var ASHAREINDEX = resultDatas[0].indexOf("01"); //主板A下标
          var BSHAREINDEX = resultDatas[0].indexOf("02"); //主板B下标
          var STARINDEX = resultDatas[0].indexOf("03"); //科创板下标
          var STOCKBUYBACKINDEX = resultDatas[0].indexOf("11"); //股票回购 下标
          $.each(resultDatas, function (k, v) {
            if (k > 0 && k < 11) {
              overviewDayHtml += "<tr>";
              overviewDayHtml +=
                '<td class="text-nowrap">' + tableTitle[k] + "</td>"; //单日情况
              overviewDayHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKINDEX != -1 ? v[STOCKINDEX] : "-") +
                "</td>"; //股票
              overviewDayHtml +=
                '<td class="text-right text-nowrap">' +
                (ASHAREINDEX != -1 ? v[ASHAREINDEX] : "-") +
                "</td>"; //主板A
              overviewDayHtml +=
                '<td class="text-right text-nowrap">' +
                (BSHAREINDEX != -1 ? v[BSHAREINDEX] : "-") +
                "</td>"; //主板B
              overviewDayHtml +=
                '<td class="text-right text-nowrap">' +
                (STARINDEX != -1 ? v[STARINDEX] : "-") +
                "</td>"; //科创板
              overviewDayHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKBUYBACKINDEX != -1 ? v[STOCKBUYBACKINDEX] : "-") +
                "</td>"; //股票回购
              overviewDayHtml += "</tr>";
            }
          });
          overviewDayHtml += "</tbody>";
          $(".js_overviewDay .table").html(overviewDayHtml);
        } else {
          overviewDayHtml += emptyTr;
          overviewDayHtml += "</tbody>";
          $(".js_overviewDay .table").html(overviewDayHtml);
        }
      },
      errCallback: function () {
        overviewDayHtml += emptyTr;
        overviewDayHtml += "</tbody>";
        $(".js_overviewDay .table").html(overviewDayHtml);
      },
    });
  },
};
if ($(".js_overviewDay").length > 0) {
  overviewDay.init();
}
//股票成交概况-每日概况 END

/**
* 股票成交概况-每周概况
*/
var overviewWeekly = {
  todayDate: get_systemDate_global(),
  overviewWeeklyUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  isfrist: true, // 默认首次访问
  overviewWeeklyParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_CJGK_MZGK_C",
    PRODUCT_CODE: "01,02,03,11,17",
    type: "inParams",
    START_DATE: "",
    END_DATE: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期范围渲染
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      format: "yyyy-MM-dd",
      trigger: "click",
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setOverviewWeeklyParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setOverviewWeeklyParams);
    //初始加载
    var dayNum = new Date(_this.todayDate).getDay();
    var day = getXDayString(_this.todayDate, 5); //获取本周五
    if (!(dayNum == 6 || dayNum == 0)) {
      var friday = new Date(day);
      friday.setDate(friday.getDate() - 7);
      day = turnDateToString(friday); //获取上周五
    }
    var monday = getXDayString(day, 1);
    var sunday = getXDayString(day, 7);
    $(".js_date input").val(day);
    $(".js_overviewWeekly .title_lev2 .new_date").html(
      "数据日期：" + monday + "至" + sunday
    );
    _this.overviewWeeklyParams.START_DATE = monday;
    _this.overviewWeeklyParams.END_DATE = sunday;
    _this.getOverviewWeeklyList();
  },
  setOverviewWeeklyParams: function () {
    var _this = overviewWeekly;
    var searchDate = $(".js_date input").val() ? $(".js_date input").val() : "";
    var monday = getXDayString(searchDate, 1);
    var sunday = getXDayString(searchDate, 7);
    $(".js_overviewWeekly .title_lev2 .new_date").html(
      "数据日期：" + monday + "至" + sunday
    );
    _this.overviewWeeklyParams.START_DATE = monday;
    _this.overviewWeeklyParams.END_DATE = sunday;
    _this.getOverviewWeeklyList();
  },
  getOverviewWeeklyList: function () {
    var _this = this;
    if (_this.isfrist) {
      _this.overviewWeeklyParams.START_DATE = "";
      _this.overviewWeeklyParams.END_DATE = "";
    }
    var emptyTr = '<tr><td colspan="6">暂无数据</td></tr>';
    var overviewWeeklyHtml = "<thead><tr>";
    overviewWeeklyHtml += "<th>本周情况</th>";
    overviewWeeklyHtml += '<th class="text-right">股票</th>';
    overviewWeeklyHtml += '<th class="text-right">主板A</th>';
    overviewWeeklyHtml += '<th class="text-right">主板B</th>';
    overviewWeeklyHtml += '<th class="text-right">科创板</th>';
    overviewWeeklyHtml += '<th class="text-right">股票回购</th>';
    overviewWeeklyHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.overviewWeeklyUrl,
      data: _this.overviewWeeklyParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          var resultDatas = [],
            tableTitle = [
              "",
              "挂牌数",
              "市价总值(亿元)",
              "流通市值(亿元)",
              "成交金额(亿元)",
              "最高成交金额(亿元)",
              "最低成交金额(亿元)",
              "成交量(亿股/亿份)",
              "最高成交量(亿股/亿份)",
              "最低成交量(亿股/亿份)",
              "平均市盈率(倍)",
              "换手率(%)",
              "流通换手率(%)",
              "累计交易天数(天)",
            ];
          $.each(data.result, function (k, v) {
            var resultData = [];
            //数组传入顺序固定，与表格第一列抱持一致，类型作为行数据获取标准（通过类型下标获取行数据）
            resultData.push(
              v.PRODUCT_CODE == "-" || v.PRODUCT_CODE == undefined ?
                v.PRODUCT_CODE_B :
                v.PRODUCT_CODE
            ); //基金类型
            resultData.push(v.LIST_NUM); //挂牌数
            resultData.push(v.TOTAL_VALUE.str_toFixed(2)); //市价总值(亿元)
            resultData.push(v.NEGO_VALUE.str_toFixed(2)); //流通市值(亿元)
            resultData.push(v.TRADE_AMT.str_toFixed(4)); //成交金额(亿元)
            resultData.push(
              v.HIGH_AMT.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.HIGH_AMT_DATE) +
              ")"
            ); //最高成交金额(亿元)
            resultData.push(
              v.LOW_AMT.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.LOW_AMT_DATE) +
              ")"
            ); //最低成交金额(亿元)
            resultData.push(v.TRADE_VOL.str_toFixed(4)); //成交量(亿股/亿份)
            resultData.push(
              v.HIGH_VOL.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.HIGH_VOL_DATE) +
              ")"
            ); //最高成交量(亿股/亿份)
            resultData.push(
              v.LOW_VOL.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.LOW_VOL_DATE) +
              ")"
            ); //最低成交量(亿股/亿份)
            resultData.push(v.AVG_PE_RATE.str_toFixed(2)); //平均市盈率(倍)
            resultData.push(v.TOTAL_TO_RATE.str_toFixed(4)); //换手率(%)
            resultData.push(v.TO_RATE.str_toFixed(4)); //流通换手率(%)
            resultData.push(v.WEEK_TRADE_DAYS); //累计交易天数(天)

            resultDatas.push(resultData);
          });
          //横向变纵向
          resultDatas = changearr(resultDatas);
          //获取下标 股票17 主板A 1 主板B 2 科创板 48 股票回购 11
          var STOCKINDEX = resultDatas[0].indexOf("17"); //股票下标
          var ASHAREINDEX = resultDatas[0].indexOf("01"); //主板A下标
          var BSHAREINDEX = resultDatas[0].indexOf("02"); //主板B下标
          var STARINDEX = resultDatas[0].indexOf("03"); //科创板下标
          var STOCKBUYBACKINDEX = resultDatas[0].indexOf("11"); //股票回购 下标

          $.each(resultDatas, function (k, v) {
            if (k > 0 && k < 18) {
              overviewWeeklyHtml += "<tr>";
              overviewWeeklyHtml +=
                '<td class="text-nowrap">' + tableTitle[k] + "</td>"; //每周情况
              overviewWeeklyHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKINDEX != -1 ? v[STOCKINDEX] : "-") +
                "</td>"; //股票
              overviewWeeklyHtml +=
                '<td class="text-right text-nowrap">' +
                (ASHAREINDEX != -1 ? v[ASHAREINDEX] : "-") +
                "</td>"; //主板A
              overviewWeeklyHtml +=
                '<td class="text-right text-nowrap">' +
                (BSHAREINDEX != -1 ? v[BSHAREINDEX] : "-") +
                "</td>"; //主板B
              overviewWeeklyHtml +=
                '<td class="text-right text-nowrap">' +
                (STARINDEX != -1 ? v[STARINDEX] : "-") +
                "</td>"; //科创板
              overviewWeeklyHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKBUYBACKINDEX != -1 ? v[STOCKBUYBACKINDEX] : "-") +
                "</td>"; //股票回购
              overviewWeeklyHtml += "</tr>";
            }
          });

          overviewWeeklyHtml += "</tbody>";
          $(".js_overviewWeekly .table").html(overviewWeeklyHtml);
          // 传值日期控件
          var timeipt = $(".sse_input");
          var endDate = data.result[0].END_DATE.substr(0, 8).replace(
            /^(\d{4})(\d{2})(\d{2})$/,
            "$1-$2-$3"
          );
          if (_this.isfrist) {
            var day = getXDayString(endDate, 5); //获取本周五
            timeipt.val(day);
            $(".js_overviewWeekly .title_lev2 .new_date").html(
              "数据日期：" + getXDayString(endDate, 1) + "至" + endDate
            );
          }
          _this.isfrist = false;
        } else {
          overviewWeeklyHtml += emptyTr;
          overviewWeeklyHtml += "</tbody>";
          $(".js_overviewWeekly .table").html(overviewWeeklyHtml);
        }
      },
      errCallback: function () {
        overviewWeeklyHtml += emptyTr;
        overviewWeeklyHtml += "</tbody>";
        $(".js_overviewWeekly .table").html(overviewWeeklyHtml);
      },
    });
  },
};
if ($(".js_overviewWeekly").length > 0) {
  overviewWeekly.init();
}
//股票成交概况-每周概况 END

/**
* 股票成交概况-月度概况
*/
var overviewMonthly = {
  todayDate: get_systemDate_global(),
  isfrist: true, // 默认首次访问
  overviewMonthlyUrl: sseQueryURL + "commonQuery.do?jsonCallBack=?",
  overviewMonthlyParams: {
    sqlId: "COMMON_SSE_SJ_GPSJ_CJGK_MYGK_C",
    PRODUCT_CODE: "01,02,03,11,17",
    type: "inParams",
    SEARCH_DATE: "",
  },
  init: function () {
    this.loadEvents();
  },
  loadEvents: function () {
    var _this = this;
    //日期范围渲染
    laydate({
      elem: ".js_date input",
      theme: "#b50005",
      type: "month",
      format: "yyyy-MM",
      trigger: "click",
      min: "1999-01-01",
      max: _this.todayDate,
      btns: ["confirm"],
      done: function (value, date, endDate) {
        //选择时间触发查询
        setTimeout(function () {
          _this.setOverviewMonthlyParams();
        }, 500);
      },
    });
    //点击搜索、回车触发查询
    triggerSearch(_this.setOverviewMonthlyParams);
    //初始加载
    $(".js_date input").val(searchMonthJ);
    $(".js_overviewMonthly .title_lev2 .new_date").html(
      "数据日期：" + searchMonthJ
    );
    _this.overviewMonthlyParams.SEARCH_DATE = searchMonthJ;
    _this.getOverviewMonthlyList();
  },
  setOverviewMonthlyParams: function () {
    var _this = overviewMonthly;
    var inYear = $(".js_date input").val() ? $(".js_date input").val() : "";
    $(".js_overviewMonthly .title_lev2 .new_date").html("数据日期：" + inYear);
    _this.overviewMonthlyParams.SEARCH_DATE = inYear;
    _this.getOverviewMonthlyList();
  },
  getOverviewMonthlyList: function () {
    var _this = this;
    if (_this.isfrist) {
      _this.overviewMonthlyParams.SEARCH_DATE = "";
    }
    var emptyTr = '<tr><td colspan="6">暂无数据</td></tr>';
    var overviewMonthlyHtml = "<thead><tr>";
    overviewMonthlyHtml += "<th>月度情况</th>";
    overviewMonthlyHtml += '<th class="text-right">股票</th>';
    overviewMonthlyHtml += '<th class="text-right">主板A</th>';
    overviewMonthlyHtml += '<th class="text-right">主板B</th>';
    overviewMonthlyHtml += '<th class="text-right">科创板</th>';
    overviewMonthlyHtml += '<th class="text-right">股票回购</th>';
    overviewMonthlyHtml += "</tr></thead><tbody>";
    getJSONP({
      type: "post",
      dataType: "jsonp",
      url: _this.overviewMonthlyUrl,
      data: _this.overviewMonthlyParams,
      successCallback: function (data) {
        if (data && data.result && data.result.length > 0) {
          var resultDatas = [],
            tableTitle = [
              "",
              "挂牌数",
              "市价总值(亿元)",
              "流通市值(亿元)",
              "成交金额(亿元)",
              "最高成交金额(亿元)",
              "最低成交金额(亿元)",
              "成交量(亿股/亿份)",
              "最高成交量(亿股/亿份)",
              "最低成交量(亿股/亿份)",
              "平均市盈率(倍)",
              "换手率(%)",
              "流通换手率(%)",
              "累计交易天数(天)",
            ];
          $.each(data.result, function (k, v) {
            var resultData = [];
            //数组传入顺序固定，与表格第一列抱持一致，类型作为行数据获取标准（通过类型下标获取行数据）
            resultData.push(
              v.PRODUCT_CODE == "-" || v.PRODUCT_CODE == undefined ?
                v.PRODUCT_CODE_B :
                v.PRODUCT_CODE
            ); //基金类型
            resultData.push(v.LIST_NUM); //挂牌数
            resultData.push(v.TOTAL_VALUE.str_toFixed(2)); //市价总值(亿元)
            resultData.push(v.NEGO_VALUE.str_toFixed(2)); //流通市值(亿元)
            resultData.push(v.TRADE_AMT.str_toFixed(4)); //成交金额(亿元)
            resultData.push(
              v.M_HIGH_AMT.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.M_HIGH_AMT_DATE) +
              ")"
            ); //最高成交金额(亿元)
            resultData.push(
              v.M_LOW_AMT.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.M_LOW_AMT_DATE) +
              ")"
            ); //最低成交金额(亿元)
            resultData.push(v.TRADE_VOL.str_toFixed(4)); //成交量(亿股/亿份)
            resultData.push(
              v.M_HIGH_VOL.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.M_HIGH_VOL_DATE) +
              ")"
            ); //最高成交量(亿股/亿份)
            resultData.push(
              v.M_LOW_VOL.str_toFixed(4) +
              "<br>" +
              "(" +
              turnDateAddLine(v.M_LOW_VOL_DATE) +
              ")"
            ); //最低成交量(亿股/亿份)
            resultData.push(v.AVG_PE_RATE.str_toFixed(2)); //平均市盈率(倍)
            resultData.push(v.TOTAL_TO_RATE.str_toFixed(4)); //换手率(%)
            resultData.push(v.TO_RATE.str_toFixed(4)); //流通换手率(%)
            resultData.push(v.TRADE_DAYS); //累计交易天数(天)

            resultDatas.push(resultData);
          });
          //横向变纵向
          resultDatas = changearr(resultDatas);
          //获取下标 股票17 主板A 1 主板B 2 科创板 03 股票回购 11
          var STOCKINDEX = resultDatas[0].indexOf("17"); //股票下标
          var ASHAREINDEX = resultDatas[0].indexOf("01"); //主板A下标
          var BSHAREINDEX = resultDatas[0].indexOf("02"); //主板B下标
          var STARINDEX = resultDatas[0].indexOf("03"); //科创板下标
          var STOCKBUYBACKINDEX = resultDatas[0].indexOf("11"); //股票回购 下标

          $.each(resultDatas, function (k, v) {
            if (k > 0 && k < 18) {
              overviewMonthlyHtml += "<tr>";
              overviewMonthlyHtml +=
                '<td class="text-nowrap">' + tableTitle[k] + "</td>"; //每周情况
              overviewMonthlyHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKINDEX != -1 ? v[STOCKINDEX] : "-") +
                "</td>"; //股票
              overviewMonthlyHtml +=
                '<td class="text-right text-nowrap">' +
                (ASHAREINDEX != -1 ? v[ASHAREINDEX] : "-") +
                "</td>"; //主板A
              overviewMonthlyHtml +=
                '<td class="text-right text-nowrap">' +
                (BSHAREINDEX != -1 ? v[BSHAREINDEX] : "-") +
                "</td>"; //主板B
              overviewMonthlyHtml +=
                '<td class="text-right text-nowrap">' +
                (STARINDEX != -1 ? v[STARINDEX] : "-") +
                "</td>"; //科创板
              overviewMonthlyHtml +=
                '<td class="text-right text-nowrap">' +
                (STOCKBUYBACKINDEX != -1 ? v[STOCKBUYBACKINDEX] : "-") +
                "</td>"; //股票回购
              overviewMonthlyHtml += "</tr>";
            }
          });

          overviewMonthlyHtml += "</tbody>";
          $(".js_overviewMonthly .table").html(overviewMonthlyHtml);
          // 传值日期控件
          var timeipt = $(".sse_input");
          if (_this.isfrist) {
            timeipt.val(
              data.result[0].TRADE_DATE.substr(0, 6).replace(
                /^(\d{4})(\d{2})$/,
                "$1-$2"
              )
            );
            $(".js_overviewMonthly .title_lev2 .new_date").html(
              "数据日期：" +
              data.result[0].TRADE_DATE.substr(0, 6).replace(
                /^(\d{4})(\d{2})$/,
                "$1-$2"
              )
            );
          }
          _this.isfrist = false;
        } else {
          overviewMonthlyHtml += emptyTr;
          overviewMonthlyHtml += "</tbody>";
          $(".js_overviewMonthly .table").html(overviewMonthlyHtml);
        }
        if (
          _this.overviewMonthlyParams.inYear == _this.todayDate.substring(0, 7)
        ) {
          $(".js_overviewMonthly .table").after(
            '<div class="remarks">*本月度数据统计截止前1交易日</div>'
          );
        }
      },
      errCallback: function () {
        overviewMonthlyHtml += emptyTr;
        overviewMonthlyHtml += "</tbody>";
        $(".js_overviewMonthly .table").html(overviewMonthlyHtml);
      },
    });
  },
};
if ($(".js_overviewMonthly").length > 0) {
  overviewMonthly.init();
}
